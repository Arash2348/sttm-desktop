 "lines": [
  {
   "i": 10,
   "verseId": 42579,
   "text": "ਧੰਨੁ ਸੇਵਕੁ ਸਫਲੁ ਓਹੁ ਆਇਆ ਜਿਨਿ ਨਾਨਕ ਖਸਮੁ ਪਛਾਤਾ ॥੪॥੫॥",
   "start": 2.08,
   "end": 8.24,
   "conf": -0.914,
   "check": 0.83
  },
  {
   "i": 11,
   "verseId": 42580,
   "text": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
   "start": 8.92,
   "end": 10.48,
   "conf": -0.866,
   "check": 0.77
  },
  {
   "i": 12,
   "verseId": 42581,
   "text": "ਖੁਲਿਆ ਕਰਮੁ ਕ੍ਰਿਪਾ ਭਈ ਠਾਕੁਰ ਕੀਰਤਨੁ ਹਰਿ ਹਰਿ ਗਾਈ ॥",
   "start": 11.2,
   "end": 15.96,
   "conf": -0.262,
   "check": 0.91
  },
  {
   "i": 13,
   "verseId": 42582,
   "text": "ਸ੍ਰਮੁ ਥਾਕਾ ਪਾਏ ਬਿਸ੍ਰਾਮਾ ਮਿਟਿ ਗਈ ਸਗਲੀ ਧਾਈ ॥੧॥",
   "start": 16.6,
   "end": 20.56,
   "conf": -0.596,
   "check": 0.9
  },
  {
   "i": 14,
   "verseId": 42583,
   "text": "ਅਬ ਮੋਹਿ ਜੀਵਨ ਪਦਵੀ ਪਾਈ ॥",
   "start": 21.28,
   "end": 23.56,
   "conf": -0.271,
   "check": 0.94
  },
  {
   "i": 15,
   "verseId": 42584,
   "text": "ਚੀਤਿ ਆਇਓ ਮਨਿ ਪੁਰਖੁ ਬਿਧਾਤਾ ਸੰਤਨ ਕੀ ਸਰਣਾਈ ॥੧॥ ਰਹਾਉ ॥",
   "start": 24.24,
   "end": 29.68,
   "conf": -0.751,
   "check": 0.9
  },
  {
   "i": 16,
   "verseId": 42585,
   "text": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਲੋਭੁ ਮੋਹੁ ਨਿਵਾਰੇ ਨਿਵਰੇ ਸਗਲ ਬੈਰਾਈ ॥",
   "start": 30.36,
   "end": 36.08,
   "conf": -0.896,
   "check": 0.88
  },
  {
   "i": 17,
   "verseId": 42586,
   "text": "ਸਦ ਹਜੂਰਿ ਹਾਜਰੁ ਹੈ ਨਾਜਰੁ ਕਤਹਿ ਨ ਭਇਓ ਦੂਰਾਈ ॥੨॥",
   "start": 36.68,
   "end": 41.36,
   "conf": -0.723,
   "check": 0.82
  },
  {
   "i": 18,
   "verseId": 42587,
   "text": "ਸੁਖ ਸੀਤਲ ਸਰਧਾ ਸਭ ਪੂਰੀ ਹੋਏ ਸੰਤ ਸਹਾਈ ॥",
   "start": 42.12,
   "end": 46.64,
   "conf": -0.662,
   "check": 0.83
  },
  {
   "i": 19,
   "verseId": 42588,
   "text": "ਪਾਵਨ ਪਤਿਤ ਕੀਏ ਖਿਨ ਭੀਤਰਿ ਮਹਿਮਾ ਕਥਨੁ ਨ ਜਾਈ ॥੩॥",
   "start": 47.28,
   "end": 51.6,
   "conf": -0.233,
   "check": 0.97
  },
  {
   "i": 20,
   "verseId": 42589,
   "text": "ਨਿਰਭਉ ਭਏ ਸਗਲ ਭੈ ਖੋਏ ਗੋਬਿਦ ਚਰਣ ਓਟਾਈ ॥",
   "start": 52.2,
   "end": 56.36,
   "conf": -0.32,
   "check": 0.93
  },
  {
   "i": 21,
   "verseId": 42590,
   "text": "ਨਾਨਕੁ ਜਸੁ ਗਾਵੈ ਠਾਕੁਰ ਕਾ ਰੈਣਿ ਦਿਨਸੁ ਲਿਵ ਲਾਈ ॥੪॥੬॥",
   "start": 57,
   "end": 61.96,
   "conf": -0.458,
   "check": 0.85
  },
  {
   "i": 22,
   "verseId": 42591,
   "text": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
   "start": 62.52,
   "end": 64.08,
   "conf": -0.927,
   "check": 0.77
  },
  {
   "i": 23,
   "verseId": 42592,
   "text": "ਜੋ ਸਮਰਥੁ ਸਰਬ ਗੁਣ ਨਾਇਕੁ ਤਿਸ ਕਉ ਕਬਹੁ ਨ ਗਾਵਸਿ ਰੇ ॥",
   "start": 64.84,
   "end": 69.52,
   "conf": -0.808,
   "check": 0.87
  },
  {
   "i": 24,
   "verseId": 42593,
   "text": "ਛੋਡਿ ਜਾਇ ਖਿਨ ਭੀਤਰਿ ਤਾ ਕਉ ਉਆ ਕਉ ਫਿਰਿ ਫਿਰਿ ਧਾਵਸਿ ਰੇ ॥੧॥",
   "start": 70.08,
   "end": 75.28,
   "conf": -0.78,
   "check": 0.86
  },
  {
   "i": 25,
   "verseId": 42594,
   "text": "ਅਪੁਨੇ ਪ੍ਰਭ ਕਉ ਕਿਉ ਨ ਸਮਾਰਸਿ ਰੇ ॥",
   "start": 75.96,
   "end": 79.12,
   "conf": -0.562,
   "check": 0.9
  },
  {
   "i": 26,
   "verseId": 42595,
   "text": "ਬੈਰੀ ਸੰਗਿ ਰੰਗ ਰਸਿ ਰਚਿਆ ਤਿਸੁ ਸਿਉ ਜੀਅਰਾ ਜਾਰਸਿ ਰੇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 79.92,
   "end": 86.88,
   "conf": -0.378,
   "check": 0.95
  },
  {
   "i": 27,
   "verseId": 42596,
   "text": "ਜਾ ਕੈ ਨਾਮਿ ਸੁਨਿਐ ਜਮੁ ਛੋਡੈ ਤਾ ਕੀ ਸਰਣਿ ਨ ਪਾਵਸਿ ਰੇ ॥",
   "start": 87.56,
   "end": 92.68,
   "conf": -0.535,
   "check": 0.87
  },
  {
   "i": 28,
   "verseId": 42597,
   "text": "ਕਾਢਿ ਦੇਇ ਸਿਆਲ ਬਪੁਰੇ ਕਉ ਤਾ ਕੀ ਓਟ ਟਿਕਾਵਸਿ ਰੇ ॥੨॥",
   "start": 93.36,
   "end": 97.8,
   "conf": -0.817,
   "check": 0.89
  },
  {
   "i": 29,
   "verseId": 42598,
   "text": "ਜਿਸ ਕਾ ਜਾਸੁ ਸੁਨਤ ਭਵ ਤਰੀਐ ਤਾ ਸਿਉ ਰੰਗੁ ਨ ਲਾਵਸਿ ਰੇ ॥",
   "start": 98.44,
   "end": 104.4,
   "conf": -0.732,
   "check": 0.88
  },
  {
   "i": 30,
   "verseId": 42599,
   "text": "ਥੋਰੀ ਬਾਤ ਅਲਪ ਸੁਪਨੇ ਕੀ ਬਹੁਰਿ ਬਹੁਰਿ ਅਟਕਾਵਸਿ ਰੇ ॥੩॥",
   "start": 104.92,
   "end": 109.8,
   "conf": -1.009,
   "check": 0.92
  },
  {
   "i": 31,
   "verseId": 42600,
   "text": "ਭਇਓ ਪ੍ਰਸਾਦੁ ਕ੍ਰਿਪਾ ਨਿਧਿ ਠਾਕੁਰ ਸੰਤਸੰਗਿ ਪਤਿ ਪਾਈ ॥",
   "start": 110.32,
   "end": 115,
   "conf": -1.047,
   "check": 0.91
  },
  {
   "i": 32,
   "verseId": 42601,
   "text": "ਕਹੁ ਨਾਨਕ ਤ੍ਰੈ ਗੁਣ ਭ੍ਰਮੁ ਛੂਟਾ ਜਉ ਪ੍ਰਭ ਭਏ ਸਹਾਈ ॥੪॥੭॥",
   "start": 115.68,
   "end": 121.12,
   "conf": -1.903,
   "check": 0.91
  },
  {
   "i": 33,
   "verseId": 42602,
   "text": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
   "start": 121.72,
   "end": 123.28,
   "conf": -0.99,
   "check": 0.77
  },
  {
   "i": 34,
   "verseId": 42603,
   "text": "ਅੰਤਰਜਾਮੀ ਸਭ ਬਿਧਿ ਜਾਨੈ ਤਿਸ ਤੇ ਕਹਾ ਦੁਲਾਰਿਓ ॥",
   "start": 124.04,
   "end": 128.76,
   "conf": -1.851,
   "check": 0.97
  },
  {
   "i": 35,
   "verseId": 42604,
   "text": "ਹਸਤ ਪਾਵ ਝਰੇ ਖਿਨ ਭੀਤਰਿ ਅਗਨਿ ਸੰਗਿ ਲੈ ਜਾਰਿਓ ॥੧॥",
   "start": 129.32,
   "end": 134.16,
   "conf": -1.045,
   "check": 0.88
  },
  {
   "i": 36,
   "verseId": 42605,
   "text": "ਮੂੜੇ ਤੈ ਮਨ ਤੇ ਰਾਮੁ ਬਿਸਾਰਿਓ ॥",
   "start": 134.68,
   "end": 137.44,
   "conf": -0.641,
   "check": 0.83
  },
  {
   "i": 37,
   "verseId": 42606,
   "text": "ਲੂਣੁ ਖਾਇ ਕਰਹਿ ਹਰਾਮਖੋਰੀ ਪੇਖਤ ਨੈਨ ਬਿਦਾਰਿਓ ॥੧॥ ਰਹਾਉ ॥",
   "start": 138,
   "end": 143.84,
   "conf": -0.762,
   "check": 0.94
  },
  {
   "i": 38,
   "verseId": 42607,
   "text": "ਅਸਾਧ ਰੋਗੁ ਉਪਜਿਓ ਤਨ ਭੀਤਰਿ ਟਰਤ ਨ ਕਾਹੂ ਟਾਰਿਓ ॥",
   "start": 144.4,
   "end": 149.6,
   "conf": -0.464,
   "check": 0.91
  },
  {
   "i": 39,
   "verseId": 42608,
   "text": "ਪ੍ਰਭ ਬਿਸਰਤ ਮਹਾ ਦੁਖੁ ਪਾਇਓ ਇਹੁ ਨਾਨਕ ਤਤੁ ਬੀਚਾਰਿਓ ॥੨॥੮॥",
   "start": 150.24,
   "end": 156.04,
   "conf": -0.744,
   "check": 0.7
  },
  {
   "i": 40,
   "verseId": 42609,
   "text": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
   "start": 156.6,
   "end": 158.2,
   "conf": -1.125,
   "check": 0.77
  },
  {
   "i": 41,
   "verseId": 42610,
   "text": "ਚਰਨ ਕਮਲ ਪ੍ਰਭ ਰਾਖੇ ਚੀਤਿ ॥",
   "start": 159.16,
   "end": 162.48,
   "conf": -1.601,
   "check": 0.89
  },
  {
   "i": 42,
   "verseId": 42611,
   "text": "ਹਰਿ ਗੁਣ ਗਾਵਹ ਨੀਤਾ ਨੀਤ ॥",
   "start": 162.56,
   "end": 164.84,
   "conf": -1.642,
   "check": 0.94
  },
  {
   "i": 43,
   "verseId": 42612,
   "text": "ਤਿਸੁ ਬਿਨੁ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਊ ॥",
   "start": 165.64,
   "end": 168.28,
   "conf": -1.117,
   "check": 0.85
  },
  {
   "i": 44,
   "verseId": 42613,
   "text": "ਆਦਿ ਮਧਿ ਅੰਤਿ ਹੈ ਸੋਊ ॥੧॥",
   "start": 168.96,
   "end": 171.76,
   "conf": -1.733,
   "check": 0.82
  },
  {
   "i": 45,
   "verseId": 42614,
   "text": "ਸੰਤਨ ਕੀ ਓਟ ਆਪੇ ਆਪਿ ॥੧॥ ਰਹਾਉ ॥",
   "start": 172.2,
   "end": 175.76,
   "conf": -0.35,
   "check": 0.88
  },
  {
   "i": 46,
   "verseId": 42615,
   "text": "ਜਾ ਕੈ ਵਸਿ ਹੈ ਸਗਲ ਸੰਸਾਰੁ ॥",
   "start": 176.36,
   "end": 178.84,
   "conf": -0.702,
   "check": 0.88
  },
  {
   "i": 47,
   "verseId": 42616,
   "text": "ਆਪੇ ਆਪਿ ਆਪਿ ਨਿਰੰਕਾਰੁ ॥",
   "start": 179.64,
   "end": 181.8,
   "conf": -0.697,
   "check": 0.83
  },
  {
   "i": 48,
   "verseId": 42617,
   "text": "ਨਾਨਕ ਗਹਿਓ ਸਾਚਾ ਸੋਇ ॥",
   "start": 182.52,
   "end": 185.32,
   "conf": -0.827,
   "check": 1
  },
  {
   "i": 49,
   "verseId": 42618,
   "text": "ਸੁਖੁ ਪਾਇਆ ਫਿਰਿ ਦੂਖੁ ਨ ਹੋਇ ॥੨॥੯॥",
   "start": 186.04,
   "end": 188.24,
   "conf": -0.39,
   "check": 0.89
  },
  {
   "i": 50,
   "verseId": 42619,
   "text": "ਮਾਰੂ ਮਹਲਾ ੫ ਘਰੁ ੩",
   "start": 188.84,
   "end": 190.84,
   "conf": -0.57,
   "check": 0.77
  },
  {
   "i": 51,
   "verseId": 42620,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 191,
   "end": 195.24,
   "conf": -1.718,
   "check": 0.86
  },
  {
   "i": 52,
   "verseId": 42621,
   "text": "ਪ੍ਰਾਨ ਸੁਖਦਾਤਾ ਜੀਅ ਸੁਖਦਾਤਾ ਤੁਮ ਕਾਹੇ ਬਿਸਾਰਿਓ ਅਗਿਆਨਥ ॥",
   "start": 195.92,
   "end": 201.4,
   "conf": -0.353,
   "check": 0.93
  },
  {
   "i": 53,
   "verseId": 42622,
   "text": "ਹੋਛਾ ਮਦੁ ਚਾਖਿ ਹੋਏ ਤੁਮ ਬਾਵਰ ਦੁਲਭ ਜਨਮੁ ਅਕਾਰਥ ॥੧॥",
   "start": 202.12,
   "end": 208,
   "conf": -0.519,
   "check": 0.83
  },
  {
   "i": 54,
   "verseId": 42623,
   "text": "ਰੇ ਨਰ ਐਸੀ ਕਰਹਿ ਇਆਨਥ ॥",
   "start": 208.64,
   "end": 210.92,
   "conf": -0.627,
   "check": 0.79
  },
  {
   "i": 55,
   "verseId": 42624,
   "text": "ਤਜਿ ਸਾਰੰਗਧਰ ਭ੍ਰਮਿ ਤੂ ਭੂਲਾ ਮੋਹਿ ਲਪਟਿਓ ਦਾਸੀ ਸੰਗਿ ਸਾਨਥ ॥੧॥ ਰਹਾਉ ॥",
   "start": 211.72,
   "end": 220.04,
   "conf": -0.739,
   "check": 0.83
  },
  {
   "i": 56,
   "verseId": 42625,
   "text": "ਧਰਣੀਧਰੁ ਤਿਆਗਿ ਨੀਚ ਕੁਲ ਸੇਵਹਿ ਹਉ ਹਉ ਕਰਤ ਬਿਹਾਵਥ ॥",
   "start": 220.56,
   "end": 226.92,
   "conf": -0.431,
   "check": 0.88
  },
  {
   "i": 57,
   "verseId": 42626,
   "text": "ਫੋਕਟ ਕਰਮ ਕਰਹਿ ਅਗਿਆਨੀ ਮਨਮੁਖਿ ਅੰਧ ਕਹਾਵਥ ॥੨॥",
   "start": 227.68,
   "end": 232.88,
   "conf": -0.356,
   "check": 0.81
  },
  {
   "i": 58,
   "verseId": 42627,
   "text": "ਸਤਿ ਹੋਤਾ ਅਸਤਿ ਕਰਿ ਮਾਨਿਆ ਜੋ ਬਿਨਸਤ ਸੋ ਨਿਹਚਲੁ ਜਾਨਥ ॥",
   "start": 233.68,
   "end": 238.76,
   "conf": -0.486,
   "check": 0.91
  },
  {
   "i": 59,
   "verseId": 42628,
   "text": "ਪਰ ਕੀ ਕਉ ਅਪਨੀ ਕਰਿ ਪਕਰੀ ਐਸੇ ਭੂਲ ਭੁਲਾਨਥ ॥੩॥",
   "start": 239.4,
   "end": 243.56,
   "conf": -0.527,
   "check": 0.88
  },
  {
   "i": 60,
   "verseId": 42629,
   "text": "ਖਤ੍ਰੀ ਬ੍ਰਾਹਮਣ ਸੂਦ ਵੈਸ ਸਭ ਏਕੈ ਨਾਮਿ ਤਰਾਨਥ ॥",
   "start": 244.2,
   "end": 248.76,
   "conf": -0.976,
   "check": 0.84
  },
  {
   "i": 61,
   "verseId": 42630,
   "text": "ਗੁਰੁ ਨਾਨਕੁ ਉਪਦੇਸੁ ਕਹਤੁ ਹੈ ਜੋ ਸੁਨੈ ਸੋ ਪਾਰਿ ਪਰਾਨਥ ॥੪॥੧॥੧੦॥",
   "start": 249.4,
   "end": 254.44,
   "conf": -0.64,
   "check": 0.87
  },
  {
   "i": 62,
   "verseId": 42631,
   "text": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
   "start": 255.08,
   "end": 256.6,
   "conf": -1.877,
   "check": 0.26
  },
  {
   "i": 63,
   "verseId": 42632,
   "text": "ਗੁਪਤੁ ਕਰਤਾ ਸੰਗਿ ਸੋ ਪ੍ਰਭੁ ਡਹਕਾਵਏ ਮਨੁਖਾਇ ॥",
   "start": 257.24,
   "end": 260.96,
   "conf": -0.882,
   "check": 0.83
  },
  {
   "i": 64,
   "verseId": 42633,
   "text": "ਬਿਸਾਰਿ ਹਰਿ ਜੀਉ ਬਿਖੈ ਭੋਗਹਿ ਤਪਤ ਥੰਮ ਗਲਿ ਲਾਇ ॥੧॥",
   "start": 261.56,
   "end": 266.08,
   "conf": -0.376,
   "check": 0.9
  },
  {
   "i": 65,
   "verseId": 42634,
