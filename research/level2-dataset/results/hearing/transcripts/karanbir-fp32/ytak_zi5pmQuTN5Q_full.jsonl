{"t": 272.0, "text": "ਜ ਨ ਮੈ ਹੀ"}
{"t": 273.0, "text": "ਨਾੈ ਹੀਾਈ"}
{"t": 274.0, "text": "ਜਾਈ"}
{"t": 275.0, "text": "ਸ ਪਾਈ"}
{"t": 276.0, "text": "ਨਾ"}
{"t": 277.0, "text": "ਨਾਮੇਹੀ"}
{"t": 278.0, "text": "ਨਾਮੇਹੀਛਾ"}
{"t": 279.0, "text": "ਨਾਮੇਹੀ ਸਤਥਾਈ"}
{"t": 280.0, "text": "ਤਮੇ ਹੀ ਸਾਂਤਿ ਪਾਈ"}
{"t": 281.0, "text": "ਕੀ ਸਾਂਤ ਭਾਈ"}
{"t": 282.0, "text": "ਦਖਾਈ"}
{"t": 283.0, "text": "ਨਾ"}
{"t": 284.0, "text": ""}
{"t": 285.0, "text": "ਤਿਨਣਇ"}
{"t": 286.0, "text": "ਜਸ"}
{"t": 287.0, "text": "ਸ"}
{"t": 288.0, "text": "ਸਾ ਸਾਸਨ"}
{"t": 289.0, "text": "ਮੇਰੇ"}
{"t": 290.0, "text": "ਮੇਰੇ ਪ੍ਰਭ ਕਿਰਪਾ"}
{"t": 291.0, "text": "ਮੇਰੇ ਪ੍ਰਭ ਕ੍ਰਪਾ ਜਾਲੀ"}
{"t": 292.0, "text": "ਮੇਰੇ ਪ੍ਰਭ ਕ੍ਰਪਾ ਜਲਦੇ"}
{"t": 293.0, "text": "ਪ੍ਰਭ ਕ੍ਰਪਾ ਜਲ ਦੇਹੁਹੁ ਮਰ"}
{"t": 294.0, "text": "ਕਾ ਜਰ ਦੇਹੁ ਬਰਿ ਨਈ"}
{"t": 295.0, "text": "ਦੇਹੁ ਬਨਿ ਨਹੀ"}
{"t": 296.0, "text": "ਮਨਿ ਨਹੀ ਮਠ"}
{"t": 297.0, "text": "ਨਾ ਮ ਪ੍ਰਭ ਪ"}
{"t": 298.0, "text": "ਤੂੰ ਮੇ ਪ੍ਰ ਨਿਰਪ"}
{"t": 299.0, "text": "ਮੇਰੇ ਪ੍ਰਤ ਕਿਰਪ ਹੈ ਦੇਖਹੁ"}
{"t": 300.0, "text": "ਮਪ ਦੇਹੁਹੁ ਹਰਿ ਨਾਮ"}
