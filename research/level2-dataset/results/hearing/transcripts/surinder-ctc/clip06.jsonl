{"t": 233.0, "text": "ਪਾਉ ਸਰਬ ਮੇਰਾ ਮੁਖਿ"}
{"t": 234.0, "text": "ਸਰਬ ਮੇਲਾ ਮੁਖਿ ਪਾਵਹੁ"}
{"t": 235.0, "text": "ਤਾ ਮੁਖਿ ਪਾਵਹੁ"}
{"t": 236.0, "text": "ਪਾਾਵਹੁ ਜਰਾਮ"}
{"t": 237.0, "text": "ਹੋ ਜਰਾ ਮਰਾ"}
{"t": 238.0, "text": "ਜਰਾ ਮਰਾ"}
{"t": 239.0, "text": "ਰਾਮਰਾ ਤਾਪ ਨ ਸਭਨਾ"}
{"t": 240.0, "text": "ਾਰਾ ਤਾਪ ਨ ਸਭੁ ਨਾਠਾ"}
{"t": 241.0, "text": "ਪਾਪ ਨ ਸਭੁ ਨਾਠਾ ਗੁਣ"}
{"t": 242.0, "text": "ਸਭ ਨਾਠਾ ਗੁਣ ਗੋਬਿੰਦ ਨਿਤ"}
{"t": 243.0, "text": "ਠਾ ਗੁਣ ਗੋਬਿੰਦ ਨਿਤ"}
{"t": 244.0, "text": "ਗੁਣ ਗੋਬਿੰਦ ਨਿਤ ਗਾਵਹੁ"}
{"t": 245.0, "text": "ਬਿਨੁ ਨਿਤ ਗਾਵਹੁ"}
{"t": 246.0, "text": "ਰ ਗਵਹੁ"}
{"t": 247.0, "text": "ਨਾ"}
{"t": 248.0, "text": "ਕੋ"}
{"t": 249.0, "text": "ਵ"}
{"t": 250.0, "text": ""}
{"t": 251.0, "text": "ਸੁਣੀਰ"}
{"t": 252.0, "text": "ਸੁਣੀ ਅਰਦਾਿ"}
{"t": 253.0, "text": "ਸੁਣੀ ਅਰਦਾਸਿ"}
{"t": 254.0, "text": "ਸੁਣੀ ਅਰਦਾਸਿ ਸੁਆਮੀ ਮੇਰੇ"}
{"t": 255.0, "text": "ਦਾਸ ਸੁਆਮੀ ਮੇਰੈ"}
{"t": 256.0, "text": "ਸੁਿ ਸੁਆਮੀ ਮੇਰੈ ਸਰਬ ਕਲ"}
{"t": 257.0, "text": "ਕੀ ਮੇਰੇ ਸਰਬ ਕਲਾ"}
{"t": 258.0, "text": "ਹੈ ਸਰਬ ਕਲਾਣਿਆ"}
{"t": 259.0, "text": "ਸਰਬ ਕਲਾ ਬਣਿਆਈ"}
{"t": 260.0, "text": "ਬਣਿਆਈ"}
{"t": 261.0, "text": "ਧਿਆਈ ਪ੍ਰਗਟ"}
{"t": 262.0, "text": "ਪ੍ਰਗਟ ਭਈ"}
{"t": 263.0, "text": "ਸ ਪ੍ਰਗਟ ਭਈ"}
{"t": 264.0, "text": "ਪ੍ਰਗਟ ਭਈ ਸਗਰ"}
{"t": 265.0, "text": "ਸਾਗਰ ਜੋੁਗੰਤਰਿ"}
{"t": 266.0, "text": "ਨ ਸਾਗਰ ਜੋ ਗੁਰ ਅੰਤਰ ਗੁਰ ਨਾਨਕ"}
{"t": 267.0, "text": "ਜੋ ਗੁਰ ਅੰਤਰਿ ਗੁਰ ਨਾਨਕ"}
{"t": 268.0, "text": "ਅੰਤ ਗੁਰ ਨਾਨਕ ਕੀਿਆ"}
{"t": 269.0, "text": "ਗੁਰ ਨਾਨਕ ਕੀ ਵਡਿਆਈ"}
{"t": 270.0, "text": "ਕੀ ਵਡਿਆਈੁਰ"}
{"t": 271.0, "text": "ਧਿਆਈ ਗੁਰ ਨਾਨਕ"}
{"t": 272.0, "text": "ਵਣੀ ਗੁਰ ਨਾਨਕ ਕੀ"}
{"t": 273.0, "text": "ਗੁਰ ਨਾਨਕ ਕੀ"}
{"t": 274.0, "text": "ਨਾਨਕ ਕੀ ਵਡਿਆਈ"}
{"t": 275.0, "text": "ਕੀ ਵਡਿਆਈੁਰ"}
{"t": 276.0, "text": "ਬਿਆਰੇ ਗੁਰ ਨਾਨਕ"}
{"t": 277.0, "text": "ਨਾਇ ਗੁਰ ਨਾਨਕ ਕੀ"}
{"t": 278.0, "text": "ਗੁਰ ਨਾਨਕ ਕੀਿਆ"}
{"t": 279.0, "text": "ਨਾਨਕ ਕੀ ਵਡਿਆਈ"}
{"t": 280.0, "text": "ਕੀ ਵਡਿਆਈ ਪ੍ਰਭ"}
{"t": 281.0, "text": "ਦਿਆਰੇ ਪ੍ਰਭ ਬਾਣੀ"}
{"t": 282.0, "text": "ਸਾਰ ਪ੍ਰਭ ਬਾਣੀ ਸਬਦ"}
{"t": 283.0, "text": "ਪ੍ਰਭ ਬਾਣੀ ਸਬਦਿ ਸੁਭਾ"}
{"t": 284.0, "text": "ਬਾਣੀ ਸਬਦਿ ਸੁਭਾਿਆ"}
{"t": 285.0, "text": "ਸਬਦੁ ਸੁਭਾਖਿਆ"}
{"t": 286.0, "text": "ਸੁਭਾਖਿਆ ਪ੍ਰਭਣੀ"}
{"t": 287.0, "text": "ਨਾਮ ਪ੍ਰਭ ਬਾਣੀ ਸਬ ਜੁ"}
{"t": 288.0, "text": "ਪ੍ਰਭ ਬਾਣੀ ਸਭ ਜਗ"}
{"t": 289.0, "text": "ਸਭ ਬਾਣੀ ਸਬਦਦ ਸਮਾਿਆ"}
{"t": 290.0, "text": "ਸਬਦਦੁ ਸਮਾਖਿਆ"}
{"t": 291.0, "text": "ਸੁ ਕਿਆ ਗਾਵਹੁ"}
{"t": 292.0, "text": "ਆ ਗਾਵਹੁ ਸੁਣਹੁ"}
{"t": 293.0, "text": "ਗਾਵਹੁ ਸੁਣਹੁ ਪੜਹੁ"}
{"t": 294.0, "text": "ਆਵਹੁ ਸੁਣਹੁ ਪੜਹੁ ਨਿਤ"}
{"t": 295.0, "text": "ਗੁਰਉ ਪੜਉਲਿਤਾਈ"}
{"t": 296.0, "text": "ਪੜੋਲਿਤ ਭਾਈ ਵਾਰੋ"}
{"t": 297.0, "text": "ਨਤ ਭਾਈ ਵਾਰੋ ਸੁਣਹੁ"}
{"t": 298.0, "text": "ਪਾਈ ਵਾਰੋ ਸੁਣਹੁ ਪੜਹੁ"}
{"t": 299.0, "text": "ਦੀਵਾਾਰੋ ਸੁਣਹੁ ਪੜਹੁ ਨਿਤ"}
{"t": 300.0, "text": "ਪੜਹੁ ਨਿਤ ਭਾਈ"}
