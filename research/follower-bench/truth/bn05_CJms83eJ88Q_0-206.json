 "frames": 5125,
 "score": -2594.383544921875,
 "lines": [
  {
   "i": 1,
   "verseId": 1784,
   "text": "ਰਾਮਕਲੀ ਮਹਲਾ ੩ ਅਨੰਦੁ",
   "start": 9,
   "end": 14.2,
   "conf": -0.55,
   "check": 0.94
  },
  {
   "i": 2,
   "verseId": 1785,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 14.24,
   "end": 19.2,
   "conf": -1.829,
   "check": 0.89
  },
  {
   "i": 3,
   "verseId": 1786,
   "text": "ਅਨੰਦੁ ਭਇਆ ਮੇਰੀ ਮਾਏ ਸਤਿਗੁਰੂ ਮੈ ਪਾਇਆ ॥",
   "start": 19.36,
   "end": 23.36,
   "conf": -1.435,
   "check": 0.81
  },
  {
   "i": 4,
   "verseId": 1787,
   "text": "ਸਤਿਗੁਰੁ ਤ ਪਾਇਆ ਸਹਜ ਸੇਤੀ ਮਨਿ ਵਜੀਆ ਵਾਧਾਈਆ ॥",
   "start": 23.68,
   "end": 27.76,
   "conf": -3.027,
   "check": 0.71
  },
  {
   "i": 5,
   "verseId": 1788,
   "text": "ਰਾਗ ਰਤਨ ਪਰਵਾਰ ਪਰੀਆ ਸਬਦ ਗਾਵਣ ਆਈਆ ॥",
   "start": 28.2,
   "end": 32.28,
   "conf": -0.621,
   "check": 0.84
  },
  {
   "i": 6,
   "verseId": 1789,
   "text": "ਸਬਦੋ ਤ ਗਾਵਹੁ ਹਰੀ ਕੇਰਾ ਮਨਿ ਜਿਨੀ ਵਸਾਇਆ ॥",
   "start": 32.6,
   "end": 36.72,
   "conf": -2.083,
   "check": 0.83
  },
  {
   "i": 7,
   "verseId": 1790,
   "text": "ਕਹੈ ਨਾਨਕੁ ਅਨੰਦੁ ਹੋਆ ਸਤਿਗੁਰੂ ਮੈ ਪਾਇਆ ॥੧॥",
   "start": 37.16,
   "end": 41.12,
   "conf": -0.379,
   "check": 0.93
  },
  {
   "i": 8,
   "verseId": 1791,
   "text": "ਏ ਮਨ ਮੇਰਿਆ ਤੂ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥",
   "start": 41.6,
   "end": 45.56,
   "conf": -2.304,
   "check": 0.22
  },
  {
   "i": 9,
   "verseId": 1792,
   "text": "ਹਰਿ ਨਾਲਿ ਰਹੁ ਤੂ ਮੰਨ ਮੇਰੇ ਦੂਖ ਸਭਿ ਵਿਸਾਰਣਾ ॥",
   "start": 45.6,
   "end": 49.84,
   "conf": -1.284,
   "check": 0.77
  },
  {
   "i": 10,
   "verseId": 1793,
   "text": "ਅੰਗੀਕਾਰੁ ਓਹੁ ਕਰੇ ਤੇਰਾ ਕਾਰਜ ਸਭਿ ਸਵਾਰਣਾ ॥",
   "start": 50.04,
   "end": 54.16,
   "conf": -2.876,
   "check": 0.65
  },
  {
   "i": 11,
   "verseId": 1794,
   "text": "ਸਭਨਾ ਗਲਾ ਸਮਰਥੁ ਸੁਆਮੀ ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੇ ॥",
   "start": 54.44,
   "end": 58.72,
   "conf": -2.664,
   "check": 0.6
  },
  {
   "i": 12,
   "verseId": 1795,
   "text": "ਕਹੈ ਨਾਨਕੁ ਮੰਨ ਮੇਰੇ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥੨॥",
   "start": 58.8,
   "end": 63.2,
   "conf": -1.239,
   "check": 0.91
  },
  {
   "i": 13,
   "verseId": 1796,
   "text": "ਸਾਚੇ ਸਾਹਿਬਾ ਕਿਆ ਨਾਹੀ ਘਰਿ ਤੇਰੈ ॥",
   "start": 63.76,
   "end": 67.8,
   "conf": -0.492,
   "check": 0.96
  },
  {
   "i": 14,
   "verseId": 1797,
   "text": "ਘਰਿ ਤ ਤੇਰੈ ਸਭੁ ਕਿਛੁ ਹੈ ਜਿਸੁ ਦੇਹਿ ਸੁ ਪਾਵਏ ॥",
   "start": 68.12,
   "end": 72.28,
   "conf": -1.506,
   "check": 0.74
  },
  {
   "i": 15,
   "verseId": 1798,
   "text": "ਸਦਾ ਸਿਫਤਿ ਸਲਾਹ ਤੇਰੀ ਨਾਮੁ ਮਨਿ ਵਸਾਵਏ ॥",
   "start": 72.76,
   "end": 76.64,
   "conf": -1.261,
   "check": 0.76
  },
  {
   "i": 16,
   "verseId": 1799,
   "text": "ਨਾਮੁ ਜਿਨ ਕੈ ਮਨਿ ਵਸਿਆ ਵਾਜੇ ਸਬਦ ਘਨੇਰੇ ॥",
   "start": 77.08,
   "end": 80.88,
   "conf": -0.556,
   "check": 0.89
  },
  {
   "i": 17,
   "verseId": 1800,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸਚੇ ਸਾਹਿਬ ਕਿਆ ਨਾਹੀ ਘਰਿ ਤੇਰੈ ॥੩॥",
   "start": 81.36,
   "end": 85.16,
   "conf": -1.042,
   "check": 0.78
  },
  {
   "i": 18,
   "verseId": 1801,
   "text": "ਸਾਚਾ ਨਾਮੁ ਮੇਰਾ ਆਧਾਰੋ ॥",
   "start": 85.28,
   "end": 87.6,
   "conf": -0.279,
   "check": 0.94
  },
  {
   "i": 19,
   "verseId": 1802,
   "text": "ਸਾਚੁ ਨਾਮੁ ਅਧਾਰੁ ਮੇਰਾ ਜਿਨਿ ਭੁਖਾ ਸਭਿ ਗਵਾਈਆ ॥",
   "start": 88.04,
   "end": 91.96,
   "conf": -0.475,
   "check": 0.88
  },
  {
   "i": 20,
   "verseId": 1803,
   "text": "ਕਰਿ ਸਾਂਤਿ ਸੁਖ ਮਨਿ ਆਇ ਵਸਿਆ ਜਿਨਿ ਇਛਾ ਸਭਿ ਪੁਜਾਈਆ ॥",
   "start": 92.12,
   "end": 96.4,
   "conf": -1.572,
   "check": 0.84
  },
  {
   "i": 21,
   "verseId": 1804,
   "text": "ਸਦਾ ਕੁਰਬਾਣੁ ਕੀਤਾ ਗੁਰੂ ਵਿਟਹੁ ਜਿਸ ਦੀਆ ਏਹਿ ਵਡਿਆਈਆ ॥",
   "start": 96.6,
   "end": 100.8,
   "conf": -1.677,
   "check": 0.6
  },
  {
   "i": 22,
   "verseId": 1805,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸੁਣਹੁ ਸੰਤਹੁ ਸਬਦਿ ਧਰਹੁ ਪਿਆਰੋ ॥",
   "start": 101.2,
   "end": 104.92,
   "conf": -0.764,
   "check": 0.81
  },
  {
   "i": 23,
   "verseId": 1806,
   "text": "ਸਾਚਾ ਨਾਮੁ ਮੇਰਾ ਆਧਾਰੋ ॥੪॥",
   "start": 105.08,
   "end": 107.16,
   "conf": -0.856,
   "check": 0.8
  },
  {
   "i": 24,
   "verseId": 1807,
   "text": "ਵਾਜੇ ਪੰਚ ਸਬਦ ਤਿਤੁ ਘਰਿ ਸਭਾਗੈ ॥",
   "start": 107.32,
   "end": 109.92,
   "conf": -2.242,
   "check": 0.64
  },
  {
   "i": 25,
   "verseId": 1808,
   "text": "ਘਰਿ ਸਭਾਗੈ ਸਬਦ ਵਾਜੇ ਕਲਾ ਜਿਤੁ ਘਰਿ ਧਾਰੀਆ ॥",
   "start": 110.08,
   "end": 114.12,
   "conf": -1.728,
   "check": 0.68
  },
  {
   "i": 26,
   "verseId": 1809,
   "text": "ਪੰਚ ਦੂਤ ਤੁਧੁ ਵਸਿ ਕੀਤੇ ਕਾਲੁ ਕੰਟਕੁ ਮਾਰਿਆ ॥",
   "start": 114.48,
   "end": 118.48,
   "conf": -1.438,
   "check": 0.6
  },
  {
   "i": 27,
   "verseId": 1810,
   "text": "ਧੁਰਿ ਕਰਮਿ ਪਾਇਆ ਤੁਧੁ ਜਿਨ ਕਉ ਸਿ ਨਾਮਿ ਹਰਿ ਕੈ ਲਾਗੇ ॥",
   "start": 118.56,
   "end": 122.96,
   "conf": -2.672,
   "check": 0.68
  },
  {
   "i": 28,
   "verseId": 1811,
   "text": "ਕਹੈ ਨਾਨਕੁ ਤਹ ਸੁਖੁ ਹੋਆ ਤਿਤੁ ਘਰਿ ਅਨਹਦ ਵਾਜੇ ॥੫॥",
   "start": 123.36,
   "end": 127.4,
   "conf": -1.142,
   "check": 0.79
  },
  {
   "i": 205,
   "verseId": 1988,
   "text": "ਅਨਦੁ ਸੁਣਹੁ ਵਡਭਾਗੀਹੋ ਸਗਲ ਮਨੋਰਥ ਪੂਰੇ ॥",
   "start": 127.68,
   "end": 131.64,
   "conf": -1.674,
   "check": 0.69
  },
  {
   "i": 206,
   "verseId": 1989,
   "text": "ਪਾਰਬ੍ਰਹਮੁ ਪ੍ਰਭੁ ਪਾਇਆ ਉਤਰੇ ਸਗਲ ਵਿਸੂਰੇ ॥",
   "start": 132.16,
   "end": 136.12,
   "conf": -0.883,
   "check": 0.81
  },
  {
   "i": 207,
   "verseId": 1990,
   "text": "ਦੂਖ ਰੋਗ ਸੰਤਾਪ ਉਤਰੇ ਸੁਣੀ ਸਚੀ ਬਾਣੀ ॥",
   "start": 136.56,
   "end": 140.4,
   "conf": -0.35,
   "check": 0.88
  },
  {
   "i": 208,
   "verseId": 1991,
   "text": "ਸੰਤ ਸਾਜਨ ਭਏ ਸਰਸੇ ਪੂਰੇ ਗੁਰ ਤੇ ਜਾਣੀ ॥",
   "start": 140.84,
   "end": 144.64,
   "conf": -1.214,
   "check": 0.83
  },
  {
   "i": 209,
   "verseId": 1992,
   "text": "ਸੁਣਤੇ ਪੁਨੀਤ ਕਹਤੇ ਪਵਿਤੁ ਸਤਿਗੁਰੁ ਰਹਿਆ ਭਰਪੂਰੇ ॥",
   "start": 144.84,
   "end": 148.84,
   "conf": -0.755,
   "check": 0.89
  },
  {
   "i": 210,
   "verseId": 1993,
   "text": "ਬਿਨਵੰਤਿ ਨਾਨਕੁ ਗੁਰ ਚਰਣ ਲਾਗੇ ਵਾਜੇ ਅਨਹਦ ਤੂਰੇ ॥੪੦॥੧॥",
   "start": 149.28,
   "end": 153.2,
   "conf": -0.706,
   "check": 0.81
  },
  {
   "i": 201,
   "verseId": 1984,
   "text": "ਗਾਵਹੁ ਤ ਸੋਹਿਲਾ ਘਰਿ ਸਾਚੈ ਜਿਥੈ ਸਦਾ ਸਚੁ ਧਿਆਵਹੇ ॥",
   "start": 153.8,
   "end": 161.6,
   "conf": -8.487,
   "check": 0.37
  },
  {
   "i": 202,
   "verseId": 1985,
   "text": "ਸਚੋ ਧਿਆਵਹਿ ਜਾ ਤੁਧੁ ਭਾਵਹਿ ਗੁਰਮੁਖਿ ਜਿਨਾ ਬੁਝਾਵਹੇ ॥",
   "start": 161.76,
   "end": 170.8,
   "conf": -8.851,
   "check": 0.24
  },
  {
   "i": 203,
   "verseId": 1986,
   "text": "ਇਹੁ ਸਚੁ ਸਭਨਾ ਕਾ ਖਸਮੁ ਹੈ ਜਿਸੁ ਬਖਸੇ ਸੋ ਜਨੁ ਪਾਵਹੇ ॥",
   "start": 171.24,
   "end": 179.68,
   "conf": -10.293,
   "check": 0.28
  },
  {
   "i": 204,
   "verseId": 1987,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸਚੁ ਸੋਹਿਲਾ ਸਚੈ ਘਰਿ ਗਾਵਹੇ ॥੩੯॥",
   "start": 179.96,
   "end": 191.08,
   "conf": -9.618,
   "check": 0.32
  },
  {
   "i": 202,
   "verseId": 1985,
