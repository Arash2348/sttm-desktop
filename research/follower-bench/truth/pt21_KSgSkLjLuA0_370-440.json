 "lines": [
  {
   "i": 77,
   "verseId": 2705,
   "text": "ਨਾ ਕੋ ਹੋਆ ਨਾ ਕੋ ਹੋਇ ॥੩॥",
   "start": 0.76,
   "end": 3.44,
   "conf": -0.219,
   "check": 1
  },
  {
   "i": 78,
   "verseId": 2706,
   "text": "ਜੇਵਡੁ ਆਪਿ ਤੇਵਡ ਤੇਰੀ ਦਾਤਿ ॥",
   "start": 4.76,
   "end": 8.48,
   "conf": -0.612,
   "check": 0.94
  },
  {
   "i": 79,
   "verseId": 2707,
   "text": "ਜਿਨਿ ਦਿਨੁ ਕਰਿ ਕੈ ਕੀਤੀ ਰਾਤਿ ॥",
   "start": 10.2,
   "end": 13.12,
   "conf": -0.553,
   "check": 0.89
  },
  {
   "i": 80,
   "verseId": 2708,
   "text": "ਖਸਮੁ ਵਿਸਾਰਹਿ ਤੇ ਕਮਜਾਤਿ ॥",
   "start": 14.04,
   "end": 16.84,
   "conf": -0.324,
   "check": 0.82
  },
  {
   "i": 81,
   "verseId": 2709,
   "text": "ਨਾਨਕ ਨਾਵੈ ਬਾਝੁ ਸਨਾਤਿ ॥੪॥੩॥",
   "start": 17.8,
   "end": 20.64,
   "conf": -0.843,
   "check": 0.83
  },
  {
   "i": 82,
   "verseId": 2710,
   "text": "ਰਾਗੁ ਗੂਜਰੀ ਮਹਲਾ ੪ ॥",
   "start": 22.24,
   "end": 25.12,
   "conf": -0.808,
   "check": 0.82
  },
  {
   "i": 83,
   "verseId": 2711,
   "text": "ਹਰਿ ਕੇ ਜਨ ਸਤਿਗੁਰ ਸਤਪੁਰਖਾ ਬਿਨਉ ਕਰਉ ਗੁਰ ਪਾਸਿ ॥",
   "start": 26.64,
   "end": 32.36,
   "conf": -0.269,
   "check": 0.85
  },
  {
   "i": 84,
   "verseId": 2712,
   "text": "ਹਮ ਕੀਰੇ ਕਿਰਮ ਸਤਿਗੁਰ ਸਰਣਾਈ ਕਰਿ ਦਇਆ ਨਾਮੁ ਪਰਗਾਸਿ ॥੧॥",
   "start": 33.24,
   "end": 39.96,
   "conf": -0.315,
   "check": 0.94
  },
  {
   "i": 85,
   "verseId": 2713,
   "text": "ਮੇਰੇ ਮੀਤ ਗੁਰਦੇਵ ਮੋ ਕਉ ਰਾਮ ਨਾਮੁ ਪਰਗਾਸਿ ॥",
   "start": 40.88,
   "end": 46.84,
   "conf": -0.227,
   "check": 0.96
  },
  {
   "i": 86,
   "verseId": 2714,
   "text": "ਗੁਰਮਤਿ ਨਾਮੁ ਮੇਰਾ ਪ੍ਰਾਨ ਸਖਾਈ ਹਰਿ ਕੀਰਤਿ ਹਮਰੀ ਰਹਰਾਸਿ ॥੧॥ ਰਹਾਉ ॥",
   "start": 47.76,
   "end": 55.84,
   "conf": -0.293,
   "check": 0.97
  },
  {
   "i": 87,
   "verseId": 2715,
   "text": "ਹਰਿ ਜਨ ਕੇ ਵਡ ਭਾਗ ਵਡੇਰੇ ਜਿਨ ਹਰਿ ਹਰਿ ਸਰਧਾ ਹਰਿ ਪਿਆਸ ॥",
   "start": 56.8,
   "end": 63.08,
   "conf": -0.648,
   "check": 0.76
  },
  {
   "i": 88,
   "verseId": 2716,
   "text": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਮਿਲੈ ਤ੍ਰਿਪਤਾਸਹਿ ਮਿਲਿ ਸੰਗਤਿ ਗੁਣ ਪਰਗਾਸਿ ॥੨॥",
   "start": 64.24,
