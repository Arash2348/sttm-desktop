 "lines": [
  {
   "i": 5,
   "verseId": 1788,
   "text": "ਰਾਗ ਰਤਨ ਪਰਵਾਰ ਪਰੀਆ ਸਬਦ ਗਾਵਣ ਆਈਆ ॥",
   "start": 0.08,
   "end": 4.92,
   "conf": -0.587,
   "check": 0.96
  },
  {
   "i": 6,
   "verseId": 1789,
   "text": "ਸਬਦੋ ਤ ਗਾਵਹੁ ਹਰੀ ਕੇਰਾ ਮਨਿ ਜਿਨੀ ਵਸਾਇਆ ॥",
   "start": 6.12,
   "end": 11.52,
   "conf": -0.186,
   "check": 0.97
  },
  {
   "i": 7,
   "verseId": 1790,
   "text": "ਕਹੈ ਨਾਨਕੁ ਅਨੰਦੁ ਹੋਆ ਸਤਿਗੁਰੂ ਮੈ ਪਾਇਆ ॥੧॥",
   "start": 12.8,
   "end": 18.2,
   "conf": -0.253,
   "check": 0.93
  },
  {
   "i": 8,
   "verseId": 1791,
   "text": "ਏ ਮਨ ਮੇਰਿਆ ਤੂ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥",
   "start": 19.32,
   "end": 23.72,
   "conf": -0.545,
   "check": 0.91
  },
  {
   "i": 9,
   "verseId": 1792,
   "text": "ਹਰਿ ਨਾਲਿ ਰਹੁ ਤੂ ਮੰਨ ਮੇਰੇ ਦੂਖ ਸਭਿ ਵਿਸਾਰਣਾ ॥",
   "start": 24.72,
   "end": 30.12,
   "conf": -0.906,
   "check": 0.78
  },
  {
   "i": 10,
   "verseId": 1793,
   "text": "ਅੰਗੀਕਾਰੁ ਓਹੁ ਕਰੇ ਤੇਰਾ ਕਾਰਜ ਸਭਿ ਸਵਾਰਣਾ ॥",
   "start": 31.24,
   "end": 36.64,
   "conf": -0.203,
   "check": 0.86
  },
  {
   "i": 11,
   "verseId": 1794,
   "text": "ਸਭਨਾ ਗਲਾ ਸਮਰਥੁ ਸੁਆਮੀ ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੇ ॥",
   "start": 37.68,
   "end": 43.12,
   "conf": -0.213,
   "check": 0.97
  },
  {
   "i": 12,
   "verseId": 1795,
   "text": "ਕਹੈ ਨਾਨਕੁ ਮੰਨ ਮੇਰੇ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥੨॥",
   "start": 44.2,
   "end": 49.4,
   "conf": -0.602,
   "check": 0.89
  },
  {
   "i": 13,
   "verseId": 1796,
   "text": "ਸਾਚੇ ਸਾਹਿਬਾ ਕਿਆ ਨਾਹੀ ਘਰਿ ਤੇਰੈ ॥",
   "start": 50.72,
   "end": 55.2,
   "conf": -0.038,
   "check": 1
  },
  {
   "i": 14,
   "verseId": 1797,
   "text": "ਘਰਿ ਤ ਤੇਰੈ ਸਭੁ ਕਿਛੁ ਹੈ ਜਿਸੁ ਦੇਹਿ ਸੁ ਪਾਵਏ ॥",
   "start": 56.04,
   "end": 61.28,
   "conf": -0.286,
   "check": 0.94
  },
  {
   "i": 15,
   "verseId": 1798,
   "text": "ਸਦਾ ਸਿਫਤਿ ਸਲਾਹ ਤੇਰੀ ਨਾਮੁ ਮਨਿ ਵਸਾਵਏ ॥",
   "start": 62.28,
   "end": 67.64,
   "conf": -0.525,
   "check": 0.96
  },
  {
   "i": 16,
   "verseId": 1799,
   "text": "ਨਾਮੁ ਜਿਨ ਕੈ ਮਨਿ ਵਸਿਆ ਵਾਜੇ ਸਬਦ ਘਨੇਰੇ ॥",
   "start": 68.8,
   "end": 69.72,
   "conf": -0.075,
   "check": 0.54
  }
