 "frames": 3973,
 "score": -1469.809326171875,
 "lines": [
  {
   "i": 1,
   "verseId": 1784,
   "text": "ਰਾਮਕਲੀ ਮਹਲਾ ੩ ਅਨੰਦੁ",
   "start": 0.52,
   "end": 3.68,
   "conf": -0.546,
   "check": 0.94
  },
  {
   "i": 2,
   "verseId": 1785,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 3.84,
   "end": 6.52,
   "conf": -2.046,
   "check": 0.88
  },
  {
   "i": 3,
   "verseId": 1786,
   "text": "ਅਨੰਦੁ ਭਇਆ ਮੇਰੀ ਮਾਏ ਸਤਿਗੁਰੂ ਮੈ ਪਾਇਆ ॥",
   "start": 7.44,
   "end": 11.8,
   "conf": -0.487,
   "check": 0.82
  },
  {
   "i": 4,
   "verseId": 1787,
   "text": "ਸਤਿਗੁਰੁ ਤ ਪਾਇਆ ਸਹਜ ਸੇਤੀ ਮਨਿ ਵਜੀਆ ਵਾਧਾਈਆ ॥",
   "start": 12.04,
   "end": 16.68,
   "conf": -0.544,
   "check": 0.84
  },
  {
   "i": 5,
   "verseId": 1788,
   "text": "ਰਾਗ ਰਤਨ ਪਰਵਾਰ ਪਰੀਆ ਸਬਦ ਗਾਵਣ ਆਈਆ ॥",
   "start": 17.16,
   "end": 21.4,
   "conf": -0.402,
   "check": 0.92
  },
  {
   "i": 6,
   "verseId": 1789,
   "text": "ਸਬਦੋ ਤ ਗਾਵਹੁ ਹਰੀ ਕੇਰਾ ਮਨਿ ਜਿਨੀ ਵਸਾਇਆ ॥",
   "start": 21.64,
   "end": 26.2,
   "conf": -0.744,
   "check": 0.73
  },
  {
   "i": 7,
   "verseId": 1790,
   "text": "ਕਹੈ ਨਾਨਕੁ ਅਨੰਦੁ ਹੋਆ ਸਤਿਗੁਰੂ ਮੈ ਪਾਇਆ ॥੧॥",
   "start": 26.72,
   "end": 30.92,
   "conf": -1.957,
   "check": 0.78
  },
  {
   "i": 8,
   "verseId": 1791,
   "text": "ਏ ਮਨ ਮੇਰਿਆ ਤੂ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥",
   "start": 31.44,
   "end": 35.44,
   "conf": -1.277,
   "check": 0.75
  },
  {
   "i": 9,
   "verseId": 1792,
   "text": "ਹਰਿ ਨਾਲਿ ਰਹੁ ਤੂ ਮੰਨ ਮੇਰੇ ਦੂਖ ਸਭਿ ਵਿਸਾਰਣਾ ॥",
   "start": 35.8,
   "end": 40.36,
   "conf": -1.529,
   "check": 0.75
  },
  {
   "i": 10,
   "verseId": 1793,
   "text": "ਅੰਗੀਕਾਰੁ ਓਹੁ ਕਰੇ ਤੇਰਾ ਕਾਰਜ ਸਭਿ ਸਵਾਰਣਾ ॥",
   "start": 40.84,
   "end": 44.96,
   "conf": -1.993,
   "check": 0.77
  },
  {
   "i": 11,
   "verseId": 1794,
   "text": "ਸਭਨਾ ਗਲਾ ਸਮਰਥੁ ਸੁਆਮੀ ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੇ ॥",
   "start": 45.2,
   "end": 49.32,
   "conf": -1.124,
   "check": 0.82
  },
  {
   "i": 12,
   "verseId": 1795,
   "text": "ਕਹੈ ਨਾਨਕੁ ਮੰਨ ਮੇਰੇ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥੨॥",
   "start": 50.08,
   "end": 54.28,
   "conf": -1.31,
   "check": 0.74
  },
  {
   "i": 13,
   "verseId": 1796,
   "text": "ਸਾਚੇ ਸਾਹਿਬਾ ਕਿਆ ਨਾਹੀ ਘਰਿ ਤੇਰੈ ॥",
   "start": 54.84,
   "end": 58.88,
   "conf": -0.572,
   "check": 0.91
  },
  {
   "i": 14,
   "verseId": 1797,
   "text": "ਘਰਿ ਤ ਤੇਰੈ ਸਭੁ ਕਿਛੁ ਹੈ ਜਿਸੁ ਦੇਹਿ ਸੁ ਪਾਵਏ ॥",
   "start": 59.28,
   "end": 63.48,
   "conf": -1.186,
   "check": 0.77
  },
  {
   "i": 15,
   "verseId": 1798,
   "text": "ਸਦਾ ਸਿਫਤਿ ਸਲਾਹ ਤੇਰੀ ਨਾਮੁ ਮਨਿ ਵਸਾਵਏ ॥",
   "start": 63.96,
   "end": 67.92,
   "conf": -2.28,
   "check": 0.7
  },
  {
   "i": 16,
   "verseId": 1799,
   "text": "ਨਾਮੁ ਜਿਨ ਕੈ ਮਨਿ ਵਸਿਆ ਵਾਜੇ ਸਬਦ ਘਨੇਰੇ ॥",
   "start": 68.44,
   "end": 72.56,
   "conf": -0.199,
   "check": 1
  },
  {
   "i": 17,
   "verseId": 1800,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸਚੇ ਸਾਹਿਬ ਕਿਆ ਨਾਹੀ ਘਰਿ ਤੇਰੈ ॥੩॥",
   "start": 73.08,
   "end": 77.04,
   "conf": -0.909,
   "check": 0.87
  },
  {
   "i": 18,
   "verseId": 1801,
   "text": "ਸਾਚਾ ਨਾਮੁ ਮੇਰਾ ਆਧਾਰੋ ॥",
   "start": 77.2,
   "end": 79.56,
   "conf": -0.203,
   "check": 1
  },
  {
   "i": 19,
   "verseId": 1802,
   "text": "ਸਾਚੁ ਨਾਮੁ ਅਧਾਰੁ ਮੇਰਾ ਜਿਨਿ ਭੁਖਾ ਸਭਿ ਗਵਾਈਆ ॥",
   "start": 80.04,
   "end": 84.08,
   "conf": -0.665,
   "check": 0.79
  },
  {
   "i": 20,
   "verseId": 1803,
   "text": "ਕਰਿ ਸਾਂਤਿ ਸੁਖ ਮਨਿ ਆਇ ਵਸਿਆ ਜਿਨਿ ਇਛਾ ਸਭਿ ਪੁਜਾਈਆ ॥",
   "start": 84.28,
   "end": 88.68,
   "conf": -1.254,
   "check": 0.8
  },
  {
   "i": 21,
   "verseId": 1804,
   "text": "ਸਦਾ ਕੁਰਬਾਣੁ ਕੀਤਾ ਗੁਰੂ ਵਿਟਹੁ ਜਿਸ ਦੀਆ ਏਹਿ ਵਡਿਆਈਆ ॥",
   "start": 89.12,
   "end": 93.28,
   "conf": -1.239,
   "check": 0.68
  },
  {
   "i": 22,
   "verseId": 1805,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸੁਣਹੁ ਸੰਤਹੁ ਸਬਦਿ ਧਰਹੁ ਪਿਆਰੋ ॥",
   "start": 93.76,
   "end": 97.52,
   "conf": -0.384,
   "check": 0.93
  },
  {
   "i": 23,
   "verseId": 1806,
   "text": "ਸਾਚਾ ਨਾਮੁ ਮੇਰਾ ਆਧਾਰੋ ॥੪॥",
   "start": 97.72,
   "end": 99.84,
   "conf": -1.256,
   "check": 0.79
  },
  {
   "i": 24,
   "verseId": 1807,
   "text": "ਵਾਜੇ ਪੰਚ ਸਬਦ ਤਿਤੁ ਘਰਿ ਸਭਾਗੈ ॥",
   "start": 100,
   "end": 102.68,
   "conf": -1.582,
   "check": 0.5
  },
  {
   "i": 25,
   "verseId": 1808,
   "text": "ਘਰਿ ਸਭਾਗੈ ਸਬਦ ਵਾਜੇ ਕਲਾ ਜਿਤੁ ਘਰਿ ਧਾਰੀਆ ॥",
   "start": 102.88,
   "end": 106.92,
   "conf": -0.778,
   "check": 0.81
  },
  {
   "i": 26,
   "verseId": 1809,
   "text": "ਪੰਚ ਦੂਤ ਤੁਧੁ ਵਸਿ ਕੀਤੇ ਕਾਲੁ ਕੰਟਕੁ ਮਾਰਿਆ ॥",
   "start": 107.36,
   "end": 111.36,
   "conf": -0.967,
   "check": 0.75
  },
  {
   "i": 27,
   "verseId": 1810,
   "text": "ਧੁਰਿ ਕਰਮਿ ਪਾਇਆ ਤੁਧੁ ਜਿਨ ਕਉ ਸਿ ਨਾਮਿ ਹਰਿ ਕੈ ਲਾਗੇ ॥",
   "start": 111.52,
   "end": 116,
   "conf": -1.258,
   "check": 0.75
  },
  {
   "i": 28,
   "verseId": 1811,
   "text": "ਕਹੈ ਨਾਨਕੁ ਤਹ ਸੁਖੁ ਹੋਆ ਤਿਤੁ ਘਰਿ ਅਨਹਦ ਵਾਜੇ ॥੫॥",
   "start": 116.4,
   "end": 120.52,
   "conf": -1.075,
   "check": 0.67
  },
  {
   "i": 205,
   "verseId": 1988,
   "text": "ਅਨਦੁ ਸੁਣਹੁ ਵਡਭਾਗੀਹੋ ਸਗਲ ਮਨੋਰਥ ਪੂਰੇ ॥",
   "start": 120.92,
   "end": 124.84,
   "conf": -2.178,
   "check": 0.62
  },
  {
   "i": 206,
   "verseId": 1989,
   "text": "ਪਾਰਬ੍ਰਹਮੁ ਪ੍ਰਭੁ ਪਾਇਆ ਉਤਰੇ ਸਗਲ ਵਿਸੂਰੇ ॥",
   "start": 125.36,
   "end": 129.32,
   "conf": -2.183,
   "check": 0.71
  },
  {
   "i": 207,
   "verseId": 1990,
   "text": "ਦੂਖ ਰੋਗ ਸੰਤਾਪ ਉਤਰੇ ਸੁਣੀ ਸਚੀ ਬਾਣੀ ॥",
   "start": 129.8,
   "end": 133.92,
   "conf": -0.392,
   "check": 0.88
  },
  {
   "i": 208,
   "verseId": 1991,
   "text": "ਸੰਤ ਸਾਜਨ ਭਏ ਸਰਸੇ ਪੂਰੇ ਗੁਰ ਤੇ ਜਾਣੀ ॥",
   "start": 134.56,
   "end": 138.56,
   "conf": -0.946,
   "check": 0.78
  },
  {
   "i": 209,
   "verseId": 1992,
   "text": "ਸੁਣਤੇ ਪੁਨੀਤ ਕਹਤੇ ਪਵਿਤੁ ਸਤਿਗੁਰੁ ਰਹਿਆ ਭਰਪੂਰੇ ॥",
   "start": 138.76,
   "end": 142.84,
   "conf": -2.167,
   "check": 0.69
  },
  {
   "i": 210,
   "verseId": 1993,
   "text": "ਬਿਨਵੰਤਿ ਨਾਨਕੁ ਗੁਰ ਚਰਣ ਲਾਗੇ ਵਾਜੇ ਅਨਹਦ ਤੂਰੇ ॥੪੦॥੧॥",
   "start": 143.32,
   "end": 147.68,
   "conf": -0.719,
   "check": 0.83
  },
  {
