 "lines": [
  {
   "i": 0,
   "verseId": 12,
   "text": "ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 1.08,
   "end": 11.76,
   "conf": -1.032,
   "check": 0.92
  },
  {
   "i": 1,
   "verseId": 13,
   "text": "॥ ਜਪੁ ॥",
   "start": 12.96,
   "end": 13.4,
   "conf": -1.568,
   "check": 0.67
  },
  {
   "i": 2,
   "verseId": 14,
   "text": "ਆਦਿ ਸਚੁ ਜੁਗਾਦਿ ਸਚੁ ॥",
   "start": 13.76,
   "end": 16,
   "conf": -0.06,
   "check": 1
  },
  {
   "i": 3,
   "verseId": 15,
   "text": "ਹੈ ਭੀ ਸਚੁ ਨਾਨਕ ਹੋਸੀ ਭੀ ਸਚੁ ॥੧॥",
   "start": 16.12,
   "end": 21.04,
   "conf": -0.054,
   "check": 0.95
  },
  {
   "i": 4,
   "verseId": 16,
   "text": "ਸੋਚੈ ਸੋਚਿ ਨ ਹੋਵਈ ਜੇ ਸੋਚੀ ਲਖ ਵਾਰ ॥",
   "start": 22,
   "end": 26.04,
   "conf": -0.56,
   "check": 0.83
  },
  {
   "i": 5,
   "verseId": 17,
   "text": "ਚੁਪੈ ਚੁਪ ਨ ਹੋਵਈ ਜੇ ਲਾਇ ਰਹਾ ਲਿਵ ਤਾਰ ॥",
   "start": 27.12,
   "end": 30.76,
   "conf": -0.28,
   "check": 0.96
  },
  {
   "i": 6,
   "verseId": 18,
   "text": "ਭੁਖਿਆ ਭੁਖ ਨ ਉਤਰੀ ਜੇ ਬੰਨਾ ਪੁਰੀਆ ਭਾਰ ॥",
   "start": 31.84,
   "end": 35.44,
   "conf": -0.488,
   "check": 0.89
  },
  {
   "i": 7,
   "verseId": 19,
   "text": "ਸਹਸ ਸਿਆਣਪਾ ਲਖ ਹੋਹਿ ਤ ਇਕ ਨ ਚਲੈ ਨਾਲਿ ॥",
   "start": 36.08,
   "end": 39.88,
   "conf": -1.508,
   "check": 0.74
  },
  {
   "i": 8,
   "verseId": 20,
   "text": "ਕਿਵ ਸਚਿਆਰਾ ਹੋਈਐ ਕਿਵ ਕੂੜੈ ਤੁਟੈ ਪਾਲਿ ॥",
   "start": 40.96,
   "end": 44.88,
   "conf": -1.024,
   "check": 0.93
  },
  {
   "i": 9,
   "verseId": 21,
   "text": "ਹੁਕਮਿ ਰਜਾਈ ਚਲਣਾ ਨਾਨਕ ਲਿਖਿਆ ਨਾਲਿ ॥੧॥",
   "start": 45.12,
   "end": 48.72,
   "conf": -0.77,
   "check": 0.9
  },
  {
   "i": 10,
   "verseId": 22,
   "text": "ਹੁਕਮੀ ਹੋਵਨਿ ਆਕਾਰ ਹੁਕਮੁ ਨ ਕਹਿਆ ਜਾਈ ॥",
   "start": 49.6,
   "end": 53.16,
   "conf": -0.584,
   "check": 0.78
  },
  {
   "i": 11,
   "verseId": 23,
   "text": "ਹੁਕਮੀ ਹੋਵਨਿ ਜੀਅ ਹੁਕਮਿ ਮਿਲੈ ਵਡਿਆਈ ॥",
   "start": 53.36,
   "end": 54.48,
