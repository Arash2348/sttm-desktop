 "lines": [
  {
   "i": 135,
   "verseId": 2763,
   "text": "ਸਭ ਤੇਰੀ ਤੂੰ ਸਭਨੀ ਧਿਆਇਆ ॥",
   "start": 2.4,
   "end": 5.08,
   "conf": -0.048,
   "check": 0.94
  },
  {
   "i": 136,
   "verseId": 2764,
   "text": "ਜਿਸ ਨੋ ਕ੍ਰਿਪਾ ਕਰਹਿ ਤਿਨਿ ਨਾਮ ਰਤਨੁ ਪਾਇਆ ॥",
   "start": 6.12,
   "end": 10.28,
   "conf": -0.266,
   "check": 0.89
  },
  {
   "i": 137,
   "verseId": 2765,
   "text": "ਗੁਰਮੁਖਿ ਲਾਧਾ ਮਨਮੁਖਿ ਗਵਾਇਆ ॥",
   "start": 11.28,
   "end": 14.44,
   "conf": -0.188,
   "check": 1
  },
  {
   "i": 138,
   "verseId": 2766,
   "text": "ਤੁਧੁ ਆਪਿ ਵਿਛੋੜਿਆ ਆਪਿ ਮਿਲਾਇਆ ॥੧॥",
   "start": 15.32,
   "end": 18.96,
   "conf": -1.437,
   "check": 0.93
  },
  {
   "i": 139,
   "verseId": 2767,
   "text": "ਤੂੰ ਦਰੀਆਉ ਸਭ ਤੁਝ ਹੀ ਮਾਹਿ ॥",
   "start": 19.96,
   "end": 23.24,
   "conf": -0.993,
   "check": 0.67
  },
  {
   "i": 140,
   "verseId": 2768,
   "text": "ਤੁਝ ਬਿਨੁ ਦੂਜਾ ਕੋਈ ਨਾਹਿ ॥",
   "start": 24.84,
   "end": 27.4,
   "conf": -1.177,
   "check": 0.83
  },
  {
   "i": 141,
   "verseId": 2769,
   "text": "ਜੀਅ ਜੰਤ ਸਭਿ ਤੇਰਾ ਖੇਲੁ ॥",
   "start": 28.48,
   "end": 31.2,
   "conf": -0.678,
   "check": 0.87
  },
  {
   "i": 142,
   "verseId": 2770,
   "text": "ਵਿਜੋਗਿ ਮਿਲਿ ਵਿਛੁੜਿਆ ਸੰਜੋਗੀ ਮੇਲੁ ॥੨॥",
   "start": 31.96,
   "end": 35.68,
   "conf": -0.422,
   "check": 0.92
  },
  {
   "i": 143,
   "verseId": 2771,
   "text": "ਜਿਸ ਨੋ ਤੂ ਜਾਣਾਇਹਿ ਸੋਈ ਜਨੁ ਜਾਣੈ ॥",
   "start": 36.52,
   "end": 40.48,
   "conf": -0.931,
   "check": 0.65
  },
  {
   "i": 144,
   "verseId": 2772,
   "text": "ਹਰਿ ਗੁਣ ਸਦ ਹੀ ਆਖਿ ਵਖਾਣੈ ॥",
   "start": 41.4,
   "end": 44.12,
   "conf": -0.269,
   "check": 0.94
  },
  {
   "i": 145,
   "verseId": 2773,
   "text": "ਜਿਨਿ ਹਰਿ ਸੇਵਿਆ ਤਿਨਿ ਸੁਖੁ ਪਾਇਆ ॥",
   "start": 44.96,
   "end": 47.76,
   "conf": -0.182,
   "check": 0.91
  },
  {
   "i": 146,
   "verseId": 2774,
   "text": "ਸਹਜੇ ਹੀ ਹਰਿ ਨਾਮਿ ਸਮਾਇਆ ॥੩॥",
   "start": 48.68,
   "end": 51.32,
   "conf": -0.28,
   "check": 0.88
  },
  {
   "i": 147,
   "verseId": 2775,
   "text": "ਤੂ ਆਪੇ ਕਰਤਾ ਤੇਰਾ ਕੀਆ ਸਭੁ ਹੋਇ ॥",
   "start": 52.32,
   "end": 55.88,
   "conf": -0.185,
   "check": 0.95
  },
  {
   "i": 148,
   "verseId": 2776,
   "text": "ਤੁਧੁ ਬਿਨੁ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਇ ॥",
