  {
   "i": 5,
   "verseId": 1407,
   "text": "ਸਾਰੇ ਹੀ ਦੇਸ ਕੋ ਦੇਖਿ ਰਹਿਓ ਮਤ ਕੋਊ ਨ ਦੇਖੀਅਤ ਪ੍ਰਾਨਪਤੀ ਕੇ ॥",
   "start": 12.24,
   "end": 22.04,
   "conf": -1.394,
   "check": 0.8
  },
  {
   "i": 6,
   "verseId": 1408,
   "text": "ਸ੍ਰੀ ਭਗਵਾਨ ਕੀ ਭਾਇ ਕ੍ਰਿਪਾ ਹੂ ਤੇ ਏਕ ਰਤੀ ਬਿਨੁ ਏਕ ਰਤੀ ਕੇ ॥੧॥੨੧॥",
   "start": 22.88,
   "end": 30.64,
   "conf": -0.223,
   "check": 0.97
  },
  {
   "i": 7,
   "verseId": 1409,
   "text": "ਮਾਤੇ ਮਤੰਗ ਜਰੇ ਜਰ ਸੰਗ ਅਨੂਪ ਉਤੰਗ ਸੁਰੰਗ ਸਵਾਰੇ ॥",
   "start": 31.56,
   "end": 37.44,
   "conf": -0.182,
   "check": 0.94
  },
  {
   "i": 8,
   "verseId": 1410,
   "text": "ਕੋਟ ਤੁਰੰਗ ਕੁਰੰਗ ਸੇ ਕੂਦਤ ਪਉਨ ਕੇ ਗਉਨ ਕੋ ਜਾਤ ਨਿਵਾਰੇ ॥",
   "start": 38.4,
   "end": 44.6,
   "conf": -0.518,
   "check": 0.89
  },
  {
   "i": 9,
   "verseId": 1411,
   "text": "ਭਾਰੀ ਭੁਜਾਨ ਕੇ ਭੂਪ ਭਲੀ ਬਿਧਿ ਨਿਆਵਤ ਸੀਸ ਨ ਜਾਤ ਬਿਚਾਰੇ ॥",
   "start": 45.6,
   "end": 51.88,
   "conf": -0.706,
   "check": 0.81
  },
  {
   "i": 10,
   "verseId": 1412,
   "text": "ਏਤੇ ਭਏ ਤੁ ਕਹਾ ਭਏ ਭੂਪਤਿ ਅੰਤ ਕੋ ਨਾਂਗੇ ਹੀ ਪਾਂਇ ਪਧਾਰੇ ॥੨॥੨੨॥",
   "start": 52.8,
   "end": 60.2,
   "conf": -1.354,
   "check": 0.86
  },
  {
   "i": 11,
   "verseId": 1413,
   "text": "ਜੀਤ ਫਿਰੈ ਸਭ ਦੇਸ ਦਿਸਾਨ ਕੋ ਬਾਜਤ ਢੋਲ ਮ੍ਰਿਦੰਗ ਨਗਾਰੇ ॥",
   "start": 61.44,
   "end": 67.96,
   "conf": -0.935,
   "check": 0.87
  },
  {
   "i": 12,
   "verseId": 1414,
