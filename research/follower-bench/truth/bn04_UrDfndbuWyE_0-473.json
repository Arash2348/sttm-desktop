   "end": 247.28,
   "conf": -0.196,
   "check": 0.95
  },
  {
   "i": 62,
   "verseId": 3624,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੁ ਆਰਤੀ ਹੋਇ ॥੩॥",
