   "verseId": 3643,
   "text": "ਜਿਸਹਿ ਜਗਾਇ ਪੀਆਵੈ ਇਹੁ ਰਸੁ ਅਕਥ ਕਥਾ ਤਿਨਿ ਜਾਨੀ ॥੨॥",
   "start": 395.04,
   "end": 401.68,
   "conf": -0.684,
   "check": 0.91
  },
  {
