   "start": 346.2,
   "end": 354.24,
   "conf": -0.561,
   "check": 0.89
  },
  {
   "i": 76,
   "verseId": 3638,
   "text": "ਰਾਗੁ ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ੫ ॥",
   "start": 354.64,
   "end": 359.28,
   "conf": -1.543,
   "check": 0.94
  },
  {
   "i": 77,
   "verseId": 3639,
   "text": "ਕਰਉ ਬੇਨੰਤੀ ਸੁਣਹੁ ਮੇਰੇ ਮੀਤਾ ਸੰਤ ਟਹਲ ਕੀ ਬੇਲਾ ॥",
