   "start": 379.04,
   "end": 386.32,
   "conf": -0.392,
   "check": 0.89
  },
  {
   "i": 80,
   "verseId": 3642,
   "text": "ਇਹੁ ਸੰਸਾਰੁ ਬਿਕਾਰੁ ਸੰਸੇ ਮਹਿ ਤਰਿਓ ਬ੍ਰਹਮ ਗਿਆਨੀ ॥",
   "start": 387.04,
   "end": 393.56,
   "conf": -0.383,
   "check": 0.91
  },
  {
