   "verseId": 3644,
   "text": "ਜਾ ਕਉ ਆਏ ਸੋਈ ਬਿਹਾਝਹੁ ਹਰਿ ਗੁਰ ਤੇ ਮਨਹਿ ਬਸੇਰਾ ॥",
   "start": 403.12,
   "end": 409.76,
   "conf": -1.498,
   "check": 0.72
  },
  {
