  {
   "i": 32,
   "verseId": 3594,
   "text": "ਸੋਹਿਲਾ ਰਾਗੁ ਗਉੜੀ ਦੀਪਕੀ ਮਹਲਾ ੧",
   "start": 14.56,
   "end": 21.04,
   "conf": -1.283,
   "check": 0.87
  },
  {
   "i": 33,
   "verseId": 3595,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 22.52,
   "end": 27.24,
   "conf": -0.89,
   "check": 0.89
  },
  {
   "i": 34,
   "verseId": 3596,
   "text": "ਜੈ ਘਰਿ ਕੀਰਤਿ ਆਖੀਐ ਕਰਤੇ ਕਾ ਹੋਇ ਬੀਚਾਰੋ ॥",
   "start": 28.8,
   "end": 35.48,
   "conf": -1.416,
   "check": 0.9
  },
  {
   "i": 35,
   "verseId": 3597,
   "text": "ਤਿਤੁ ਘਰਿ ਗਾਵਹੁ ਸੋਹਿਲਾ ਸਿਵਰਿਹੁ ਸਿਰਜਣਹਾਰੋ ॥੧॥",
   "start": 36.84,
   "end": 43.56,
   "conf": -0.276,
   "check": 0.97
  },
  {
   "i": 36,
   "verseId": 3598,
   "text": "ਤੁਮ ਗਾਵਹੁ ਮੇਰੇ ਨਿਰਭਉ ਕਾ ਸੋਹਿਲਾ ॥",
   "start": 44.4,
   "end": 49.96,
   "conf": -1.183,
   "check": 0.83
  },
  {
   "i": 37,
   "verseId": 3599,
   "text": "ਹਉ ਵਾਰੀ ਜਿਤੁ ਸੋਹਿਲੈ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 52.96,
   "end": 61.04,
   "conf": -1.318,
   "check": 0.92
  },
  {
   "i": 38,
   "verseId": 3600,
   "text": "ਨਿਤ ਨਿਤ ਜੀਅੜੇ ਸਮਾਲੀਅਨਿ ਦੇਖੈਗਾ ਦੇਵਣਹਾਰੁ ॥",
   "start": 61.04,
   "end": 68.4,
   "conf": -0.597,
   "check": 0.94
  },
  {
   "i": 39,
   "verseId": 3601,
   "text": "ਤੇਰੇ ਦਾਨੈ ਕੀਮਤਿ ਨਾ ਪਵੈ ਤਿਸੁ ਦਾਤੇ ਕਵਣੁ ਸੁਮਾਰੁ ॥੨॥",
   "start": 68.56,
   "end": 76.36,
   "conf": -0.717,
   "check": 0.84
  },
  {
   "i": 40,
   "verseId": 3602,
   "text": "ਸੰਬਤਿ ਸਾਹਾ ਲਿਖਿਆ ਮਿਲਿ ਕਰਿ ਪਾਵਹੁ ਤੇਲੁ ॥",
   "start": 77.2,
   "end": 84.4,
   "conf": -0.966,
   "check": 0.86
  },
  {
   "i": 41,
   "verseId": 3603,
   "text": "ਦੇਹੁ ਸਜਣ ਅਸੀਸੜੀਆ ਜਿਉ ਹੋਵੈ ਸਾਹਿਬ ਸਿਉ ਮੇਲੁ ॥੩॥",
   "start": 85.24,
   "end": 92.16,
   "conf": -0.79,
   "check": 0.9
  },
  {
   "i": 42,
   "verseId": 3604,
   "text": "ਘਰਿ ਘਰਿ ਏਹੋ ਪਾਹੁਚਾ ਸਦੜੇ ਨਿਤ ਪਵੰਨਿ ॥",
   "start": 93.2,
   "end": 99.64,
   "conf": -1.802,
   "check": 0.8
  },
  {
   "i": 43,
   "verseId": 3605,
   "text": "ਸਦਣਹਾਰਾ ਸਿਮਰੀਐ ਨਾਨਕ ਸੇ ਦਿਹ ਆਵੰਨਿ ॥੪॥੧॥",
   "start": 101.32,
   "end": 107.72,
   "conf": -0.934,
   "check": 0.83
  },
  {
   "i": 44,
   "verseId": 3606,
   "text": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧ ॥",
   "start": 108.84,
   "end": 111.88,
   "conf": -3.444,
   "check": 0.67
  },
  {
   "i": 45,
   "verseId": 3607,
   "text": "ਛਿਅ ਘਰ ਛਿਅ ਗੁਰ ਛਿਅ ਉਪਦੇਸ ॥",
   "start": 113.32,
   "end": 116.84,
   "conf": -2.129,
   "check": 0.65
  },
  {
   "i": 46,
   "verseId": 3608,
   "text": "ਗੁਰੁ ਗੁਰੁ ਏਕੋ ਵੇਸ ਅਨੇਕ ॥੧॥",
   "start": 117.36,
   "end": 121.48,
   "conf": -2.912,
   "check": 0.79
  },
  {
   "i": 47,
   "verseId": 3609,
   "text": "ਬਾਬਾ ਜੈ ਘਰਿ ਕਰਤੇ ਕੀਰਤਿ ਹੋਇ ॥",
   "start": 121.48,
   "end": 126.52,
   "conf": -0.258,
   "check": 0.84
  },
  {
   "i": 48,
   "verseId": 3610,
   "text": "ਸੋ ਘਰੁ ਰਾਖੁ ਵਡਾਈ ਤੋਇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 129.4,
   "end": 136.88,
   "conf": -1.714,
   "check": 0.83
  },
  {
   "i": 49,
   "verseId": 3611,
   "text": "ਵਿਸੁਏ ਚਸਿਆ ਘੜੀਆ ਪਹਰਾ ਥਿਤੀ ਵਾਰੀ ਮਾਹੁ ਹੋਆ ॥",
   "start": 137.56,
   "end": 144.6,
   "conf": -0.544,
   "check": 0.87
  },
  {
   "i": 50,
   "verseId": 3612,
   "text": "ਸੂਰਜੁ ਏਕੋ ਰੁਤਿ ਅਨੇਕ ॥",
   "start": 145.64,
   "end": 150.56,
   "conf": -0.345,
   "check": 0.79
  },
  {
   "i": 51,
   "verseId": 3613,
   "text": "ਨਾਨਕ ਕਰਤੇ ਕੇ ਕੇਤੇ ਵੇਸ ॥੨॥੨॥",
   "start": 153.64,
   "end": 158.64,
   "conf": -0.784,
   "check": 0.88
  },
  {
   "i": 52,
   "verseId": 3614,
   "text": "ਰਾਗੁ ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
   "start": 161.2,
   "end": 164.24,
   "conf": -1.115,
   "check": 0.59
  },
  {
   "i": 53,
   "verseId": 3615,
   "text": "ਗਗਨ ਮੈ ਥਾਲੁ ਰਵਿ ਚੰਦੁ ਦੀਪਕ ਬਨੇ ਤਾਰਿਕਾ ਮੰਡਲ ਜਨਕ ਮੋਤੀ ॥",
   "start": 169.64,
   "end": 176.68,
   "conf": -0.654,
   "check": 0.81
  },
  {
   "i": 54,
   "verseId": 3616,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 177.6,
   "end": 184.76,
   "conf": -0.729,
   "check": 0.86
  },
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 185.88,
   "end": 198.92,
   "conf": -0.206,
   "check": 0.96
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 201.92,
   "end": 209.16,
   "conf": -0.657,
   "check": 0.88
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 209.96,
   "end": 216.92,
   "conf": -1.088,
   "check": 0.83
  },
  {
   "i": 58,
   "verseId": 3620,
