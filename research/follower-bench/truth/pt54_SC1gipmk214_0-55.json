   "conf": -0.876,
   "check": 0.67
  },
  {
   "i": 2,
   "verseId": 14,
   "text": "ਆਦਿ ਸਚੁ ਜੁਗਾਦਿ ਸਚੁ ॥",
   "start": 17.04,
   "end": 19.04,
   "conf": -0.127,
   "check": 1
  },
  {
   "i": 3,
   "verseId": 15,
   "text": "ਹੈ ਭੀ ਸਚੁ ਨਾਨਕ ਹੋਸੀ ਭੀ ਸਚੁ ॥੧॥",
   "start": 19.44,
   "end": 23.12,
   "conf": -0.233,
   "check": 0.9
  },
  {
   "i": 4,
   "verseId": 16,
   "text": "ਸੋਚੈ ਸੋਚਿ ਨ ਹੋਵਈ ਜੇ ਸੋਚੀ ਲਖ ਵਾਰ ॥",
   "start": 24.04,
   "end": 26.84,
   "conf": -0.634,
   "check": 0.83
  },
  {
   "i": 5,
   "verseId": 17,
   "text": "ਚੁਪੈ ਚੁਪ ਨ ਹੋਵਈ ਜੇ ਲਾਇ ਰਹਾ ਲਿਵ ਤਾਰ ॥",
   "start": 27.24,
   "end": 30.12,
   "conf": -1.335,
   "check": 0.82
  },
  {
   "i": 6,
   "verseId": 18,
   "text": "ਭੁਖਿਆ ਭੁਖ ਨ ਉਤਰੀ ਜੇ ਬੰਨਾ ਪੁਰੀਆ ਭਾਰ ॥",
   "start": 30.56,
   "end": 33.88,
   "conf": -0.834,
   "check": 0.85
  },
  {
   "i": 7,
   "verseId": 19,
   "text": "ਸਹਸ ਸਿਆਣਪਾ ਲਖ ਹੋਹਿ ਤ ਇਕ ਨ ਚਲੈ ਨਾਲਿ ॥",
   "start": 34.32,
   "end": 38.04,
   "conf": -1.874,
   "check": 0.84
  },
  {
   "i": 8,
   "verseId": 20,
   "text": "ਕਿਵ ਸਚਿਆਰਾ ਹੋਈਐ ਕਿਵ ਕੂੜੈ ਤੁਟੈ ਪਾਲਿ ॥",
   "start": 38.32,
   "end": 41.96,
   "conf": -0.299,
   "check": 0.89
  },
  {
   "i": 9,
   "verseId": 21,
   "text": "ਹੁਕਮਿ ਰਜਾਈ ਚਲਣਾ ਨਾਨਕ ਲਿਖਿਆ ਨਾਲਿ ॥੧॥",
   "start": 42.36,
   "end": 45.8,
   "conf": -0.408,
   "check": 0.88
  },
  {
   "i": 10,
   "verseId": 22,
   "text": "ਹੁਕਮੀ ਹੋਵਨਿ ਆਕਾਰ ਹੁਕਮੁ ਨ ਕਹਿਆ ਜਾਈ ॥",
   "start": 46.28,
   "end": 49.84,
   "conf": -0.994,
   "check": 0.79
  },
  {
