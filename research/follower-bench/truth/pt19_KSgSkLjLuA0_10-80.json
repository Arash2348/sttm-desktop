 "lines": [
  {
   "i": 12,
   "verseId": 2640,
   "text": "ਦੁਖੁ ਦਾਰੂ ਸੁਖੁ ਰੋਗੁ ਭਇਆ ਜਾ ਸੁਖੁ ਤਾਮਿ ਨ ਹੋਈ ॥",
   "start": 0.24,
   "end": 4.8,
   "conf": -0.371,
   "check": 0.92
  },
  {
   "i": 13,
   "verseId": 2641,
   "text": "ਤੂੰ ਕਰਤਾ ਕਰਣਾ ਮੈ ਨਾਹੀ ਜਾ ਹਉ ਕਰੀ ਨ ਹੋਈ ॥੧॥",
   "start": 6,
   "end": 11.72,
   "conf": -0.692,
   "check": 0.87
  },
  {
   "i": 14,
   "verseId": 2642,
   "text": "ਬਲਿਹਾਰੀ ਕੁਦਰਤਿ ਵਸਿਆ ॥",
   "start": 13.12,
   "end": 15.64,
   "conf": -0.127,
   "check": 1
  },
  {
   "i": 15,
   "verseId": 2643,
   "text": "ਤੇਰਾ ਅੰਤੁ ਨ ਜਾਈ ਲਖਿਆ ॥੧॥ ਰਹਾਉ ॥",
   "start": 16.72,
   "end": 20.64,
   "conf": -0.94,
   "check": 0.89
  },
  {
   "i": 16,
   "verseId": 2644,
   "text": "ਜਾਤਿ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਮਹਿ ਜਾਤਾ ਅਕਲ ਕਲਾ ਭਰਪੂਰਿ ਰਹਿਆ ॥",
   "start": 21.76,
   "end": 28.04,
   "conf": -0.209,
   "check": 0.94
  },
  {
   "i": 17,
   "verseId": 2645,
   "text": "ਤੂੰ ਸਚਾ ਸਾਹਿਬੁ ਸਿਫਤਿ ਸੁਆਲਿੑਉ ਜਿਨਿ ਕੀਤੀ ਸੋ ਪਾਰਿ ਪਇਆ ॥",
   "start": 29.04,
   "end": 35.76,
   "conf": -1.105,
   "check": 0.87
  },
  {
   "i": 18,
   "verseId": 2646,
   "text": "ਕਹੁ ਨਾਨਕ ਕਰਤੇ ਕੀਆ ਬਾਤਾ ਜੋ ਕਿਛੁ ਕਰਣਾ ਸੁ ਕਰਿ ਰਹਿਆ ॥੨॥",
   "start": 36.92,
   "end": 45,
   "conf": -0.268,
   "check": 0.97
  },
  {
   "i": 20,
   "verseId": 2648,
   "text": "ਸੋ ਦਰੁ ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧",
   "start": 47.36,
   "end": 50.64,
   "conf": -0.587,
   "check": 0.87
  },
  {
   "i": 21,
   "verseId": 2649,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 52.04,
   "end": 57.12,
   "conf": -0.564,
   "check": 0.95
  },
  {
   "i": 22,
   "verseId": 2650,
   "text": "ਸੋ ਦਰੁ ਤੇਰਾ ਕੇਹਾ ਸੋ ਘਰੁ ਕੇਹਾ ਜਿਤੁ ਬਹਿ ਸਰਬ ਸਮਾਲੇ ॥",
   "start": 58.12,
   "end": 65.08,
   "conf": -0.294,
   "check": 0.97
