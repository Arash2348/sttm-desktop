 "lines": [
  {
   "i": 196,
   "verseId": 1979,
   "text": "ਵਜਾਇਆ ਵਾਜਾ ਪਉਣ ਨਉ ਦੁਆਰੇ ਪਰਗਟੁ ਕੀਏ ਦਸਵਾ ਗੁਪਤੁ ਰਖਾਇਆ ॥",
   "start": 0.08,
   "end": 4.72,
   "conf": -0.382,
   "check": 0.85
  },
  {
   "i": 197,
   "verseId": 1980,
   "text": "ਗੁਰਦੁਆਰੈ ਲਾਇ ਭਾਵਨੀ ਇਕਨਾ ਦਸਵਾ ਦੁਆਰੁ ਦਿਖਾਇਆ ॥",
   "start": 6.04,
   "end": 11.88,
   "conf": -0.621,
   "check": 0.84
  },
  {
   "i": 198,
   "verseId": 1981,
   "text": "ਤਹ ਅਨੇਕ ਰੂਪ ਨਾਉ ਨਵ ਨਿਧਿ ਤਿਸ ਦਾ ਅੰਤੁ ਨ ਜਾਈ ਪਾਇਆ ॥",
   "start": 12.72,
   "end": 19.08,
   "conf": -0.36,
   "check": 0.94
  },
  {
   "i": 199,
   "verseId": 1982,
   "text": "ਕਹੈ ਨਾਨਕੁ ਹਰਿ ਪਿਆਰੈ ਜੀਉ ਗੁਫਾ ਅੰਦਰਿ ਰਖਿ ਕੈ ਵਾਜਾ ਪਵਣੁ ਵਜਾਇਆ ॥੩੮॥",
   "start": 19.96,
   "end": 28.48,
   "conf": -0.462,
   "check": 0.89
  },
  {
   "i": 200,
   "verseId": 1983,
   "text": "ਏਹੁ ਸਾਚਾ ਸੋਹਿਲਾ ਸਾਚੈ ਘਰਿ ਗਾਵਹੁ ॥",
   "start": 29.2,
   "end": 33.4,
   "conf": -0.324,
   "check": 0.96
  },
  {
   "i": 201,
   "verseId": 1984,
   "text": "ਗਾਵਹੁ ਤ ਸੋਹਿਲਾ ਘਰਿ ਸਾਚੈ ਜਿਥੈ ਸਦਾ ਸਚੁ ਧਿਆਵਹੇ ॥",
   "start": 34.32,
   "end": 39.96,
   "conf": -0.35,
   "check": 0.97
  },
  {
   "i": 202,
   "verseId": 1985,
   "text": "ਸਚੋ ਧਿਆਵਹਿ ਜਾ ਤੁਧੁ ਭਾਵਹਿ ਗੁਰਮੁਖਿ ਜਿਨਾ ਬੁਝਾਵਹੇ ॥",
   "start": 40.8,
   "end": 46.24,
   "conf": -0.584,
   "check": 0.84
  },
  {
   "i": 203,
   "verseId": 1986,
   "text": "ਇਹੁ ਸਚੁ ਸਭਨਾ ਕਾ ਖਸਮੁ ਹੈ ਜਿਸੁ ਬਖਸੇ ਸੋ ਜਨੁ ਪਾਵਹੇ ॥",
   "start": 47.12,
   "end": 52.64,
   "conf": -0.539,
   "check": 0.91
  },
  {
   "i": 204,
   "verseId": 1987,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸਚੁ ਸੋਹਿਲਾ ਸਚੈ ਘਰਿ ਗਾਵਹੇ ॥੩੯॥",
   "start": 53.44,
   "end": 58.12,
   "conf": -0.707,
   "check": 0.88
  },
  {
   "i": 205,
   "verseId": 1988,
   "text": "ਅਨਦੁ ਸੁਣਹੁ ਵਡਭਾਗੀਹੋ ਸਗਲ ਮਨੋਰਥ ਪੂਰੇ ॥",
   "start": 59.24,
   "end": 63.92,
   "conf": -0.419,
   "check": 0.89
  },
  {
   "i": 206,
   "verseId": 1989,
   "text": "ਪਾਰਬ੍ਰਹਮੁ ਪ੍ਰਭੁ ਪਾਇਆ ਉਤਰੇ ਸਗਲ ਵਿਸੂਰੇ ॥",
   "start": 64.96,
   "end": 69.76,
   "conf": -0.301,
   "check": 0.93
  }
