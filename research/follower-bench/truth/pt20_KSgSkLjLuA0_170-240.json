 "lines": [
  {
   "i": 35,
   "verseId": 2663,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਖੰਡ ਮੰਡਲ ਬ੍ਰਹਮੰਡਾ ਕਰਿ ਕਰਿ ਰਖੇ ਤੇਰੇ ਧਾਰੇ ॥",
   "start": 0.56,
   "end": 3.04,
   "conf": -0.122,
   "check": 0.67
  },
  {
   "i": 36,
   "verseId": 2664,
   "text": "ਸੇਈ ਤੁਧਨੋ ਗਾਵਨਿ ਜੋ ਤੁਧੁ ਭਾਵਨਿ ਰਤੇ ਤੇਰੇ ਭਗਤ ਰਸਾਲੇ ॥",
   "start": 4.32,
   "end": 12.24,
   "conf": -0.64,
   "check": 0.89
  },
  {
   "i": 37,
   "verseId": 2665,
   "text": "ਹੋਰਿ ਕੇਤੇ ਤੁਧਨੋ ਗਾਵਨਿ ਸੇ ਮੈ ਚਿਤਿ ਨ ਆਵਨਿ ਨਾਨਕੁ ਕਿਆ ਬੀਚਾਰੇ ॥",
   "start": 13.28,
   "end": 21.64,
   "conf": -0.616,
   "check": 0.85
  },
  {
   "i": 38,
   "verseId": 2666,
   "text": "ਸੋਈ ਸੋਈ ਸਦਾ ਸਚੁ ਸਾਹਿਬੁ ਸਾਚਾ ਸਾਚੀ ਨਾਈ ॥",
   "start": 22.96,
   "end": 29.24,
   "conf": -0.528,
   "check": 0.96
  },
  {
   "i": 39,
   "verseId": 2667,
   "text": "ਹੈ ਭੀ ਹੋਸੀ ਜਾਇ ਨ ਜਾਸੀ ਰਚਨਾ ਜਿਨਿ ਰਚਾਈ ॥",
   "start": 30.04,
   "end": 35.28,
   "conf": -0.786,
   "check": 0.71
  },
  {
   "i": 40,
   "verseId": 2668,
   "text": "ਰੰਗੀ ਰੰਗੀ ਭਾਤੀ ਕਰਿ ਕਰਿ ਜਿਨਸੀ ਮਾਇਆ ਜਿਨਿ ਉਪਾਈ ॥",
   "start": 36.76,
   "end": 42.04,
   "conf": -0.855,
   "check": 0.85
  },
  {
   "i": 41,
   "verseId": 2669,
   "text": "ਕਰਿ ਕਰਿ ਦੇਖੈ ਕੀਤਾ ਆਪਣਾ ਜਿਉ ਤਿਸ ਦੀ ਵਡਿਆਈ ॥",
   "start": 43,
   "end": 48.48,
   "conf": -0.257,
   "check": 0.97
  },
  {
   "i": 42,
   "verseId": 2670,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋਈ ਕਰਸੀ ਫਿਰਿ ਹੁਕਮੁ ਨ ਕਰਣਾ ਜਾਈ ॥",
   "start": 49.68,
   "end": 55.4,
   "conf": -0.078,
   "check": 1
  },
  {
   "i": 43,
   "verseId": 2671,
   "text": "ਸੋ ਪਾਤਿਸਾਹੁ ਸਾਹਾ ਪਤਿਸਾਹਿਬੁ ਨਾਨਕ ਰਹਣੁ ਰਜਾਈ ॥੧॥",
   "start": 56.52,
   "end": 63.52,
   "conf": -1.57,
   "check": 0.88
  },
  {
   "i": 44,
   "verseId": 2672,
   "text": "ਆਸਾ ਮਹਲਾ ੧ ॥",
   "start": 64.76,
   "end": 66.56,
   "conf": -0.768,
   "check": 0.97
  },
  {
   "i": 45,
   "verseId": 2673,
   "text": "ਸੁਣਿ ਵਡਾ ਆਖੈ ਸਭੁ ਕੋਇ ॥",
   "start": 67.92,
   "end": 69.92,
   "conf": -0.823,
   "check": 0.93
  }
