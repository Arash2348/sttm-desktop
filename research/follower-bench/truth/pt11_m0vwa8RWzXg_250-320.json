   "end": 10.72,
   "conf": -0.32,
   "check": 0.88
  },
  {
   "i": 113,
   "verseId": 1694,
   "text": "ਕਿਹ ਬਿਧਿ ਸਜਾ ਪ੍ਰਥਮ ਸੰਸਾਰਾ ॥੩੯੩॥",
