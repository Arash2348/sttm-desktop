   "end": 3.8,
   "conf": -0.655,
   "check": 0.88
  },
  {
   "i": 111,
   "verseId": 1692,
   "text": "ਬਰਨਤ ਭਿੰਨ ਭਿੰਨ ਤੁਹਿ ਤੇਤੀ ॥",
   "start": 4.76,
   "end": 7.16,
   "conf": -0.548,
   "check": 0.79
  },
  {
   "i": 112,
   "verseId": 1693,
   "text": "ਤੁਮਰਾ ਲਖਾ ਨ ਜਾਇ ਪਸਾਰਾ ॥",
