   "start": 28.6,
   "end": 31.16,
   "conf": -1.55,
   "check": 0.69
  },
  {
   "i": 119,
   "verseId": 1700,
   "text": "ਕਹੂੰ ਸਿਮਟਿ ਭ੍ਯਿੋ ਸੰਕਰ ਇਕੈਠਾ ॥",
