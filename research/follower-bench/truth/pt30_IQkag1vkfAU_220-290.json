 "lines": [
  {
   "i": 73,
   "verseId": 3635,
   "text": "ਅਬਿਨਾਸੀ ਪੁਰਖੁ ਪਾਇਆ ਪਰਮੇਸਰੁ ਬਹੁ ਸੋਭ ਖੰਡ ਬ੍ਰਹਮੰਡਾ ਹੇ ॥੩॥",
   "start": 0.4,
   "end": 5.92,
   "conf": -1.287,
   "check": 0.83
  },
  {
   "i": 74,
   "verseId": 3636,
   "text": "ਹਮ ਗਰੀਬ ਮਸਕੀਨ ਪ੍ਰਭ ਤੇਰੇ ਹਰਿ ਰਾਖੁ ਰਾਖੁ ਵਡ ਵਡਾ ਹੇ ॥",
   "start": 5.92,
   "end": 13,
   "conf": -2.413,
   "check": 0.18
  },
  {
   "i": 75,
   "verseId": 3637,
   "text": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਅਧਾਰੁ ਟੇਕ ਹੈ ਹਰਿ ਨਾਮੇ ਹੀ ਸੁਖੁ ਮੰਡਾ ਹੇ ॥੪॥੪॥",
   "start": 13.64,
   "end": 20.48,
   "conf": -0.536,
   "check": 0.92
  },
  {
   "i": 76,
   "verseId": 3638,
   "text": "ਰਾਗੁ ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ੫ ॥",
   "start": 20.8,
   "end": 24.08,
   "conf": -0.474,
   "check": 0.95
  },
  {
   "i": 77,
   "verseId": 3639,
   "text": "ਕਰਉ ਬੇਨੰਤੀ ਸੁਣਹੁ ਮੇਰੇ ਮੀਤਾ ਸੰਤ ਟਹਲ ਕੀ ਬੇਲਾ ॥",
   "start": 25.04,
   "end": 30.4,
   "conf": -0.433,
   "check": 0.91
  },
  {
   "i": 78,
   "verseId": 3640,
   "text": "ਈਹਾ ਖਾਟਿ ਚਲਹੁ ਹਰਿ ਲਾਹਾ ਆਗੈ ਬਸਨੁ ਸੁਹੇਲਾ ॥੧॥",
   "start": 31.24,
   "end": 36.36,
   "conf": -0.621,
   "check": 0.74
  },
  {
   "i": 79,
   "verseId": 3641,
   "text": "ਅਉਧ ਘਟੈ ਦਿਨਸੁ ਰੈਣਾਰੇ ॥ ਮਨ ਗੁਰ ਮਿਲਿ ਕਾਜ ਸਵਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 37.2,
   "end": 44.32,
   "conf": -0.291,
   "check": 0.94
  },
  {
   "i": 80,
   "verseId": 3642,
   "text": "ਇਹੁ ਸੰਸਾਰੁ ਬਿਕਾਰੁ ਸੰਸੇ ਮਹਿ ਤਰਿਓ ਬ੍ਰਹਮ ਗਿਆਨੀ ॥",
   "start": 45.16,
   "end": 50.96,
   "conf": -0.42,
   "check": 0.91
  },
  {
   "i": 81,
   "verseId": 3643,
   "text": "ਜਿਸਹਿ ਜਗਾਇ ਪੀਆਵੈ ਇਹੁ ਰਸੁ ਅਕਥ ਕਥਾ ਤਿਨਿ ਜਾਨੀ ॥੨॥",
   "start": 51.84,
   "end": 58,
   "conf": -0.407,
   "check": 0.85
  },
  {
   "i": 82,
   "verseId": 3644,
   "text": "ਜਾ ਕਉ ਆਏ ਸੋਈ ਬਿਹਾਝਹੁ ਹਰਿ ਗੁਰ ਤੇ ਮਨਹਿ ਬਸੇਰਾ ॥",
   "start": 58.88,
   "end": 64.56,
   "conf": -0.443,
   "check": 0.88
  },
  {
   "i": 83,
   "verseId": 3645,
   "text": "ਨਿਜ ਘਰਿ ਮਹਲੁ ਪਾਵਹੁ ਸੁਖ ਸਹਜੇ ਬਹੁਰਿ ਨ ਹੋਇਗੋ ਫੇਰਾ ॥੩॥",
   "start": 65.48,
   "end": 69.76,
   "conf": -0.544,
   "check": 0.9
  }
