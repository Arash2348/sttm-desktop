 "lines": [
  {
   "i": 98,
   "verseId": 3389,
   "text": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ਆਰਤੀ",
   "start": 4.76,
   "end": 9.04,
   "conf": -0.596,
   "check": 0.89
  },
  {
   "i": 99,
   "verseId": 3390,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 10.72,
   "end": 18.4,
   "conf": -1.656,
   "check": 0.83
  },
  {
   "i": 100,
   "verseId": 3391,
   "text": "ਗਗਨ ਮੈ ਥਾਲੁ ਰਵਿ ਚੰਦੁ ਦੀਪਕ ਬਨੇ ਤਾਰਿਕਾ ਮੰਡਲ ਜਨਕ ਮੋਤੀ ॥",
   "start": 20.4,
   "end": 29.24,
   "conf": -1.451,
   "check": 0.79
  },
  {
   "i": 101,
   "verseId": 3392,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 32.84,
   "end": 41.76,
   "conf": -0.988,
   "check": 0.83
  },
  {
   "i": 102,
   "verseId": 3393,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 44.96,
   "end": 49.92,
   "conf": -0.039,
   "check": 1
  },
  {
   "i": 103,
   "verseId": 3394,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 50.72,
   "end": 57.08,
   "conf": -1.489,
   "check": 0.88
  },
  {
   "i": 104,
   "verseId": 3395,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹੈ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋਹੀ ॥",
   "start": 57.6,
   "end": 66.72,
   "conf": -0.734,
   "check": 0.82
  },
  {
   "i": 105,
   "verseId": 3396,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 70.08,
   "end": 79.24,
   "conf": -0.292,
   "check": 0.92
  },
  {
   "i": 106,
   "verseId": 3397,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 82.92,
   "end": 87.04,
   "conf": -0.028,
   "check": 1
  },
  {
   "i": 107,
   "verseId": 3398,
   "text": "ਤਿਸ ਕੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 87.48,
   "end": 92.4,
   "conf": -0.495,
   "check": 0.83
  },
  {
   "i": 108,
   "verseId": 3399,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
   "start": 95.72,
   "end": 99.88,
   "conf": -0.035,
   "check": 1
  },
  {
   "i": 109,
   "verseId": 3400,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੁ ਆਰਤੀ ਹੋਇ ॥੩॥",
   "start": 100.8,
   "end": 104.92,
   "conf": -0.561,
   "check": 0.95
  },
  {
   "i": 110,
   "verseId": 3401,
   "text": "ਹਰਿ ਚਰਣ ਕਮਲ ਮਕਰੰਦ ਲੋਭਿਤ ਮਨੋ ਅਨਦਿਨੋ ਮੋਹਿ ਆਹੀ ਪਿਆਸਾ ॥",
   "start": 107.32,
   "end": 116.84,
   "conf": -0.832,
   "check": 0.9
  },
  {
   "i": 111,
   "verseId": 3402,
   "text": "ਕ੍ਰਿਪਾ ਜਲੁ ਦੇਹਿ ਨਾਨਕ ਸਾਰਿੰਗ ਕਉ ਹੋਇ ਜਾ ਤੇ ਤੇਰੈ ਨਾਮਿ ਵਾਸਾ ॥੪॥੧॥੭॥੯॥",
   "start": 120.4,
   "end": 129.4,
   "conf": -0.98,
   "check": 0.9
  },
  {
   "i": 112,
   "verseId": 3404,
   "text": "ਨਾਮੁ ਤੇਰੋ ਆਰਤੀ ਮਜਨੁ ਮੁਰਾਰੇ ॥",
   "start": 132.96,
   "end": 137.04,
   "conf": -0.688,
   "check": 0.81
  },
  {
   "i": 113,
   "verseId": 3405,
   "text": "ਹਰਿ ਕੇ ਨਾਮ ਬਿਨੁ ਝੂਠੇ ਸਗਲ ਪਾਸਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 137.56,
   "end": 145.12,
   "conf": -0.882,
   "check": 1
  },
  {
   "i": 114,
   "verseId": 3406,
   "text": "ਨਾਮੁ ਤੇਰੋ ਆਸਨੋ ਨਾਮੁ ਤੇਰੋ ਉਰਸਾ ਨਾਮੁ ਤੇਰਾ ਕੇਸਰੋ ਲੇ ਛਿਟਕਾਰੇ ॥",
   "start": 145.44,
   "end": 154.84,
   "conf": -0.766,
   "check": 0.91
  },
  {
   "i": 115,
   "verseId": 3407,
   "text": "ਨਾਮੁ ਤੇਰਾ ਅੰਭੁਲਾ ਨਾਮੁ ਤੇਰੋ ਚੰਦਨੋ ਘਸਿ ਜਪੇ ਨਾਮੁ ਲੇ ਤੁਝਹਿ ਕਉ ਚਾਰੇ ॥੧॥",
   "start": 157.96,
   "end": 167.36,
   "conf": -0.848,
   "check": 0.8
  },
  {
   "i": 116,
   "verseId": 3408,
   "text": "ਨਾਮੁ ਤੇਰਾ ਦੀਵਾ ਨਾਮੁ ਤੇਰੋ ਬਾਤੀ ਨਾਮੁ ਤੇਰੋ ਤੇਲੁ ਲੇ ਮਾਹਿ ਪਸਾਰੇ ॥",
   "start": 170.48,
   "end": 179.88,
   "conf": -1.865,
   "check": 0.87
  },
  {
   "i": 117,
   "verseId": 3409,
   "text": "ਨਾਮ ਤੇਰੇ ਕੀ ਜੋਤਿ ਲਗਾਈ ਭਇਓ ਉਜਿਆਰੋ ਭਵਨ ਸਗਲਾਰੇ ॥੨॥",
   "start": 182.96,
   "end": 192.36,
   "conf": -0.099,
   "check": 0.94
  },
  {
   "i": 118,
   "verseId": 3410,
   "text": "ਨਾਮੁ ਤੇਰੋ ਤਾਗਾ ਨਾਮੁ ਫੂਲ ਮਾਲਾ ਭਾਰ ਅਠਾਰਹ ਸਗਲ ਜੂਠਾਰੇ ॥",
   "start": 195.44,
   "end": 204.92,
   "conf": -0.434,
   "check": 0.9
  },
  {
   "i": 119,
   "verseId": 3411,
   "text": "ਤੇਰੋ ਕੀਆ ਤੁਝਹਿ ਕਿਆ ਅਰਪਉ ਨਾਮੁ ਤੇਰਾ ਤੁਹੀ ਚਵਰ ਢੋਲਾਰੇ ॥੩॥",
   "start": 208.24,
   "end": 217.36,
   "conf": -0.359,
   "check": 0.9
  },
  {
   "i": 120,
   "verseId": 3412,
   "text": "ਦਸ ਅਠਾ ਅਠਸਠੇ ਚਾਰੇ ਖਾਣੀ ਇਹੈ ਵਰਤਣਿ ਹੈ ਸਗਲ ਸੰਸਾਰੇ ॥",
   "start": 220.68,
   "end": 229.88,
   "conf": -0.612,
   "check": 0.89
  },
  {
   "i": 121,
   "verseId": 3413,
