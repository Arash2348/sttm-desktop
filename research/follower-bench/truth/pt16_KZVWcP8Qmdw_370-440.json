 "lines": [
  {
   "i": 61,
   "verseId": 1844,
   "text": "ਅਗਮ ਅਗੋਚਰਾ ਤੇਰਾ ਅੰਤੁ ਨ ਪਾਇਆ ॥",
   "start": 0,
   "end": 3.96,
   "conf": -0.991,
   "check": 0.95
  },
  {
   "i": 62,
   "verseId": 1845,
   "text": "ਅੰਤੋ ਨ ਪਾਇਆ ਕਿਨੈ ਤੇਰਾ ਆਪਣਾ ਆਪੁ ਤੂ ਜਾਣਹੇ ॥",
   "start": 4.84,
   "end": 10.68,
   "conf": -0.66,
   "check": 0.87
  },
  {
   "i": 63,
   "verseId": 1846,
   "text": "ਜੀਅ ਜੰਤ ਸਭਿ ਖੇਲੁ ਤੇਰਾ ਕਿਆ ਕੋ ਆਖਿ ਵਖਾਣਏ ॥",
   "start": 11.52,
   "end": 16.76,
   "conf": -0.652,
   "check": 0.86
  },
  {
   "i": 64,
   "verseId": 1847,
   "text": "ਆਖਹਿ ਤ ਵੇਖਹਿ ਸਭੁ ਤੂਹੈ ਜਿਨਿ ਜਗਤੁ ਉਪਾਇਆ ॥",
   "start": 17.6,
   "end": 22.72,
   "conf": -0.398,
   "check": 0.79
  },
  {
   "i": 65,
   "verseId": 1848,
   "text": "ਕਹੈ ਨਾਨਕੁ ਤੂ ਸਦਾ ਅਗੰਮੁ ਹੈ ਤੇਰਾ ਅੰਤੁ ਨ ਪਾਇਆ ॥੧੨॥",
   "start": 23.64,
   "end": 29.6,
   "conf": -0.346,
   "check": 0.97
  },
  {
   "i": 66,
   "verseId": 1849,
   "text": "ਸੁਰਿ ਨਰ ਮੁਨਿ ਜਨ ਅੰਮ੍ਰਿਤੁ ਖੋਜਦੇ ਸੁ ਅੰਮ੍ਰਿਤੁ ਗੁਰ ਤੇ ਪਾਇਆ ॥",
   "start": 30.8,
   "end": 37.08,
   "conf": -0.24,
   "check": 0.93
  },
  {
   "i": 67,
   "verseId": 1850,
   "text": "ਪਾਇਆ ਅੰਮ੍ਰਿਤੁ ਗੁਰਿ ਕ੍ਰਿਪਾ ਕੀਨੀ ਸਚਾ ਮਨਿ ਵਸਾਇਆ ॥",
   "start": 38.12,
   "end": 44.32,
   "conf": -0.137,
   "check": 0.91
  },
  {
   "i": 68,
   "verseId": 1851,
   "text": "ਜੀਅ ਜੰਤ ਸਭਿ ਤੁਧੁ ਉਪਾਏ ਇਕਿ ਵੇਖਿ ਪਰਸਣਿ ਆਇਆ ॥",
   "start": 45.36,
   "end": 50.72,
   "conf": -0.423,
   "check": 0.83
  },
  {
   "i": 69,
   "verseId": 1852,
   "text": "ਲਬੁ ਲੋਭੁ ਅਹੰਕਾਰੁ ਚੂਕਾ ਸਤਿਗੁਰੂ ਭਲਾ ਭਾਇਆ ॥",
   "start": 51.64,
   "end": 57.28,
   "conf": -0.748,
   "check": 0.87
  },
  {
   "i": 70,
   "verseId": 1853,
   "text": "ਕਹੈ ਨਾਨਕੁ ਜਿਸ ਨੋ ਆਪਿ ਤੁਠਾ ਤਿਨਿ ਅੰਮ੍ਰਿਤੁ ਗੁਰ ਤੇ ਪਾਇਆ ॥੧੩॥",
   "start": 58.24,
   "end": 64.44,
   "conf": -0.171,
   "check": 0.95
  },
  {
   "i": 71,
   "verseId": 1854,
   "text": "ਭਗਤਾ ਕੀ ਚਾਲ ਨਿਰਾਲੀ ॥",
   "start": 65.32,
   "end": 67.68,
   "conf": -0.174,
   "check": 0.93
  },
  {
   "i": 72,
   "verseId": 1855,
   "text": "ਚਾਲਾ ਨਿਰਾਲੀ ਭਗਤਾਹ ਕੇਰੀ ਬਿਖਮ ਮਾਰਗਿ ਚਲਣਾ ॥",
   "start": 68.68,
   "end": 69.76,
   "conf": -0.293,
   "check": 0.57
  }
