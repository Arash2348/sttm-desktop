 "lines": [
  {
   "i": 17,
   "verseId": 1419,
   "text": "ਪਉਨ ਅਹਾਰ ਜਤੀ ਜਤ ਧਾਰ ਸਬੈ ਸੁ ਬਿਚਾਰ ਹਜਾਰ ਕ ਦੇਖੈ ॥",
   "start": 0.88,
   "end": 3.8,
   "conf": -0.898,
   "check": 0.83
  },
  {
   "i": 18,
   "verseId": 1420,
   "text": "ਸ੍ਰੀ ਭਗਵਾਨ ਭਜੇ ਬਿਨੁ ਭੂਪਤਿ ਏਕ ਰਤੀ ਬਿਨੁ ਏਕ ਨ ਲੇਖੈ ॥੪॥੨੪॥",
   "start": 4.76,
   "end": 12.68,
   "conf": -0.375,
   "check": 0.95
  },
  {
   "i": 19,
   "verseId": 1421,
   "text": "ਸੱੁਧ ਸਿਪਾਹ ਦੁਰੰਤ ਦੁਬਾਹ ਸੁ ਸਾਜ ਸਨਾਹ ਦੁਰਜਾਨ ਦਲੈਂਗੇ ॥",
   "start": 14.4,
   "end": 20.84,
   "conf": -1.724,
   "check": 0.88
  },
  {
   "i": 20,
   "verseId": 1422,
   "text": "ਭਾਰੀ ਗੁਮਾਨ ਭਰੇ ਮਨ ਮੈਂ ਕਰ ਪਰਬਤ ਪੰਖ ਹਲੇ ਨ ਹਲੈਂਗੇ ॥",
   "start": 21.76,
   "end": 28.12,
   "conf": -0.946,
   "check": 0.74
  },
  {
   "i": 21,
   "verseId": 1423,
   "text": "ਤੋਰਿ ਅਰੀਨ ਮਰੋਰਿ ਮਵਾਸਨ ਮਾਤੇ ਮਤੰਗਨ ਮਾਨ ਮਲੈਂਗੇ ॥",
   "start": 28.96,
   "end": 35.2,
   "conf": -0.616,
   "check": 0.88
  },
  {
   "i": 22,
   "verseId": 1424,
   "text": "ਸ੍ਰੀ ਪਤਿ ਸ੍ਰੀ ਭਗਵਾਨ ਕ੍ਰਿਪਾ ਬਿਨੁ ਤਿਆਗਿ ਜਹਾਨ ਨਿਦਾਨ ਚਲੈਂਗੇ ॥੫॥੨੫॥",
   "start": 36.04,
   "end": 43.72,
   "conf": -0.367,
   "check": 0.93
  },
  {
   "i": 23,
   "verseId": 1425,
   "text": "ਬੀਰ ਅਪਾਰ ਬਡੇ ਬਰਿਆਰ ਅਬਿਚਾਰਹਿ ਸਾਰ ਕੀ ਧਾਰ ਭਛੱਯਾ ॥",
   "start": 44.72,
   "end": 51.84,
   "conf": -1.569,
   "check": 0.73
  },
  {
   "i": 24,
   "verseId": 1426,
   "text": "ਤੋਰਤ ਦੇਸ ਮਲਿੰਦ ਮਵਾਸਨ ਮਾਤੇ ਗਜਾਨ ਕੇ ਮਾਨ ਮਲੱਯਾ ॥",
   "start": 52.24,
   "end": 59.16,
   "conf": -1.439,
   "check": 0.9
  },
  {
   "i": 25,
   "verseId": 1427,
   "text": "ਗਾੜ੍ਹੇ ਗੜ੍ਹਾਨ ਕੋ ਤੋੜਨਹਾਰ ਸੁ ਬਾਤਨ ਹੀਂ ਚਕ ਚਾਰ ਲਵੱਯਾ ॥",
   "start": 59.48,
   "end": 66,
   "conf": -1.797,
   "check": 0.78
  },
  {
   "i": 26,
   "verseId": 1428,
   "text": "ਸਾਹਿਬੁ ਸ੍ਰੀ ਸਭ ਕੋ ਸਿਰਨਾਇਕ ਜਾਚਕ ਅਨੇਕ ਸੁ ਏਕ ਦਿਵੱਯਾ ॥੬॥੨੬॥",
   "start": 66.8,
   "end": 69.64,
   "conf": -0.726,
   "check": 0.85
  }
