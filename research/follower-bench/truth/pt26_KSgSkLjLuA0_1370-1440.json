 "lines": [
  {
   "i": 466,
   "verseId": 3218,
   "text": "ਰਾਗ ਰਤਨ ਪਰਵਾਰ ਪਰੀਆ ਸਬਦ ਗਾਵਣ ਆਈਆ ॥",
   "start": 1.16,
   "end": 2.92,
   "conf": -0.568,
   "check": 0.53
  },
  {
   "i": 467,
   "verseId": 3219,
   "text": "ਸਬਦੋ ਤ ਗਾਵਹੁ ਹਰੀ ਕੇਰਾ ਮਨਿ ਜਿਨੀ ਵਸਾਇਆ ॥",
   "start": 3.68,
   "end": 8.92,
   "conf": -0.932,
   "check": 0.75
  },
  {
   "i": 468,
   "verseId": 3220,
   "text": "ਕਹੈ ਨਾਨਕੁ ਅਨੰਦੁ ਹੋਆ ਸਤਿਗੁਰੂ ਮੈ ਪਾਇਆ ॥੧॥",
   "start": 9.92,
   "end": 15.2,
   "conf": -0.242,
   "check": 0.85
  },
  {
   "i": 469,
   "verseId": 3221,
   "text": "ਏ ਮਨ ਮੇਰਿਆ ਤੂ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥",
   "start": 16.32,
   "end": 21.68,
   "conf": -0.721,
   "check": 0.87
  },
  {
   "i": 470,
   "verseId": 3222,
   "text": "ਹਰਿ ਨਾਲਿ ਰਹੁ ਤੂ ਮੰਨ ਮੇਰੇ ਦੂਖ ਸਭਿ ਵਿਸਾਰਣਾ ॥",
   "start": 22.52,
   "end": 27.96,
   "conf": -0.607,
   "check": 0.86
  },
  {
   "i": 471,
   "verseId": 3223,
   "text": "ਅੰਗੀਕਾਰੁ ਓਹੁ ਕਰੇ ਤੇਰਾ ਕਾਰਜ ਸਭਿ ਸਵਾਰਣਾ ॥",
   "start": 28.84,
   "end": 34.2,
   "conf": -0.143,
   "check": 1
  },
  {
   "i": 472,
   "verseId": 3224,
   "text": "ਸਭਨਾ ਗਲਾ ਸਮਰਥੁ ਸੁਆਮੀ ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੇ ॥",
   "start": 35.04,
   "end": 40.44,
   "conf": -0.25,
   "check": 0.94
  },
  {
   "i": 473,
   "verseId": 3225,
   "text": "ਕਹੈ ਨਾਨਕੁ ਮੰਨ ਮੇਰੇ ਸਦਾ ਰਹੁ ਹਰਿ ਨਾਲੇ ॥੨॥",
   "start": 41.4,
   "end": 46.2,
   "conf": -0.655,
   "check": 0.8
  },
  {
   "i": 474,
   "verseId": 3226,
   "text": "ਸਾਚੇ ਸਾਹਿਬਾ ਕਿਆ ਨਾਹੀ ਘਰਿ ਤੇਰੈ ॥",
   "start": 47.32,
   "end": 51.52,
   "conf": -0.086,
   "check": 0.96
  },
  {
   "i": 475,
   "verseId": 3227,
   "text": "ਘਰਿ ਤ ਤੇਰੈ ਸਭੁ ਕਿਛੁ ਹੈ ਜਿਸੁ ਦੇਹਿ ਸੁ ਪਾਵਏ ॥",
   "start": 52.28,
   "end": 57.36,
   "conf": -1.469,
   "check": 0.94
  },
  {
   "i": 476,
   "verseId": 3228,
   "text": "ਸਦਾ ਸਿਫਤਿ ਸਲਾਹ ਤੇਰੀ ਨਾਮੁ ਮਨਿ ਵਸਾਵਏ ॥",
   "start": 58.16,
   "end": 63.2,
   "conf": -0.654,
   "check": 0.88
  },
  {
   "i": 477,
   "verseId": 3229,
   "text": "ਨਾਮੁ ਜਿਨ ਕੈ ਮਨਿ ਵਸਿਆ ਵਾਜੇ ਸਬਦ ਘਨੇਰੇ ॥",
   "start": 64.72,
   "end": 69.8,
   "conf": -0.137,
   "check": 0.96
  }
 ],
