 "lines": [
  {
   "i": 0,
   "verseId": 12,
   "text": "ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 0.32,
   "end": 12.92,
   "conf": -0.716,
   "check": 0.94
  },
  {
   "i": 1,
   "verseId": 13,
   "text": "॥ ਜਪੁ ॥",
   "start": 13.36,
   "end": 13.76,
   "conf": -0.652,
   "check": 0.67
  },
  {
   "i": 2,
   "verseId": 14,
   "text": "ਆਦਿ ਸਚੁ ਜੁਗਾਦਿ ਸਚੁ ॥",
   "start": 15.56,
   "end": 17.52,
   "conf": -0.268,
   "check": 0.93
  },
  {
   "i": 3,
   "verseId": 15,
   "text": "ਹੈ ਭੀ ਸਚੁ ਨਾਨਕ ਹੋਸੀ ਭੀ ਸਚੁ ॥੧॥",
   "start": 17.84,
   "end": 21.08,
   "conf": -0.025,
   "check": 0.95
  },
  {
   "i": 4,
   "verseId": 16,
   "text": "ਸੋਚੈ ਸੋਚਿ ਨ ਹੋਵਈ ਜੇ ਸੋਚੀ ਲਖ ਵਾਰ ॥",
   "start": 21.52,
   "end": 25.08,
   "conf": -0.161,
   "check": 0.96
  },
  {
   "i": 5,
   "verseId": 17,
   "text": "ਚੁਪੈ ਚੁਪ ਨ ਹੋਵਈ ਜੇ ਲਾਇ ਰਹਾ ਲਿਵ ਤਾਰ ॥",
   "start": 25.52,
   "end": 29.32,
   "conf": -0.275,
   "check": 0.96
  },
  {
   "i": 6,
   "verseId": 18,
   "text": "ਭੁਖਿਆ ਭੁਖ ਨ ਉਤਰੀ ਜੇ ਬੰਨਾ ਪੁਰੀਆ ਭਾਰ ॥",
   "start": 31.48,
   "end": 35.52,
   "conf": -0.073,
   "check": 1
  },
  {
   "i": 7,
   "verseId": 19,
   "text": "ਸਹਸ ਸਿਆਣਪਾ ਲਖ ਹੋਹਿ ਤ ਇਕ ਨ ਚਲੈ ਨਾਲਿ ॥",
   "start": 36,
   "end": 40.48,
   "conf": -0.373,
   "check": 0.88
  },
  {
   "i": 8,
   "verseId": 20,
   "text": "ਕਿਵ ਸਚਿਆਰਾ ਹੋਈਐ ਕਿਵ ਕੂੜੈ ਤੁਟੈ ਪਾਲਿ ॥",
   "start": 42.28,
   "end": 46.16,
   "conf": -0.195,
   "check": 1
  },
  {
   "i": 9,
   "verseId": 21,
   "text": "ਹੁਕਮਿ ਰਜਾਈ ਚਲਣਾ ਨਾਨਕ ਲਿਖਿਆ ਨਾਲਿ ॥੧॥",
   "start": 46.56,
   "end": 50.6,
   "conf": -0.341,
   "check": 0.96
  },
  {
   "i": 10,
   "verseId": 22,
   "text": "ਹੁਕਮੀ ਹੋਵਨਿ ਆਕਾਰ ਹੁਕਮੁ ਨ ਕਹਿਆ ਜਾਈ ॥",
   "start": 51.76,
   "end": 54.88,
