 "lines": [
  {
   "i": 54,
   "verseId": 3616,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 1.76,
   "end": 6.24,
   "conf": -0.865,
   "check": 0.7
  },
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 7,
   "end": 13.32,
   "conf": -0.033,
   "check": 0.96
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 13.64,
   "end": 19,
   "conf": -2.768,
   "check": 0.82
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 19.68,
   "end": 29.96,
   "conf": -0.899,
   "check": 0.89
  },
  {
   "i": 58,
   "verseId": 3620,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 31.32,
   "end": 41.52,
   "conf": -0.846,
   "check": 0.86
  },
  {
   "i": 59,
   "verseId": 3621,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 42.92,
   "end": 47.68,
   "conf": -0.273,
   "check": 1
  },
  {
   "i": 60,
   "verseId": 3622,
   "text": "ਤਿਸ ਦੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 47.72,
   "end": 53.68,
   "conf": -1.071,
   "check": 0.82
  },
  {
   "i": 61,
   "verseId": 3623,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
   "start": 54.6,
   "end": 59.64,
   "conf": -0.074,
   "check": 1
  },
  {
   "i": 62,
   "verseId": 3624,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੁ ਆਰਤੀ ਹੋਇ ॥੩॥",
   "start": 60.36,
   "end": 64.96,
   "conf": -0.663,
   "check": 0.94
  },
  {
