 "lines": [
  {
   "i": 10,
   "verseId": 2638,
   "text": "ਜਨ ਨਾਨਕ ਐਸਾ ਹਰਿ ਸੇਵਿਆ ਅੰਤਿ ਲਏ ਛਡਾਇਆ ॥੪॥੧੩॥੨੦॥",
   "start": 5.48,
   "end": 6.24,
   "conf": -13.319,
   "check": 0.18
  },
  {
   "i": 11,
   "verseId": 2639,
   "text": "ਸਲੋਕੁ ਮਃ ੧ ॥",
   "start": 6.72,
   "end": 8.24,
   "conf": -0.79,
   "check": 0.6
  },
  {
   "i": 12,
   "verseId": 2640,
   "text": "ਦੁਖੁ ਦਾਰੂ ਸੁਖੁ ਰੋਗੁ ਭਇਆ ਜਾ ਸੁਖੁ ਤਾਮਿ ਨ ਹੋਈ ॥",
   "start": 9.52,
   "end": 13.44,
   "conf": -0.427,
   "check": 0.8
  },
  {
   "i": 13,
   "verseId": 2641,
   "text": "ਤੂੰ ਕਰਤਾ ਕਰਣਾ ਮੈ ਨਾਹੀ ਜਾ ਹਉ ਕਰੀ ਨ ਹੋਈ ॥੧॥",
   "start": 14.52,
   "end": 18.76,
   "conf": -0.559,
   "check": 0.92
  },
  {
   "i": 14,
   "verseId": 2642,
   "text": "ਬਲਿਹਾਰੀ ਕੁਦਰਤਿ ਵਸਿਆ ॥",
   "start": 19.84,
   "end": 21.4,
   "conf": -0.345,
   "check": 0.87
  },
  {
   "i": 15,
   "verseId": 2643,
   "text": "ਤੇਰਾ ਅੰਤੁ ਨ ਜਾਈ ਲਖਿਆ ॥੧॥ ਰਹਾਉ ॥",
   "start": 22.16,
   "end": 24.88,
   "conf": -0.586,
   "check": 1
  },
  {
   "i": 16,
   "verseId": 2644,
   "text": "ਜਾਤਿ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਮਹਿ ਜਾਤਾ ਅਕਲ ਕਲਾ ਭਰਪੂਰਿ ਰਹਿਆ ॥",
   "start": 25.72,
   "end": 29.36,
   "conf": -0.314,
   "check": 0.91
  },
  {
   "i": 17,
   "verseId": 2645,
   "text": "ਤੂੰ ਸਚਾ ਸਾਹਿਬੁ ਸਿਫਤਿ ਸੁਆਲਿੑਉ ਜਿਨਿ ਕੀਤੀ ਸੋ ਪਾਰਿ ਪਇਆ ॥",
   "start": 29.56,
   "end": 33.52,
   "conf": -0.918,
   "check": 0.77
  },
  {
   "i": 18,
   "verseId": 2646,
   "text": "ਕਹੁ ਨਾਨਕ ਕਰਤੇ ਕੀਆ ਬਾਤਾ ਜੋ ਕਿਛੁ ਕਰਣਾ ਸੁ ਕਰਿ ਰਹਿਆ ॥੨॥",
   "start": 34.88,
   "end": 39.92,
   "conf": -1.272,
   "check": 0.97
  },
  {
   "i": 20,
   "verseId": 2648,
   "text": "ਸੋ ਦਰੁ ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧",
   "start": 40.28,
   "end": 42.92,
   "conf": -1.237,
   "check": 0.56
  },
  {
   "i": 21,
   "verseId": 2649,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 44.16,
   "end": 46.56,
   "conf": -1.779,
   "check": 0.83
  },
  {
   "i": 22,
   "verseId": 2650,
   "text": "ਸੋ ਦਰੁ ਤੇਰਾ ਕੇਹਾ ਸੋ ਘਰੁ ਕੇਹਾ ਜਿਤੁ ਬਹਿ ਸਰਬ ਸਮਾਲੇ ॥",
   "start": 46.88,
   "end": 50.64,
   "conf": -1.154,
   "check": 0.87
  },
  {
   "i": 23,
   "verseId": 2651,
   "text": "ਵਾਜੇ ਤੇਰੇ ਨਾਦ ਅਨੇਕ ਅਸੰਖਾ ਕੇਤੇ ਤੇਰੇ ਵਾਵਣਹਾਰੇ ॥",
   "start": 51.84,
   "end": 56.56,
   "conf": -0.605,
   "check": 0.93
  },
  {
   "i": 24,
   "verseId": 2652,
   "text": "ਕੇਤੇ ਤੇਰੇ ਰਾਗ ਪਰੀ ਸਿਉ ਕਹੀਅਹਿ ਕੇਤੇ ਤੇਰੇ ਗਾਵਣਹਾਰੇ ॥",
   "start": 56.84,
   "end": 60.96,
   "conf": -0.615,
   "check": 0.87
  },
  {
   "i": 25,
   "verseId": 2653,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਪਵਣੁ ਪਾਣੀ ਬੈਸੰਤਰੁ ਗਾਵੈ ਰਾਜਾ ਧਰਮੁ ਦੁਆਰੇ ॥",
   "start": 62.52,
   "end": 67.24,
   "conf": -0.419,
   "check": 0.9
  },
  {
   "i": 26,
   "verseId": 2654,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਚਿਤੁ ਗੁਪਤੁ ਲਿਖਿ ਜਾਣਨਿ ਲਿਖਿ ਲਿਖਿ ਧਰਮੁ ਬੀਚਾਰੇ ॥",
   "start": 67.56,
   "end": 71.28,
   "conf": -0.975,
   "check": 0.69
  },
  {
   "i": 27,
   "verseId": 2655,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਈਸਰੁ ਬ੍ਰਹਮਾ ਦੇਵੀ ਸੋਹਨਿ ਤੇਰੇ ਸਦਾ ਸਵਾਰੇ ॥",
   "start": 72.32,
   "end": 76.48,
   "conf": -0.674,
   "check": 0.76
  },
  {
   "i": 28,
   "verseId": 2656,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਇੰਦ੍ਰ ਇੰਦ੍ਰਾਸਣਿ ਬੈਠੇ ਦੇਵਤਿਆ ਦਰਿ ਨਾਲੇ ॥",
   "start": 76.8,
   "end": 80.64,
   "conf": -0.937,
   "check": 0.78
  },
  {
   "i": 29,
   "verseId": 2657,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਸਿਧ ਸਮਾਧੀ ਅੰਦਰਿ ਗਾਵਨਿ ਤੁਧਨੋ ਸਾਧ ਬੀਚਾਰੇ ॥",
   "start": 81.8,
   "end": 86.48,
   "conf": -1.233,
   "check": 0.67
  },
  {
   "i": 30,
   "verseId": 2658,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਜਤੀ ਸਤੀ ਸੰਤੋਖੀ ਗਾਵਨਿ ਤੁਧਨੋ ਵੀਰ ਕਰਾਰੇ ॥",
   "start": 86.72,
   "end": 90.76,
   "conf": -0.37,
   "check": 0.89
  },
  {
   "i": 31,
   "verseId": 2659,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਪੰਡਿਤ ਪੜਨਿ ਰਖੀਸੁਰ ਜੁਗੁ ਜੁਗੁ ਵੇਦਾ ਨਾਲੇ ॥",
   "start": 91.8,
   "end": 95.96,
   "conf": -0.839,
   "check": 0.83
  },
  {
   "i": 32,
   "verseId": 2660,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਮੋਹਣੀਆ ਮਨੁ ਮੋਹਨਿ ਸੁਰਗੁ ਮਛੁ ਪਇਆਲੇ ॥",
   "start": 96.2,
   "end": 99.48,
   "conf": -1.26,
   "check": 0.86
  },
  {
   "i": 33,
   "verseId": 2661,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਰਤਨ ਉਪਾਏ ਤੇਰੇ ਅਠਸਠਿ ਤੀਰਥ ਨਾਲੇ ॥",
   "start": 100.68,
   "end": 104.24,
   "conf": -0.799,
   "check": 0.81
  },
  {
   "i": 34,
   "verseId": 2662,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਜੋਧ ਮਹਾਬਲ ਸੂਰਾ ਗਾਵਨਿ ਤੁਧਨੋ ਖਾਣੀ ਚਾਰੇ ॥",
   "start": 104.48,
   "end": 108.24,
   "conf": -0.601,
   "check": 0.85
  },
  {
   "i": 35,
   "verseId": 2663,
   "text": "ਗਾਵਨਿ ਤੁਧਨੋ ਖੰਡ ਮੰਡਲ ਬ੍ਰਹਮੰਡਾ ਕਰਿ ਕਰਿ ਰਖੇ ਤੇਰੇ ਧਾਰੇ ॥",
   "start": 109.32,
   "end": 114.88,
   "conf": -0.601,
   "check": 0.89
  },
  {
   "i": 36,
