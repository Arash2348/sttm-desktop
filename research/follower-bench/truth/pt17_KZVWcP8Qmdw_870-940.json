 "lines": [
  {
   "i": 140,
   "verseId": 1923,
   "text": "ਤਿਹੀ ਗੁਣੀ ਸੰਸਾਰੁ ਭ੍ਰਮਿ ਸੁਤਾ ਸੁਤਿਆ ਰੈਣਿ ਵਿਹਾਣੀ ॥",
   "start": 0.64,
   "end": 6.48,
   "conf": -0.331,
   "check": 0.91
  },
  {
   "i": 141,
   "verseId": 1924,
   "text": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਸੇ ਜਨ ਜਾਗੇ ਜਿਨਾ ਹਰਿ ਮਨਿ ਵਸਿਆ ਬੋਲਹਿ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ॥",
   "start": 7.6,
   "end": 16.24,
   "conf": -0.432,
   "check": 0.88
  },
  {
   "i": 142,
   "verseId": 1925,
   "text": "ਕਹੈ ਨਾਨਕੁ ਸੋ ਤਤੁ ਪਾਏ ਜਿਸ ਨੋ ਅਨਦਿਨੁ ਹਰਿ ਲਿਵ ਲਾਗੈ ਜਾਗਤ ਰੈਣਿ ਵਿਹਾਣੀ ॥੨੭॥",
   "start": 17.24,
   "end": 26.32,
   "conf": -0.337,
   "check": 0.88
  },
  {
   "i": 143,
   "verseId": 1926,
   "text": "ਮਾਤਾ ਕੇ ਉਦਰ ਮਹਿ ਪ੍ਰਤਿਪਾਲ ਕਰੇ ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੀਐ ॥",
   "start": 27.32,
   "end": 33.56,
   "conf": -0.221,
   "check": 0.87
  },
  {
   "i": 144,
   "verseId": 1927,
   "text": "ਮਨਹੁ ਕਿਉ ਵਿਸਾਰੀਐ ਏਵਡੁ ਦਾਤਾ ਜਿ ਅਗਨਿ ਮਹਿ ਆਹਾਰੁ ਪਹੁਚਾਵਏ ॥",
   "start": 34.52,
   "end": 43,
   "conf": -1.179,
   "check": 0.82
  },
  {
   "i": 145,
   "verseId": 1928,
   "text": "ਓਸ ਨੋ ਕਿਹੁ ਪੋਹਿ ਨ ਸਕੀ ਜਿਸ ਨਉ ਆਪਣੀ ਲਿਵ ਲਾਵਏ ॥",
   "start": 43,
   "end": 48.96,
   "conf": -0.49,
   "check": 0.93
  },
  {
   "i": 146,
   "verseId": 1929,
   "text": "ਆਪਣੀ ਲਿਵ ਆਪੇ ਲਾਏ ਗੁਰਮੁਖਿ ਸਦਾ ਸਮਾਲੀਐ ॥",
   "start": 50.68,
   "end": 55.76,
   "conf": -0.705,
   "check": 0.96
  },
  {
   "i": 147,
   "verseId": 1930,
   "text": "ਕਹੈ ਨਾਨਕੁ ਏਵਡੁ ਦਾਤਾ ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੀਐ ॥੨੮॥",
   "start": 56.6,
   "end": 62.08,
   "conf": -0.392,
   "check": 0.9
  },
  {
   "i": 148,
   "verseId": 1931,
   "text": "ਜੈਸੀ ਅਗਨਿ ਉਦਰ ਮਹਿ ਤੈਸੀ ਬਾਹਰਿ ਮਾਇਆ ॥",
   "start": 63.04,
   "end": 67.68,
   "conf": -0.278,
   "check": 0.92
  },
  {
   "i": 149,
   "verseId": 1932,
   "text": "ਮਾਇਆ ਅਗਨਿ ਸਭ ਇਕੋ ਜੇਹੀ ਕਰਤੈ ਖੇਲੁ ਰਚਾਇਆ ॥",
   "start": 68.6,
   "end": 69.72,
   "conf": -0.41,
   "check": 0.44
  }
