 "lines": [
  {
   "i": 33,
   "verseId": 3595,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 1.36,
   "end": 2.8,
   "conf": -0.229,
   "check": 1
  },
  {
   "i": 34,
   "verseId": 3596,
   "text": "ਜੈ ਘਰਿ ਕੀਰਤਿ ਆਖੀਐ ਕਰਤੇ ਕਾ ਹੋਇ ਬੀਚਾਰੋ ॥",
   "start": 3.76,
   "end": 8.4,
   "conf": -1.305,
   "check": 0.96
  },
  {
   "i": 35,
   "verseId": 3597,
   "text": "ਤਿਤੁ ਘਰਿ ਗਾਵਹੁ ਸੋਹਿਲਾ ਸਿਵਰਿਹੁ ਸਿਰਜਣਹਾਰੋ ॥੧॥",
   "start": 9.2,
   "end": 13.8,
   "conf": -0.58,
   "check": 0.9
  },
  {
   "i": 36,
   "verseId": 3598,
   "text": "ਤੁਮ ਗਾਵਹੁ ਮੇਰੇ ਨਿਰਭਉ ਕਾ ਸੋਹਿਲਾ ॥",
   "start": 14.68,
   "end": 17.84,
   "conf": -0.77,
   "check": 0.82
  },
  {
   "i": 37,
   "verseId": 3599,
   "text": "ਹਉ ਵਾਰੀ ਜਿਤੁ ਸੋਹਿਲੈ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 18.64,
   "end": 23.24,
   "conf": -0.41,
   "check": 0.96
  },
  {
   "i": 38,
   "verseId": 3600,
   "text": "ਨਿਤ ਨਿਤ ਜੀਅੜੇ ਸਮਾਲੀਅਨਿ ਦੇਖੈਗਾ ਦੇਵਣਹਾਰੁ ॥",
   "start": 24.08,
   "end": 28.84,
   "conf": -0.681,
   "check": 0.94
  },
  {
   "i": 39,
   "verseId": 3601,
   "text": "ਤੇਰੇ ਦਾਨੈ ਕੀਮਤਿ ਨਾ ਪਵੈ ਤਿਸੁ ਦਾਤੇ ਕਵਣੁ ਸੁਮਾਰੁ ॥੨॥",
   "start": 29.68,
   "end": 35.08,
   "conf": -0.515,
   "check": 0.94
  },
  {
   "i": 40,
   "verseId": 3602,
   "text": "ਸੰਬਤਿ ਸਾਹਾ ਲਿਖਿਆ ਮਿਲਿ ਕਰਿ ਪਾਵਹੁ ਤੇਲੁ ॥",
   "start": 35.92,
   "end": 40.52,
   "conf": -0.76,
   "check": 0.75
  },
  {
   "i": 41,
   "verseId": 3603,
   "text": "ਦੇਹੁ ਸਜਣ ਅਸੀਸੜੀਆ ਜਿਉ ਹੋਵੈ ਸਾਹਿਬ ਸਿਉ ਮੇਲੁ ॥੩॥",
   "start": 41.4,
   "end": 46.48,
   "conf": -0.383,
   "check": 0.94
  },
  {
   "i": 42,
   "verseId": 3604,
   "text": "ਘਰਿ ਘਰਿ ਏਹੋ ਪਾਹੁਚਾ ਸਦੜੇ ਨਿਤ ਪਵੰਨਿ ॥",
   "start": 47.2,
   "end": 51.72,
   "conf": -1.362,
   "check": 0.68
  },
  {
   "i": 43,
   "verseId": 3605,
   "text": "ਸਦਣਹਾਰਾ ਸਿਮਰੀਐ ਨਾਨਕ ਸੇ ਦਿਹ ਆਵੰਨਿ ॥੪॥੧॥",
   "start": 52.6,
   "end": 57.52,
   "conf": -1.481,
   "check": 0.78
  },
  {
   "i": 44,
   "verseId": 3606,
   "text": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧ ॥",
   "start": 58.32,
   "end": 60.6,
   "conf": -0.994,
   "check": 0.73
  },
  {
   "i": 45,
   "verseId": 3607,
   "text": "ਛਿਅ ਘਰ ਛਿਅ ਗੁਰ ਛਿਅ ਉਪਦੇਸ ॥",
