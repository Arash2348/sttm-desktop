 "lines": [
  {
   "i": 201,
   "verseId": 213,
   "text": "ਸਹਸ ਅਠਾਰਹ ਕਹਨਿ ਕਤੇਬਾ ਅਸੁਲੂ ਇਕੁ ਧਾਤੁ ॥",
   "start": 1.08,
   "end": 2.8,
   "conf": -0.951,
   "check": 0.4
  },
  {
   "i": 202,
   "verseId": 214,
   "text": "ਲੇਖਾ ਹੋਇ ਤ ਲਿਖੀਐ ਲੇਖੈ ਹੋਇ ਵਿਣਾਸੁ ॥",
   "start": 3.84,
   "end": 8.8,
   "conf": -1.098,
   "check": 0.67
  },
  {
   "i": 203,
   "verseId": 215,
   "text": "ਨਾਨਕ ਵਡਾ ਆਖੀਐ ਆਪੇ ਜਾਣੈ ਆਪੁ ॥੨੨॥",
   "start": 9.6,
   "end": 14.4,
   "conf": -1.515,
   "check": 0.32
  },
  {
   "i": 204,
   "verseId": 216,
   "text": "ਸਾਲਾਹੀ ਸਾਲਾਹਿ ਏਤੀ ਸੁਰਤਿ ਨ ਪਾਈਆ ॥",
   "start": 15.32,
   "end": 20.04,
   "conf": -1.942,
   "check": 0.67
  },
  {
   "i": 205,
   "verseId": 217,
   "text": "ਨਦੀਆ ਅਤੈ ਵਾਹ ਪਵਹਿ ਸਮੁੰਦਿ ਨ ਜਾਣੀਅਹਿ ॥",
   "start": 21.16,
   "end": 25.36,
   "conf": -0.754,
   "check": 0.81
  },
  {
   "i": 206,
   "verseId": 218,
   "text": "ਸਮੁੰਦ ਸਾਹ ਸੁਲਤਾਨ ਗਿਰਹਾ ਸੇਤੀ ਮਾਲੁ ਧਨੁ ॥",
   "start": 26.24,
   "end": 31.24,
   "conf": -0.293,
   "check": 0.97
  },
  {
   "i": 207,
   "verseId": 219,
   "text": "ਕੀੜੀ ਤੁਲਿ ਨ ਹੋਵਨੀ ਜੇ ਤਿਸੁ ਮਨਹੁ ਨ ਵੀਸਰਹਿ ॥੨੩॥",
   "start": 32.88,
   "end": 38.2,
   "conf": -0.767,
   "check": 0.83
  },
  {
   "i": 208,
   "verseId": 220,
   "text": "ਅੰਤੁ ਨ ਸਿਫਤੀ ਕਹਣਿ ਨ ਅੰਤੁ ॥",
   "start": 38.96,
   "end": 41.6,
   "conf": -0.556,
   "check": 1
  },
  {
   "i": 209,
   "verseId": 221,
   "text": "ਅੰਤੁ ਨ ਕਰਣੈ ਦੇਣਿ ਨ ਅੰਤੁ ॥",
   "start": 42.32,
   "end": 44.96,
   "conf": -1.011,
   "check": 0.65
  },
  {
   "i": 210,
   "verseId": 222,
   "text": "ਅੰਤੁ ਨ ਵੇਖਣਿ ਸੁਣਣਿ ਨ ਅੰਤੁ ॥",
   "start": 45.72,
   "end": 48.52,
   "conf": -1.942,
   "check": 0.33
  },
  {
   "i": 211,
   "verseId": 223,
   "text": "ਅੰਤੁ ਨ ਜਾਪੈ ਕਿਆ ਮਨਿ ਮੰਤੁ ॥",
   "start": 49.28,
   "end": 51.96,
   "conf": -1.042,
   "check": 0.88
  },
  {
   "i": 212,
   "verseId": 224,
   "text": "ਅੰਤੁ ਨ ਜਾਪੈ ਕੀਤਾ ਆਕਾਰੁ ॥",
   "start": 52.72,
   "end": 55.68,
   "conf": -0.561,
   "check": 0.87
  },
  {
   "i": 213,
   "verseId": 225,
   "text": "ਅੰਤੁ ਨ ਜਾਪੈ ਪਾਰਾਵਾਰੁ ॥",
   "start": 56.4,
   "end": 59.28,
   "conf": -0.624,
   "check": 0.86
  },
  {
   "i": 214,
   "verseId": 226,
   "text": "ਅੰਤ ਕਾਰਣਿ ਕੇਤੇ ਬਿਲਲਾਹਿ ॥",
   "start": 60.36,
   "end": 63.08,
   "conf": -0.701,
   "check": 0.89
  },
  {
   "i": 215,
   "verseId": 227,
   "text": "ਤਾ ਕੇ ਅੰਤ ਨ ਪਾਏ ਜਾਹਿ ॥",
   "start": 64.12,
   "end": 66.8,
   "conf": -0.788,
   "check": 0.87
  },
  {
