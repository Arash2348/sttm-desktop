 "lines": [
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 0.48,
   "end": 5,
   "conf": -0.088,
   "check": 1
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 5.76,
   "end": 9.56,
   "conf": -0.388,
   "check": 0.94
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 10.2,
   "end": 16.88,
   "conf": -0.781,
   "check": 0.89
  },
  {
   "i": 58,
   "verseId": 3620,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 17.56,
   "end": 24.16,
   "conf": -1.42,
   "check": 0.84
  },
  {
   "i": 59,
   "verseId": 3621,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 24.84,
   "end": 27.36,
   "conf": -1.547,
   "check": 0.09
  },
  {
   "i": 60,
   "verseId": 3622,
   "text": "ਤਿਸ ਦੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 27.96,
   "end": 31.2,
   "conf": -0.746,
   "check": 0.93
  },
  {
   "i": 61,
   "verseId": 3623,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
   "start": 31.88,
   "end": 34.92,
   "conf": -0.183,
   "check": 1
  },
  {
   "i": 62,
   "verseId": 3624,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੁ ਆਰਤੀ ਹੋਇ ॥੩॥",
   "start": 35.64,
   "end": 38.84,
   "conf": -1.214,
   "check": 0.88
  },
  {
   "i": 63,
   "verseId": 3625,
   "text": "ਹਰਿ ਚਰਣ ਕਵਲ ਮਕਰੰਦ ਲੋਭਿਤ ਮਨੋ ਅਨਦਿਨੋੁ ਮੋਹਿ ਆਹੀ ਪਿਆਸਾ ॥",
   "start": 39.4,
   "end": 45.68,
   "conf": -0.904,
   "check": 0.83
  },
  {
   "i": 64,
   "verseId": 3626,
   "text": "ਕ੍ਰਿਪਾ ਜਲੁ ਦੇਹਿ ਨਾਨਕ ਸਾਰਿੰਗ ਕਉ ਹੋਇ ਜਾ ਤੇ ਤੇਰੈ ਨਾਇ ਵਾਸਾ ॥੪॥੩॥",
   "start": 45.72,
   "end": 53.2,
   "conf": -1.771,
   "check": 0.87
  },
  {
   "i": 65,
   "verseId": 3627,
   "text": "ਰਾਗੁ ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ੪ ॥",
   "start": 54.64,
   "end": 57.8,
   "conf": -0.233,
   "check": 0.9
  },
  {
   "i": 66,
   "verseId": 3628,
   "text": "ਕਾਮਿ ਕਰੋਧਿ ਨਗਰੁ ਬਹੁ ਭਰਿਆ ਮਿਲਿ ਸਾਧੂ ਖੰਡਲ ਖੰਡਾ ਹੇ ॥",
   "start": 58.48,
   "end": 64.04,
   "conf": -1.538,
   "check": 0.91
  },
  {
   "i": 67,
   "verseId": 3629,
   "text": "ਪੂਰਬਿ ਲਿਖਤ ਲਿਖੇ ਗੁਰੁ ਪਾਇਆ ਮਨਿ ਹਰਿ ਲਿਵ ਮੰਡਲ ਮੰਡਾ ਹੇ ॥੧॥",
   "start": 64.52,
   "end": 69.84,
