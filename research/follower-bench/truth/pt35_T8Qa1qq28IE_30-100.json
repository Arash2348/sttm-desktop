 "lines": [
  {
   "i": 54,
   "verseId": 3616,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 2.84,
   "end": 11.76,
   "conf": -1.043,
   "check": 0.83
  },
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 14.96,
   "end": 19.92,
   "conf": -0.039,
   "check": 1
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 20.72,
   "end": 27.16,
   "conf": -1.914,
   "check": 0.81
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 27.6,
   "end": 36.72,
   "conf": -1.17,
   "check": 0.82
  },
  {
   "i": 58,
   "verseId": 3620,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 40.08,
   "end": 49.24,
   "conf": -0.37,
   "check": 0.89
  },
  {
   "i": 59,
   "verseId": 3621,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 52.92,
   "end": 57.04,
   "conf": -0.03,
   "check": 1
  },
  {
   "i": 60,
   "verseId": 3622,
   "text": "ਤਿਸ ਦੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 57.48,
   "end": 62.4,
   "conf": -1.214,
   "check": 0.7
  },
  {
   "i": 61,
   "verseId": 3623,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
