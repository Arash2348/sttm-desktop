   "end": 263.72,
   "conf": -0.713,
   "check": 0.8
  },
  {
   "i": 130,
   "verseId": 3422,
   "text": "ਮਦਨ ਮੂਰਤਿ ਭੈ ਤਾਰਿ ਗੋਬਿੰਦੇ ॥",
