  {
   "i": 117,
   "verseId": 3409,
   "text": "ਨਾਮ ਤੇਰੇ ਕੀ ਜੋਤਿ ਲਗਾਈ ਭਇਓ ਉਜਿਆਰੋ ਭਵਨ ਸਗਲਾਰੇ ॥੨॥",
   "start": 0.68,
   "end": 18.88,
   "conf": -7.388,
   "check": 0.4
  },
  {
   "i": 118,
   "verseId": 3410,
   "text": "ਨਾਮੁ ਤੇਰੋ ਤਾਗਾ ਨਾਮੁ ਫੂਲ ਮਾਲਾ ਭਾਰ ਅਠਾਰਹ ਸਗਲ ਜੂਠਾਰੇ ॥",
   "start": 19.48,
   "end": 51.96,
   "conf": -6.513,
   "check": 0.4
  },
  {
   "i": 108,
   "verseId": 3399,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
   "start": 52.36,
   "end": 66.32,
   "conf": -7.64,
   "check": 0.37
  },
  {
   "i": 100,
   "verseId": 3391,
   "text": "ਗਗਨ ਮੈ ਥਾਲੁ ਰਵਿ ਚੰਦੁ ਦੀਪਕ ਬਨੇ ਤਾਰਿਕਾ ਮੰਡਲ ਜਨਕ ਮੋਤੀ ॥",
   "start": 66.52,
   "end": 86.96,
   "conf": -4.798,
   "check": 0.35
  },
  {
   "i": 101,
   "verseId": 3392,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 88,
   "end": 96,
   "conf": -2.409,
   "check": 0.61
  },
  {
   "i": 102,
   "verseId": 3393,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 96.48,
   "end": 101.32,
   "conf": -2.652,
   "check": 0.53
  },
  {
   "i": 103,
   "verseId": 3394,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 101.64,
   "end": 105.16,
   "conf": -4.919,
   "check": 0.47
  },
  {
   "i": 104,
   "verseId": 3395,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹੈ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋਹੀ ॥",
   "start": 105.68,
   "end": 113.76,
   "conf": -4.48,
   "check": 0.44
  },
  {
   "i": 105,
   "verseId": 3396,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 114.52,
   "end": 122.52,
   "conf": -1.495,
   "check": 0.63
  },
  {
   "i": 106,
   "verseId": 3397,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 123.52,
   "end": 127.12,
   "conf": -1.685,
   "check": 0.64
  },
  {
   "i": 107,
   "verseId": 3398,
   "text": "ਤਿਸ ਕੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 127.32,
   "end": 131.64,
   "conf": -2.332,
   "check": 0.56
  },
  {
   "i": 108,
   "verseId": 3399,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
   "start": 131.88,
   "end": 135.8,
   "conf": -3.734,
   "check": 0.35
  },
  {
   "i": 109,
   "verseId": 3400,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੁ ਆਰਤੀ ਹੋਇ ॥੩॥",
   "start": 136.4,
   "end": 139.96,
   "conf": -1.598,
   "check": 0.79
  },
  {
   "i": 110,
   "verseId": 3401,
   "text": "ਹਰਿ ਚਰਣ ਕਮਲ ਮਕਰੰਦ ਲੋਭਿਤ ਮਨੋ ਅਨਦਿਨੋ ਮੋਹਿ ਆਹੀ ਪਿਆਸਾ ॥",
   "start": 140.2,
   "end": 148.8,
   "conf": -2.16,
   "check": 0.54
  },
  {
   "i": 111,
   "verseId": 3402,
   "text": "ਕ੍ਰਿਪਾ ਜਲੁ ਦੇਹਿ ਨਾਨਕ ਸਾਰਿੰਗ ਕਉ ਹੋਇ ਜਾ ਤੇ ਤੇਰੈ ਨਾਮਿ ਵਾਸਾ ॥੪॥੧॥੭॥੯॥",
   "start": 149.12,
   "end": 157.48,
   "conf": -3.192,
   "check": 0.68
  },
  {
   "i": 112,
   "verseId": 3404,
   "text": "ਨਾਮੁ ਤੇਰੋ ਆਰਤੀ ਮਜਨੁ ਮੁਰਾਰੇ ॥",
   "start": 157.68,
   "end": 161.04,
   "conf": -3.649,
   "check": 0.38
  },
  {
   "i": 113,
   "verseId": 3405,
   "text": "ਹਰਿ ਕੇ ਨਾਮ ਬਿਨੁ ਝੂਠੇ ਸਗਲ ਪਾਸਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 161.24,
   "end": 165.88,
   "conf": -3.644,
   "check": 0.57
  },
  {
   "i": 114,
   "verseId": 3406,
   "text": "ਨਾਮੁ ਤੇਰੋ ਆਸਨੋ ਨਾਮੁ ਤੇਰੋ ਉਰਸਾ ਨਾਮੁ ਤੇਰਾ ਕੇਸਰੋ ਲੇ ਛਿਟਕਾਰੇ ॥",
   "start": 166,
   "end": 173.8,
   "conf": -1.688,
   "check": 0.63
  },
  {
   "i": 115,
   "verseId": 3407,
   "text": "ਨਾਮੁ ਤੇਰਾ ਅੰਭੁਲਾ ਨਾਮੁ ਤੇਰੋ ਚੰਦਨੋ ਘਸਿ ਜਪੇ ਨਾਮੁ ਲੇ ਤੁਝਹਿ ਕਉ ਚਾਰੇ ॥੧॥",
   "start": 174.28,
   "end": 182.2,
   "conf": -1.816,
   "check": 0.58
  },
  {
   "i": 116,
   "verseId": 3408,
   "text": "ਨਾਮੁ ਤੇਰਾ ਦੀਵਾ ਨਾਮੁ ਤੇਰੋ ਬਾਤੀ ਨਾਮੁ ਤੇਰੋ ਤੇਲੁ ਲੇ ਮਾਹਿ ਪਸਾਰੇ ॥",
   "start": 182.68,
   "end": 190.44,
   "conf": -1.455,
   "check": 0.66
  },
  {
   "i": 117,
   "verseId": 3409,
   "text": "ਨਾਮ ਤੇਰੇ ਕੀ ਜੋਤਿ ਲਗਾਈ ਭਇਓ ਉਜਿਆਰੋ ਭਵਨ ਸਗਲਾਰੇ ॥੨॥",
   "start": 190.96,
   "end": 198.76,
   "conf": -1.928,
   "check": 0.67
  },
  {
   "i": 118,
   "verseId": 3410,
