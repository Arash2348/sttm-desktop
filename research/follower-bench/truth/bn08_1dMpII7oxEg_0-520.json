   "start": 199.24,
   "end": 206.88,
   "conf": -3.447,
   "check": 0.55
  },
  {
   "i": 119,
   "verseId": 3411,
   "text": "ਤੇਰੋ ਕੀਆ ਤੁਝਹਿ ਕਿਆ ਅਰਪਉ ਨਾਮੁ ਤੇਰਾ ਤੁਹੀ ਚਵਰ ਢੋਲਾਰੇ ॥੩॥",
   "start": 207.36,
   "end": 215.12,
   "conf": -3.614,
   "check": 0.55
  },
  {
   "i": 120,
   "verseId": 3412,
   "text": "ਦਸ ਅਠਾ ਅਠਸਠੇ ਚਾਰੇ ਖਾਣੀ ਇਹੈ ਵਰਤਣਿ ਹੈ ਸਗਲ ਸੰਸਾਰੇ ॥",
   "start": 215.56,
   "end": 223.24,
   "conf": -2.677,
   "check": 0.58
  },
  {
   "i": 121,
   "verseId": 3413,
   "text": "ਕਹੈ ਰਵਿਦਾਸੁ ਨਾਮੁ ਤੇਰੋ ਆਰਤੀ ਸਤਿ ਨਾਮੁ ਹੈ ਹਰਿ ਭੋਗ ਤੁਹਾਰੇ ॥੪॥੩॥",
   "start": 223.72,
   "end": 231.44,
   "conf": -2.973,
   "check": 0.53
  },
  {
   "i": 123,
   "verseId": 3415,
   "text": "ਧੂਪ ਦੀਪ ਘ੍ਰਿਤ ਸਾਜਿ ਆਰਤੀ ॥",
   "start": 232,
   "end": 235.72,
   "conf": -5.676,
   "check": 0.37
  },
  {
   "i": 124,
   "verseId": 3416,
