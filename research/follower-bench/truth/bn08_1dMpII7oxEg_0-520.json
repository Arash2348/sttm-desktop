   "conf": -3.996,
   "check": 0.15
  },
  {
   "i": 152,
   "verseId": 3444,
   "text": "ਯਾ ਤੇ ਪ੍ਰਸੰਨ ਭਏ ਹੈ ਮਹਾ ਮੁਨ ਦੇਵਨ ਕੇ ਤਪ ਮੈ ਸੁਖ ਪਾਵੈ ॥",
   "start": 422.84,
   "end": 431.48,
   "conf": -3.156,
   "check": 0.46
  },
  {
   "i": 153,
   "verseId": 3445,
   "text": "ਜਗ੍ਯ ਕਰੈ ਇਕ ਬੇਦ ਰਰੈ ਭਵ ਤਾਪ ਹਰੈ ਮਿਲਿ ਧਿਆਨਹਿ ਲਾਵੈ ॥",
   "start": 431.8,
   "end": 437.6,
   "conf": -3.846,
   "check": 0.36
  },
  {
   "i": 154,
   "verseId": 3446,
   "text": "ਝਾਲਰ ਤਾਲ ਮ੍ਰਿਦੰਗ ਉਪੰਗ ਰਬਾਬ ਲੀਏ ਸੁਰ ਸਾਜ ਮਿਲਾਵੈ ॥",
   "start": 437.84,
   "end": 443.48,
   "conf": -4.567,
   "check": 0.54
  },
  {
   "i": 155,
   "verseId": 3447,
   "text": "ਕਿੰਨਰ ਗੰਧ੍ਰਬ ਗਾਨ ਕਰੈ ਗਨਿ ਜਛ ਅਪਛਰ ਨਿਰਤ ਦਿਖਾਵੈ ॥੫੪॥",
   "start": 443.72,
   "end": 449.24,
   "conf": -3.045,
   "check": 0.23
  },
  {
   "i": 156,
   "verseId": 3448,
   "text": "ਸੰਖਨ ਕੀ ਧੁਨ ਘੰਟਨਿ ਕੀ ਕਰਿ ਫੂਲਨ ਕੀ ਬਰਖਾ ਬਰਖਾਵੈ ॥",
   "start": 449.52,
   "end": 454.8,
   "conf": -2.356,
   "check": 0.61
  },
  {
   "i": 157,
   "verseId": 3449,
   "text": "ਆਰਤੀ ਕੋਟਿ ਕਰੈ ਸੁਰ ਸੁੰਦਰਿ ਪੇਖ ਪੁਰੰਦਰ ਕੇ ਬਲਿ ਜਾਵੈ ॥",
   "start": 455.08,
   "end": 461.8,
   "conf": -4.647,
   "check": 0.4
  },
  {
   "i": 158,
   "verseId": 3450,
   "text": "ਦਾਨਤ ਦਛਨ ਦੈ ਕੈ ਪ੍ਰਦਛਨ ਭਾਲ ਮੈ ਕੁੰਕਮ ਅਛਤ ਲਾਵੈ ॥",
   "start": 461.96,
   "end": 469.36,
   "conf": -4.845,
   "check": 0.3
  },
  {
   "i": 159,
   "verseId": 3451,
   "text": "ਹੋਤ ਕੁਲਾਹਲ ਦੇਵਪੁਰੀ ਮਿਲ ਦੇਵਨ ਕੇ ਕੁਲਿ ਮੰਗਲ ਗਾਵੈ ॥੫੫॥",
   "start": 469.56,
   "end": 476.88,
   "conf": -8.639,
   "check": 0.24
  },
  {
   "i": 161,
   "verseId": 3453,
   "text": "ਹੇ ਰਵਿ ਹੇ ਸਸਿ ਹੇ ਕਰੁਨਾਨਿਧਿ ਮੇਰੀ ਅਬੈ ਬਿਨਤੀ ਸੁਨਿ ਲੀਜੈ ॥",
   "start": 477.36,
   "end": 487.44,
   "conf": -2.75,
   "check": 0.53
  },
  {
   "i": 162,
   "verseId": 3454,
   "text": "ਅਉਰ ਨ ਮਾਗਤ ਹਉ ਤੁਮ ਤੇ ਕਛੁ ਚਾਹਤ ਹਉ ਚਿਤ ਮੈ ਸੋਈ ਕੀਜੈ ॥",
   "start": 487.72,
   "end": 493.24,
   "conf": -2.512,
   "check": 0.38
  },
  {
   "i": 163,
   "verseId": 3455,
   "text": "ਸਸਤ੍ਰਨ ਸੋ ਅਤਿ ਹੀ ਰਨ ਭੀਤਰ ਜੂਝਿ ਮਰੋ ਕਹਿ ਸਾਚ ਪਤੀਜੈ ॥",
