 "lines": [
  {
   "i": 54,
   "verseId": 3616,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 0.4,
   "end": 1.64,
   "conf": -2.289,
   "check": 0.22
  },
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 2.6,
   "end": 9.12,
   "conf": -1.365,
   "check": 0.79
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 9.6,
   "end": 16.24,
   "conf": -2.6,
   "check": 0.73
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 16.36,
   "end": 27.04,
   "conf": -2.279,
   "check": 0.62
  },
  {
   "i": 58,
   "verseId": 3620,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 28.16,
   "end": 39.68,
   "conf": -0.853,
   "check": 0.9
  },
  {
   "i": 59,
   "verseId": 3621,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 41.2,
   "end": 46.24,
   "conf": -0.261,
   "check": 0.94
  },
  {
   "i": 60,
   "verseId": 3622,
   "text": "ਤਿਸ ਦੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 46.48,
   "end": 52.8,
   "conf": -1.088,
   "check": 0.78
  },
  {
   "i": 61,
   "verseId": 3623,
   "text": "ਗੁਰ ਸਾਖੀ ਜੋਤਿ ਪਰਗਟੁ ਹੋਇ ॥",
   "start": 53.52,
   "end": 58.84,
   "conf": -0.217,
   "check": 0.89
  },
  {
   "i": 62,
   "verseId": 3624,
   "text": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੁ ਆਰਤੀ ਹੋਇ ॥੩॥",
   "start": 59.6,
   "end": 64.68,
   "conf": -0.318,
   "check": 0.95
  },
  {
   "i": 63,
   "verseId": 3625,
