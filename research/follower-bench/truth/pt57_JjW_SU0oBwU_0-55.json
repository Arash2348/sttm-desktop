 "lines": [
  {
   "i": 0,
   "verseId": 12,
   "text": "ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 1.28,
   "end": 8.16,
   "conf": -0.451,
   "check": 0.88
  },
  {
   "i": 1,
   "verseId": 13,
   "text": "॥ ਜਪੁ ॥",
   "start": 8.28,
   "end": 8.52,
   "conf": -1.634,
   "check": 0
  },
  {
   "i": 2,
   "verseId": 14,
   "text": "ਆਦਿ ਸਚੁ ਜੁਗਾਦਿ ਸਚੁ ॥",
   "start": 8.92,
   "end": 10.92,
   "conf": -0.235,
   "check": 1
  },
  {
   "i": 3,
   "verseId": 15,
   "text": "ਹੈ ਭੀ ਸਚੁ ਨਾਨਕ ਹੋਸੀ ਭੀ ਸਚੁ ॥੧॥",
   "start": 11,
   "end": 13.36,
   "conf": -0.291,
   "check": 1
  },
  {
   "i": 4,
   "verseId": 16,
   "text": "ਸੋਚੈ ਸੋਚਿ ਨ ਹੋਵਈ ਜੇ ਸੋਚੀ ਲਖ ਵਾਰ ॥",
   "start": 13.92,
   "end": 16.52,
   "conf": -0.634,
   "check": 0.65
  },
  {
   "i": 5,
   "verseId": 17,
   "text": "ਚੁਪੈ ਚੁਪ ਨ ਹੋਵਈ ਜੇ ਲਾਇ ਰਹਾ ਲਿਵ ਤਾਰ ॥",
   "start": 16.64,
   "end": 18.68,
   "conf": -1.431,
   "check": 0.51
  },
  {
   "i": 6,
   "verseId": 18,
   "text": "ਭੁਖਿਆ ਭੁਖ ਨ ਉਤਰੀ ਜੇ ਬੰਨਾ ਪੁਰੀਆ ਭਾਰ ॥",
   "start": 19.12,
   "end": 21.24,
   "conf": -1.565,
   "check": 0.31
  },
  {
   "i": 7,
   "verseId": 19,
   "text": "ਸਹਸ ਸਿਆਣਪਾ ਲਖ ਹੋਹਿ ਤ ਇਕ ਨ ਚਲੈ ਨਾਲਿ ॥",
   "start": 21.44,
   "end": 23.96,
   "conf": -1.259,
   "check": 0.51
  },
  {
   "i": 8,
   "verseId": 20,
   "text": "ਕਿਵ ਸਚਿਆਰਾ ਹੋਈਐ ਕਿਵ ਕੂੜੈ ਤੁਟੈ ਪਾਲਿ ॥",
   "start": 24.28,
   "end": 26.64,
   "conf": -2.282,
   "check": 0.06
  },
  {
   "i": 9,
   "verseId": 21,
   "text": "ਹੁਕਮਿ ਰਜਾਈ ਚਲਣਾ ਨਾਨਕ ਲਿਖਿਆ ਨਾਲਿ ॥੧॥",
   "start": 26.68,
   "end": 28.6,
   "conf": -1.637,
   "check": 0.58
  },
  {
   "i": 10,
   "verseId": 22,
   "text": "ਹੁਕਮੀ ਹੋਵਨਿ ਆਕਾਰ ਹੁਕਮੁ ਨ ਕਹਿਆ ਜਾਈ ॥",
   "start": 28.72,
   "end": 30.76,
   "conf": -0.215,
   "check": 0.96
  },
  {
   "i": 11,
   "verseId": 23,
   "text": "ਹੁਕਮੀ ਹੋਵਨਿ ਜੀਅ ਹੁਕਮਿ ਮਿਲੈ ਵਡਿਆਈ ॥",
   "start": 30.96,
   "end": 32.84,
   "conf": -0.623,
   "check": 0.8
  },
  {
   "i": 12,
   "verseId": 24,
   "text": "ਹੁਕਮੀ ਉਤਮੁ ਨੀਚੁ ਹੁਕਮਿ ਲਿਖਿ ਦੁਖ ਸੁਖ ਪਾਈਅਹਿ ॥",
   "start": 33.32,
   "end": 35.56,
   "conf": -0.603,
   "check": 0.86
  },
  {
   "i": 13,
   "verseId": 25,
   "text": "ਇਕਨਾ ਹੁਕਮੀ ਬਖਸੀਸ ਇਕਿ ਹੁਕਮੀ ਸਦਾ ਭਵਾਈਅਹਿ ॥",
   "start": 35.64,
   "end": 37.8,
   "conf": -1.039,
   "check": 0.76
  },
  {
   "i": 14,
   "verseId": 26,
   "text": "ਹੁਕਮੈ ਅੰਦਰਿ ਸਭੁ ਕੋ ਬਾਹਰਿ ਹੁਕਮ ਨ ਕੋਇ ॥",
   "start": 38.12,
   "end": 40.6,
   "conf": -0.129,
   "check": 0.96
  },
  {
   "i": 15,
   "verseId": 27,
   "text": "ਨਾਨਕ ਹੁਕਮੈ ਜੇ ਬੁਝੈ ਤ ਹਉਮੈ ਕਹੈ ਨ ਕੋਇ ॥੨॥",
   "start": 40.8,
   "end": 42.92,
   "conf": -0.512,
   "check": 0.82
  },
  {
   "i": 16,
   "verseId": 28,
   "text": "ਗਾਵੈ ਕੋ ਤਾਣੁ ਹੋਵੈ ਕਿਸੈ ਤਾਣੁ ॥",
   "start": 43.36,
   "end": 45.24,
   "conf": -0.393,
   "check": 0.95
  },
  {
   "i": 17,
   "verseId": 29,
   "text": "ਗਾਵੈ ਕੋ ਦਾਤਿ ਜਾਣੈ ਨੀਸਾਣੁ ॥",
   "start": 45.36,
   "end": 47.08,
   "conf": -1.044,
   "check": 0.8
  },
  {
   "i": 18,
   "verseId": 30,
   "text": "ਗਾਵੈ ਕੋ ਗੁਣ ਵਡਿਆਈਆ ਚਾਰ ॥",
   "start": 47.36,
   "end": 48.92,
   "conf": -0.444,
   "check": 0.94
  },
  {
   "i": 19,
   "verseId": 31,
   "text": "ਗਾਵੈ ਕੋ ਵਿਦਿਆ ਵਿਖਮੁ ਵੀਚਾਰੁ ॥",
   "start": 49.16,
   "end": 50.88,
   "conf": -0.459,
   "check": 0.75
  },
  {
   "i": 20,
   "verseId": 32,
   "text": "ਗਾਵੈ ਕੋ ਸਾਜਿ ਕਰੇ ਤਨੁ ਖੇਹ ॥",
   "start": 51.16,
   "end": 52.72,
   "conf": -0.672,
   "check": 0.83
  },
  {
   "i": 21,
