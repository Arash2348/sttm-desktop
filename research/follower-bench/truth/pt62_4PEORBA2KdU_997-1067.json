 "lines": [
  {
   "i": 294,
   "verseId": 306,
   "text": "ਭੁਗਤਿ ਗਿਆਨੁ ਦਇਆ ਭੰਡਾਰਣਿ ਘਟਿ ਘਟਿ ਵਾਜਹਿ ਨਾਦ ॥",
   "start": 2,
   "end": 6.04,
   "conf": -0.582,
   "check": 0.84
  },
  {
   "i": 295,
   "verseId": 307,
   "text": "ਆਪਿ ਨਾਥੁ ਨਾਥੀ ਸਭ ਜਾ ਕੀ ਰਿਧਿ ਸਿਧਿ ਅਵਰਾ ਸਾਦ ॥",
   "start": 6.72,
   "end": 10.4,
   "conf": -0.558,
   "check": 0.93
  },
  {
   "i": 296,
   "verseId": 308,
   "text": "ਸੰਜੋਗੁ ਵਿਜੋਗੁ ਦੁਇ ਕਾਰ ਚਲਾਵਹਿ ਲੇਖੇ ਆਵਹਿ ਭਾਗ ॥",
   "start": 12.56,
   "end": 17.08,
   "conf": -0.642,
   "check": 0.74
  },
  {
   "i": 297,
   "verseId": 309,
   "text": "ਆਦੇਸੁ ਤਿਸੈ ਆਦੇਸੁ ॥",
   "start": 17.4,
   "end": 19.36,
   "conf": -0.325,
   "check": 0.92
  },
  {
   "i": 298,
   "verseId": 310,
   "text": "ਆਦਿ ਅਨੀਲੁ ਅਨਾਦਿ ਅਨਾਹਤਿ ਜੁਗੁ ਜੁਗੁ ਏਕੋ ਵੇਸੁ ॥੨੯॥",
   "start": 19.76,
   "end": 23.92,
   "conf": -0.406,
   "check": 0.87
  },
  {
   "i": 299,
   "verseId": 311,
   "text": "ਏਕਾ ਮਾਈ ਜੁਗਤਿ ਵਿਆਈ ਤਿਨਿ ਚੇਲੇ ਪਰਵਾਣੁ ॥",
   "start": 25.32,
   "end": 28.96,
   "conf": -0.678,
   "check": 0.89
  },
  {
   "i": 300,
   "verseId": 312,
   "text": "ਇਕੁ ਸੰਸਾਰੀ ਇਕੁ ਭੰਡਾਰੀ ਇਕੁ ਲਾਏ ਦੀਬਾਣੁ ॥",
   "start": 29.32,
   "end": 33.44,
   "conf": -1.06,
   "check": 0.85
  },
  {
   "i": 301,
   "verseId": 313,
   "text": "ਜਿਵ ਤਿਸੁ ਭਾਵੈ ਤਿਵੈ ਚਲਾਵੈ ਜਿਵ ਹੋਵੈ ਫੁਰਮਾਣੁ ॥",
   "start": 34.68,
   "end": 38.72,
   "conf": -0.192,
   "check": 0.91
  },
  {
   "i": 302,
   "verseId": 314,
   "text": "ਓਹੁ ਵੇਖੈ ਓਨਾ ਨਦਰਿ ਨ ਆਵੈ ਬਹੁਤਾ ਏਹੁ ਵਿਡਾਣੁ ॥",
   "start": 38.84,
   "end": 43.08,
   "conf": -1.238,
   "check": 0.85
  },
  {
   "i": 303,
   "verseId": 315,
