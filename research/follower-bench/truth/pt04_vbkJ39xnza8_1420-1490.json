   "conf": -1.22,
   "check": 0.64
  },
  {
   "i": 311,
   "verseId": 323,
   "text": "ਇਕ ਦੂ ਜੀਭੌ ਲਖ ਹੋਹਿ ਲਖ ਹੋਵਹਿ ਲਖ ਵੀਸ ॥",
   "start": 25.96,
   "end": 31,
   "conf": -2.068,
   "check": 0.69
  },
  {
   "i": 312,
