 "lines": [
  {
   "i": 7,
   "verseId": 2635,
   "text": "ਹਰਿ ਜੁਗੁ ਜੁਗੁ ਭਗਤ ਉਪਾਇਆ ਪੈਜ ਰਖਦਾ ਆਇਆ ਰਾਮ ਰਾਜੇ ॥",
   "start": 2.24,
   "end": 6.32,
   "conf": -1.15,
   "check": 0.86
  },
  {
   "i": 8,
   "verseId": 2636,
   "text": "ਹਰਣਾਖਸੁ ਦੁਸਟੁ ਹਰਿ ਮਾਰਿਆ ਪ੍ਰਹਲਾਦੁ ਤਰਾਇਆ ॥",
   "start": 6.88,
   "end": 10.12,
   "conf": -1.253,
   "check": 0.84
  },
  {
   "i": 9,
   "verseId": 2637,
   "text": "ਅਹੰਕਾਰੀਆ ਨਿੰਦਕਾ ਪਿਠਿ ਦੇਇ ਨਾਮਦੇਉ ਮੁਖਿ ਲਾਇਆ ॥",
   "start": 10.88,
   "end": 14.4,
   "conf": -0.454,
   "check": 0.91
  },
  {
   "i": 10,
   "verseId": 2638,
   "text": "ਜਨ ਨਾਨਕ ਐਸਾ ਹਰਿ ਸੇਵਿਆ ਅੰਤਿ ਲਏ ਛਡਾਇਆ ॥੪॥੧੩॥੨੦॥",
   "start": 15.24,
   "end": 19.08,
   "conf": -0.391,
   "check": 0.92
  },
  {
   "i": 11,
   "verseId": 2639,
   "text": "ਸਲੋਕੁ ਮਃ ੧ ॥",
   "start": 19.92,
   "end": 23.16,
   "conf": -11.432,
   "check": 0.36
  },
  {
   "i": 12,
   "verseId": 2640,
   "text": "ਦੁਖੁ ਦਾਰੂ ਸੁਖੁ ਰੋਗੁ ਭਇਆ ਜਾ ਸੁਖੁ ਤਾਮਿ ਨ ਹੋਈ ॥",
   "start": 24.84,
   "end": 28,
   "conf": -0.679,
   "check": 0.83
  },
  {
   "i": 13,
   "verseId": 2641,
   "text": "ਤੂੰ ਕਰਤਾ ਕਰਣਾ ਮੈ ਨਾਹੀ ਜਾ ਹਉ ਕਰੀ ਨ ਹੋਈ ॥੧॥",
   "start": 28.68,
   "end": 31.96,
   "conf": -0.272,
   "check": 0.93
  },
  {
   "i": 14,
   "verseId": 2642,
   "text": "ਬਲਿਹਾਰੀ ਕੁਦਰਤਿ ਵਸਿਆ ॥",
   "start": 32.8,
   "end": 34.64,
   "conf": -0.029,
   "check": 1
  },
  {
   "i": 15,
   "verseId": 2643,
   "text": "ਤੇਰਾ ਅੰਤੁ ਨ ਜਾਈ ਲਖਿਆ ॥੧॥ ਰਹਾਉ ॥",
   "start": 35.96,
   "end": 38.72,
   "conf": -0.351,
   "check": 0.94
  },
  {
   "i": 16,
   "verseId": 2644,
   "text": "ਜਾਤਿ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਮਹਿ ਜਾਤਾ ਅਕਲ ਕਲਾ ਭਰਪੂਰਿ ਰਹਿਆ ॥",
   "start": 39.44,
   "end": 44.08,
   "conf": -0.283,
   "check": 0.97
  },
  {
   "i": 17,
   "verseId": 2645,
   "text": "ਤੂੰ ਸਚਾ ਸਾਹਿਬੁ ਸਿਫਤਿ ਸੁਆਲਿੑਉ ਜਿਨਿ ਕੀਤੀ ਸੋ ਪਾਰਿ ਪਇਆ ॥",
   "start": 44.56,
   "end": 49.08,
   "conf": -0.709,
   "check": 0.85
  },
  {
   "i": 18,
   "verseId": 2646,
