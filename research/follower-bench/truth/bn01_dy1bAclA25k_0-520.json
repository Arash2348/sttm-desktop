   "end": 58.44,
   "conf": -1.231,
   "check": 0.63
  },
  {
   "i": 21,
   "verseId": 2649,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
