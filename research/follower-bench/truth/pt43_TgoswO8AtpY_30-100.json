 "lines": [
  {
   "i": 53,
   "verseId": 3615,
   "text": "ਗਗਨ ਮੈ ਥਾਲੁ ਰਵਿ ਚੰਦੁ ਦੀਪਕ ਬਨੇ ਤਾਰਿਕਾ ਮੰਡਲ ਜਨਕ ਮੋਤੀ ॥",
   "start": 0.32,
   "end": 2.92,
   "conf": -0.871,
   "check": 0.29
  },
  {
   "i": 54,
   "verseId": 3616,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 4.92,
   "end": 16.36,
   "conf": -0.624,
   "check": 0.92
  },
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 17.44,
   "end": 24.24,
   "conf": -0.631,
   "check": 0.92
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 25.28,
   "end": 31,
   "conf": -0.498,
   "check": 0.89
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 31.88,
   "end": 43.08,
   "conf": -0.916,
   "check": 0.92
  },
  {
   "i": 58,
   "verseId": 3620,
   "text": "ਸਹਸ ਪਦ ਬਿਮਲ ਨਨ ਏਕ ਪਦ ਗੰਧ ਬਿਨੁ ਸਹਸ ਤਵ ਗੰਧ ਇਵ ਚਲਤ ਮੋਹੀ ॥੨॥",
   "start": 45.24,
   "end": 56.44,
   "conf": -0.318,
   "check": 0.92
  },
  {
   "i": 59,
   "verseId": 3621,
   "text": "ਸਭ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਹੈ ਸੋਇ ॥",
   "start": 58.6,
   "end": 63.4,
   "conf": -0.056,
   "check": 1
  },
  {
   "i": 60,
   "verseId": 3622,
   "text": "ਤਿਸ ਦੈ ਚਾਨਣਿ ਸਭ ਮਹਿ ਚਾਨਣੁ ਹੋਇ ॥",
   "start": 63.68,
   "end": 69.92,
