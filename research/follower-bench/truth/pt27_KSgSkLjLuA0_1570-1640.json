 "lines": [
  {
   "i": 501,
   "verseId": 3253,
   "text": "ਤਮ ਸੰਸਾਰੁ ਚਰਨ ਲਗਿ ਤਰੀਐ ਸਭੁ ਨਾਨਕ ਬ੍ਰਹਮ ਪਸਾਰੋ ॥੧॥",
   "start": 1.32,
   "end": 7.08,
   "conf": -0.411,
   "check": 0.89
  },
  {
   "i": 502,
   "verseId": 3254,
   "text": "ਸਲੋਕ ਮਹਲਾ ੫ ॥",
   "start": 8,
   "end": 10.64,
   "conf": -0.235,
   "check": 1
  },
  {
   "i": 503,
   "verseId": 3255,
   "text": "ਤੇਰਾ ਕੀਤਾ ਜਾਤੋ ਨਾਹੀ ਮੈਨੋ ਜੋਗੁ ਕੀਤੋਈ ॥",
   "start": 11.76,
   "end": 17.12,
   "conf": -0.711,
   "check": 0.85
  },
  {
   "i": 504,
   "verseId": 3256,
   "text": "ਮੈ ਨਿਰਗੁਣਿਆਰੇ ਕੋ ਗੁਣੁ ਨਾਹੀ ਆਪੇ ਤਰਸੁ ਪਇਓਈ ॥",
   "start": 18.52,
   "end": 24.28,
   "conf": -0.423,
   "check": 0.87
  },
  {
   "i": 505,
   "verseId": 3257,
   "text": "ਤਰਸੁ ਪਇਆ ਮਿਹਰਾਮਤਿ ਹੋਈ ਸਤਿਗੁਰੁ ਸਜਣੁ ਮਿਲਿਆ ॥",
   "start": 25.28,
   "end": 30.56,
   "conf": -0.63,
   "check": 0.9
  },
  {
   "i": 506,
   "verseId": 3258,
   "text": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਤਾਂ ਜੀਵਾਂ ਤਨੁ ਮਨੁ ਥੀਵੈ ਹਰਿਆ ॥੧॥",
   "start": 31.92,
   "end": 37.28,
   "conf": -0.687,
   "check": 0.84
  },
  {
   "i": 507,
   "verseId": 3259,
   "text": "ਪਉੜੀ ॥",
   "start": 37.96,
   "end": 38.48,
   "conf": -0.045,
   "check": 1
  },
  {
   "i": 508,
   "verseId": 3260,
   "text": "ਤਿਥੈ ਤੂ ਸਮਰਥੁ ਜਿਥੈ ਕੋਇ ਨਾਹਿ ॥",
   "start": 39.32,
   "end": 43.52,
   "conf": -0.448,
   "check": 0.91
  },
  {
   "i": 509,
   "verseId": 3261,
   "text": "ਓਥੈ ਤੇਰੀ ਰਖ ਅਗਨੀ ਉਦਰ ਮਾਹਿ ॥",
   "start": 44.4,
   "end": 48.64,
   "conf": -0.366,
   "check": 0.95
  },
  {
   "i": 510,
   "verseId": 3262,
   "text": "ਸੁਣਿ ਕੈ ਜਮ ਕੇ ਦੂਤ ਨਾਇ ਤੇਰੈ ਛਡਿ ਜਾਹਿ ॥",
   "start": 49.48,
   "end": 54.2,
   "conf": -0.746,
   "check": 0.74
  },
  {
   "i": 511,
   "verseId": 3263,
   "text": "ਭਉਜਲੁ ਬਿਖਮੁ ਅਸਗਾਹੁ ਗੁਰ ਸਬਦੀ ਪਾਰਿ ਪਾਹਿ ॥",
   "start": 55.08,
   "end": 60.04,
   "conf": -0.869,
   "check": 0.84
  },
  {
   "i": 512,
   "verseId": 3264,
   "text": "ਜਿਨ ਕਉ ਲਗੀ ਪਿਆਸ ਅੰਮ੍ਰਿਤੁ ਸੇਇ ਖਾਹਿ ॥",
   "start": 60.8,
   "end": 66.52,
   "conf": -1.027,
   "check": 0.92
  },
  {
   "i": 513,
   "verseId": 3265,
   "text": "ਕਲਿ ਮਹਿ ਏਹੋ ਪੁੰਨੁ ਗੁਣ ਗੋਵਿੰਦ ਗਾਹਿ ॥",
   "start": 66.76,
   "end": 69.72,
   "conf": -0.73,
   "check": 0.68
  }
