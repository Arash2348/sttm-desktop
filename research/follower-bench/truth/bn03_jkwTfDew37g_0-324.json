   "end": 159.56,
   "conf": -0.802,
   "check": 0.85
  },
  {
   "i": 67,
   "verseId": 3629,
   "text": "ਪੂਰਬਿ ਲਿਖਤ ਲਿਖੇ ਗੁਰੁ ਪਾਇਆ ਮਨਿ ਹਰਿ ਲਿਵ ਮੰਡਲ ਮੰਡਾ ਹੇ ॥੧॥",
   "start": 160.4,
   "end": 165.36,
   "conf": -1.079,
   "check": 0.83
  },
  {
   "i": 68,
   "verseId": 3630,
