   "start": 233.92,
   "end": 243.72,
   "conf": -0.343,
   "check": 0.92
  },
  {
   "i": 80,
   "verseId": 3642,
   "text": "ਇਹੁ ਸੰਸਾਰੁ ਬਿਕਾਰੁ ਸੰਸੇ ਮਹਿ ਤਰਿਓ ਬ੍ਰਹਮ ਗਿਆਨੀ ॥",
   "start": 244.28,
   "end": 252,
   "conf": -0.83,
   "check": 0.85
  },
  {
