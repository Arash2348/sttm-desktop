 "lines": [
  {
   "i": 32,
   "verseId": 3594,
   "text": "ਸੋਹਿਲਾ ਰਾਗੁ ਗਉੜੀ ਦੀਪਕੀ ਮਹਲਾ ੧",
   "start": 0.84,
   "end": 4.12,
   "conf": -1.788,
   "check": 0.83
  },
  {
   "i": 33,
   "verseId": 3595,
   "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
   "start": 4.4,
   "end": 7.44,
   "conf": -1.285,
   "check": 0.9
  },
  {
   "i": 34,
   "verseId": 3596,
   "text": "ਜੈ ਘਰਿ ਕੀਰਤਿ ਆਖੀਐ ਕਰਤੇ ਕਾ ਹੋਇ ਬੀਚਾਰੋ ॥",
   "start": 8.76,
   "end": 12.68,
   "conf": -1.354,
   "check": 0.87
  },
  {
   "i": 35,
   "verseId": 3597,
   "text": "ਤਿਤੁ ਘਰਿ ਗਾਵਹੁ ਸੋਹਿਲਾ ਸਿਵਰਿਹੁ ਸਿਰਜਣਹਾਰੋ ॥੧॥",
   "start": 13.44,
   "end": 17.32,
   "conf": -1.075,
   "check": 0.9
  },
  {
   "i": 36,
   "verseId": 3598,
   "text": "ਤੁਮ ਗਾਵਹੁ ਮੇਰੇ ਨਿਰਭਉ ਕਾ ਸੋਹਿਲਾ ॥",
   "start": 18.04,
   "end": 20.68,
   "conf": -0.525,
   "check": 0.82
  },
  {
   "i": 37,
   "verseId": 3599,
   "text": "ਹਉ ਵਾਰੀ ਜਿਤੁ ਸੋਹਿਲੈ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 21.08,
   "end": 25.28,
   "conf": -1.26,
   "check": 0.86
  },
  {
   "i": 38,
   "verseId": 3600,
   "text": "ਨਿਤ ਨਿਤ ਜੀਅੜੇ ਸਮਾਲੀਅਨਿ ਦੇਖੈਗਾ ਦੇਵਣਹਾਰੁ ॥",
   "start": 26.28,
   "end": 31.2,
   "conf": -0.857,
   "check": 0.73
  },
  {
   "i": 39,
   "verseId": 3601,
   "text": "ਤੇਰੇ ਦਾਨੈ ਕੀਮਤਿ ਨਾ ਪਵੈ ਤਿਸੁ ਦਾਤੇ ਕਵਣੁ ਸੁਮਾਰੁ ॥੨॥",
   "start": 32,
   "end": 36.68,
   "conf": -0.913,
   "check": 0.88
  },
  {
   "i": 40,
   "verseId": 3602,
   "text": "ਸੰਬਤਿ ਸਾਹਾ ਲਿਖਿਆ ਮਿਲਿ ਕਰਿ ਪਾਵਹੁ ਤੇਲੁ ॥",
   "start": 37.4,
   "end": 41.24,
   "conf": -1.923,
   "check": 0.9
  },
  {
   "i": 41,
   "verseId": 3603,
   "text": "ਦੇਹੁ ਸਜਣ ਅਸੀਸੜੀਆ ਜਿਉ ਹੋਵੈ ਸਾਹਿਬ ਸਿਉ ਮੇਲੁ ॥੩॥",
   "start": 42.4,
   "end": 47,
   "conf": -0.923,
   "check": 0.89
  },
  {
   "i": 42,
   "verseId": 3604,
   "text": "ਘਰਿ ਘਰਿ ਏਹੋ ਪਾਹੁਚਾ ਸਦੜੇ ਨਿਤ ਪਵੰਨਿ ॥",
   "start": 47.6,
   "end": 51.24,
   "conf": -1.044,
   "check": 0.81
  },
  {
   "i": 43,
   "verseId": 3605,
   "text": "ਸਦਣਹਾਰਾ ਸਿਮਰੀਐ ਨਾਨਕ ਸੇ ਦਿਹ ਆਵੰਨਿ ॥੪॥੧॥",
   "start": 52,
   "end": 56.36,
   "conf": -0.767,
   "check": 0.83
  },
  {
   "i": 44,
   "verseId": 3606,
   "text": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧ ॥",
   "start": 57.36,
   "end": 59.36,
   "conf": -0.823,
   "check": 0.79
  },
  {
   "i": 45,
   "verseId": 3607,
   "text": "ਛਿਅ ਘਰ ਛਿਅ ਗੁਰ ਛਿਅ ਉਪਦੇਸ ॥",
   "start": 59.72,
   "end": 62.28,
   "conf": -2.45,
   "check": 0.71
  },
  {
   "i": 46,
   "verseId": 3608,
   "text": "ਗੁਰੁ ਗੁਰੁ ਏਕੋ ਵੇਸ ਅਨੇਕ ॥੧॥",
   "start": 62.96,
   "end": 64.96,
   "conf": -0.946,
   "check": 0.71
  },
  {
   "i": 47,
   "verseId": 3609,
   "text": "ਬਾਬਾ ਜੈ ਘਰਿ ਕਰਤੇ ਕੀਰਤਿ ਹੋਇ ॥",
   "start": 65.6,
   "end": 68.48,
   "conf": -0.462,
   "check": 0.76
  },
  {
   "i": 48,
   "verseId": 3610,
   "text": "ਸੋ ਘਰੁ ਰਾਖੁ ਵਡਾਈ ਤੋਇ ॥੧॥ ਰਹਾਉ ॥",
   "start": 68.76,
   "end": 71.2,
   "conf": -1.239,
   "check": 0.84
  },
  {
   "i": 49,
   "verseId": 3611,
   "text": "ਵਿਸੁਏ ਚਸਿਆ ਘੜੀਆ ਪਹਰਾ ਥਿਤੀ ਵਾਰੀ ਮਾਹੁ ਹੋਆ ॥",
   "start": 72,
   "end": 75.84,
   "conf": -1.343,
   "check": 0.85
  },
  {
   "i": 50,
   "verseId": 3612,
   "text": "ਸੂਰਜੁ ਏਕੋ ਰੁਤਿ ਅਨੇਕ ॥",
   "start": 76.6,
   "end": 78.28,
   "conf": -2.739,
   "check": 0.54
  },
  {
   "i": 51,
   "verseId": 3613,
   "text": "ਨਾਨਕ ਕਰਤੇ ਕੇ ਕੇਤੇ ਵੇਸ ॥੨॥੨॥",
   "start": 79.32,
   "end": 82.08,
   "conf": -0.198,
   "check": 1
  },
  {
   "i": 52,
   "verseId": 3614,
   "text": "ਰਾਗੁ ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
   "start": 82.4,
   "end": 84.44,
   "conf": -2.74,
   "check": 0.75
  },
  {
   "i": 53,
   "verseId": 3615,
   "text": "ਗਗਨ ਮੈ ਥਾਲੁ ਰਵਿ ਚੰਦੁ ਦੀਪਕ ਬਨੇ ਤਾਰਿਕਾ ਮੰਡਲ ਜਨਕ ਮੋਤੀ ॥",
   "start": 85.56,
   "end": 91,
   "conf": -0.6,
   "check": 0.84
  },
  {
   "i": 54,
   "verseId": 3616,
   "text": "ਧੂਪੁ ਮਲਆਨਲੋ ਪਵਣੁ ਚਵਰੋ ਕਰੇ ਸਗਲ ਬਨਰਾਇ ਫੂਲੰਤ ਜੋਤੀ ॥੧॥",
   "start": 91.88,
   "end": 96.76,
   "conf": -0.654,
   "check": 0.86
  },
  {
   "i": 55,
   "verseId": 3617,
   "text": "ਕੈਸੀ ਆਰਤੀ ਹੋਇ ॥ ਭਵ ਖੰਡਨਾ ਤੇਰੀ ਆਰਤੀ ॥",
   "start": 97.88,
   "end": 103.64,
   "conf": -0.125,
   "check": 0.96
  },
  {
   "i": 56,
   "verseId": 3618,
   "text": "ਅਨਹਤਾ ਸਬਦ ਵਾਜੰਤ ਭੇਰੀ ॥੧॥ ਰਹਾਉ ॥",
   "start": 104.88,
   "end": 109.36,
   "conf": -0.373,
   "check": 1
  },
  {
   "i": 57,
   "verseId": 3619,
   "text": "ਸਹਸ ਤਵ ਨੈਨ ਨਨ ਨੈਨ ਹਹਿ ਤੋਹਿ ਕਉ ਸਹਸ ਮੂਰਤਿ ਨਨਾ ਏਕ ਤੋੁਹੀ ॥",
   "start": 110.12,
   "end": 116.16,
   "conf": -1.306,
   "check": 0.78
  },
  {
   "i": 58,
   "verseId": 3620,
