   "conf": -0.697,
   "check": 0.85
  },
  {
   "i": 78,
   "verseId": 3640,
   "text": "ਈਹਾ ਖਾਟਿ ਚਲਹੁ ਹਰਿ ਲਾਹਾ ਆਗੈ ਬਸਨੁ ਸੁਹੇਲਾ ॥੧॥",
   "start": 225.12,
   "end": 232.8,
   "conf": -1.395,
   "check": 0.81
  },
  {
   "i": 79,
   "verseId": 3641,
