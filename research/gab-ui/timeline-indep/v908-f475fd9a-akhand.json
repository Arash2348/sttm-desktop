{"gab": "GAB v1.5", "label": "Gurbani Autopilot 9.0.8", "commit": "f475fd9adb73", "set": "akhand", "split": "practice recordings (held-out test set not included)", "scoring": "pangti", "texts": ["\u0a0f\u0a15\u0a41 \u0a28\u0a3e\u0a2e\u0a41 \u0a26\u0a40\u0a13 \u0a2e\u0a28 \u0a2e\u0a70\u0a24\u0a3e \u0a2c\u0a3f\u0a28\u0a38\u0a3f \u0a28 \u0a15\u0a24\u0a39\u0a42 \u0a1c\u0a3e\u0a24\u0a3f \u0965\u0a67\u0965", "\u0a1b\u0a21\u0a3e\u0a07 \u0a32\u0a40\u0a13 \u0a2e\u0a39\u0a3e \u0a2c\u0a32\u0a40 \u0a24\u0a47 \u0a05\u0a2a\u0a28\u0a47 \u0a1a\u0a30\u0a28 \u0a2a\u0a30\u0a3e\u0a24\u0a3f \u0965", "\u0a39\u0a30\u0a3f \u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a26\u0a40\u0a13 \u0a15\u0a40\u0a30\u0a24\u0a28 \u0a15\u0a09 \u0a2d\u0a08 \u0a39\u0a2e\u0a3e\u0a30\u0a40 \u0a17\u0a3e\u0a24\u0a3f \u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965", "\u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30\u0a3f \u0a2a\u0a42\u0a30\u0a48 \u0a15\u0a40\u0a28\u0a40 \u0a26\u0a3e\u0a24\u0a3f \u0965", "\u0a35\u0a3e\u0a39\u0a3f\u0a17\u0a41\u0a30\u0a42 slide", "\u0a2a\u0a42\u0a30\u0a47 \u0a17\u0a41\u0a30 \u0a15\u0a40 \u0a2a\u0a42\u0a30\u0a40 \u0a26\u0a40\u0a16\u0a3f\u0a06 \u0965", "\u0a05\u0a70\u0a17\u0a40\u0a15\u0a3e\u0a30\u0a41 \u0a15\u0a40\u0a13 \u0a2a\u0a4d\u0a30\u0a2d\u0a3f \u0a05\u0a2a\u0a41\u0a28\u0a48 \u0a2d\u0a17\u0a24\u0a28 \u0a15\u0a40 \u0a30\u0a3e\u0a16\u0a40 \u0a2a\u0a3e\u0a24\u0a3f \u0965", "\u0a28\u0a3e\u0a28\u0a15 \u0a1a\u0a30\u0a28 \u0a17\u0a39\u0a47 \u0a2a\u0a4d\u0a30\u0a2d \u0a05\u0a2a\u0a28\u0a47 \u0a38\u0a41\u0a16\u0a41 \u0a2a\u0a3e\u0a07\u0a13 \u0a26\u0a3f\u0a28 \u0a30\u0a3e\u0a24\u0a3f \u0965\u0a68\u0965\u0a67\u0a66\u0965\u0a6a\u0a67\u0965", "\u0a39\u0a09 \u0a05\u0a28\u0a26\u0a3f\u0a28\u0a41 \u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a15\u0a40\u0a30\u0a24\u0a28\u0a41 \u0a15\u0a30\u0a09 \u0965", "\u0a2b\u0a30\u0a40\u0a26\u0a3e \u0a30\u0a3e\u0a24\u0a3f \u0a15\u0a25\u0a42\u0a30\u0a40 \u0a35\u0a70\u0a21\u0a40\u0a10 \u0a38\u0a41\u0a24\u0a3f\u0a06 \u0a2e\u0a3f\u0a32\u0a48 \u0a28 \u0a2d\u0a3e\u0a09 \u0965", "\u0a1c\u0a3f\u0a70\u0a28\u0a51\u0a3e \u0a28\u0a48\u0a23 \u0a28\u0a40\u0a02\u0a26\u0a4d\u0a30\u0a3e\u0a35\u0a32\u0a47 \u0a24\u0a3f\u0a70\u0a28\u0a51\u0a3e \u0a2e\u0a3f\u0a32\u0a23\u0a41 \u0a15\u0a41\u0a06\u0a09 \u0965\u0a6e\u0a66\u0965", "\u0a09\u0a20\u0a41 \u0a2b\u0a30\u0a40\u0a26\u0a3e \u0a09\u0a1c\u0a42 \u0a38\u0a3e\u0a1c\u0a3f \u0a38\u0a41\u0a2c\u0a39 \u0a28\u0a3f\u0a35\u0a3e\u0a1c \u0a17\u0a41\u0a1c\u0a3e\u0a30\u0a3f \u0965", "\u0a1c\u0a4b \u0a38\u0a3f\u0a30\u0a41 \u0a38\u0a3e\u0a02\u0a08 \u0a28\u0a3e \u0a28\u0a3f\u0a35\u0a48 \u0a38\u0a4b \u0a38\u0a3f\u0a30\u0a41 \u0a15\u0a2a\u0a3f \u0a09\u0a24\u0a3e\u0a30\u0a3f \u0965\u0a6d\u0a67\u0965", "\u0a1c\u0a4b \u0a38\u0a3f\u0a30\u0a41 \u0a38\u0a3e\u0a08 \u0a28\u0a3e \u0a28\u0a3f\u0a35\u0a48 \u0a38\u0a4b \u0a38\u0a3f\u0a30\u0a41 \u0a15\u0a40\u0a1c\u0a48 \u0a15\u0a3e\u0a02\u0a07 \u0965", "\u0a15\u0a41\u0a70\u0a28\u0a47 \u0a39\u0a47\u0a20\u0a3f \u0a1c\u0a32\u0a3e\u0a08\u0a10 \u0a2c\u0a3e\u0a32\u0a23 \u0a38\u0a70\u0a26\u0a48 \u0a25\u0a3e\u0a07 \u0965\u0a6d\u0a68\u0965", "\u0a15\u0a3f\u0a06 \u0a24\u0a42\u0a70 \u0a30\u0a24\u0a3e \u0a17\u0a3f\u0a30\u0a38\u0a24 \u0a38\u0a3f\u0a09 \u0a38\u0a2d \u0a2b\u0a41\u0a32\u0a3e \u0a15\u0a40 \u0a2c\u0a3e\u0a17\u0a3e\u0a24\u0a3f \u0965\u0a68\u0965", "\u0a17\u0a4b\u0a07\u0a32\u0a3f \u0a06\u0a07\u0a06 \u0a17\u0a4b\u0a07\u0a32\u0a40 \u0a15\u0a3f\u0a06 \u0a24\u0a3f\u0a38\u0a41 \u0a21\u0a70\u0a2b\u0a41 \u0a2a\u0a38\u0a3e\u0a30\u0a41 \u0965", "\u0a2e\u0a41\u0a39\u0a32\u0a24\u0a3f \u0a2a\u0a41\u0a70\u0a28\u0a40 \u0a1a\u0a32\u0a23\u0a3e \u0a24\u0a42\u0a70 \u0a38\u0a70\u0a2e\u0a32\u0a41 \u0a18\u0a30 \u0a2c\u0a3e\u0a30\u0a41 \u0965\u0a67\u0965", "\u0a39\u0a30\u0a3f \u0a17\u0a41\u0a23 \u0a17\u0a3e\u0a09 \u0a2e\u0a28\u0a3e \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30\u0a41 \u0a38\u0a47\u0a35\u0a3f \u0a2a\u0a3f\u0a06\u0a30\u0a3f \u0965", "\u0a15\u0a3f\u0a06 \u0a25\u0a4b\u0a5c\u0a5c\u0a40 \u0a2c\u0a3e\u0a24 \u0a17\u0a41\u0a2e\u0a3e\u0a28\u0a41 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965", "\u0a1c\u0a48\u0a38\u0a47 \u0a30\u0a48\u0a23\u0a3f \u0a2a\u0a30\u0a3e\u0a39\u0a41\u0a23\u0a47 \u0a09\u0a20\u0a3f \u0a1a\u0a32\u0a38\u0a39\u0a3f \u0a2a\u0a30\u0a2d\u0a3e\u0a24\u0a3f \u0965", "\u0a2e\u0a47\u0a30\u0a40 \u0a2e\u0a47\u0a30\u0a40 \u0a15\u0a3f\u0a06 \u0a15\u0a30\u0a39\u0a3f \u0a1c\u0a3f\u0a28\u0a3f \u0a26\u0a40\u0a06 \u0a38\u0a4b \u0a2a\u0a4d\u0a30\u0a2d\u0a41 \u0a32\u0a4b\u0a5c\u0a3f \u0965", "\u0a38\u0a30\u0a2a\u0a30 \u0a09\u0a20\u0a40 \u0a1a\u0a32\u0a23\u0a3e \u0a1b\u0a21\u0a3f \u0a1c\u0a3e\u0a38\u0a40 \u0a32\u0a16 \u0a15\u0a30\u0a4b\u0a5c\u0a3f \u0965\u0a69\u0965", "\u0a32\u0a16 \u0a1a\u0a09\u0a30\u0a3e\u0a38\u0a40\u0a39 \u0a2d\u0a4d\u0a30\u0a2e\u0a24\u0a3f\u0a06 \u0a26\u0a41\u0a32\u0a2d \u0a1c\u0a28\u0a2e\u0a41 \u0a2a\u0a3e\u0a07\u0a13\u0a07 \u0965", "\u0a28\u0a3e\u0a28\u0a15 \u0a28\u0a3e\u0a2e\u0a41 \u0a38\u0a2e\u0a3e\u0a32\u0a3f \u0a24\u0a42\u0a70 \u0a38\u0a4b \u0a26\u0a3f\u0a28\u0a41 \u0a28\u0a47\u0a5c\u0a3e \u0a06\u0a07\u0a13\u0a07 \u0965\u0a6a\u0965\u0a68\u0a68\u0965\u0a6f\u0a68\u0965", "\u0a30\u0a3e\u0a2e \u0a30\u0a3e\u0a2e \u0a2c\u0a4b\u0a32\u0a3f \u0a2c\u0a4b\u0a32\u0a3f \u0a16\u0a4b\u0a1c\u0a24\u0a47 \u0a2c\u0a21\u0a2d\u0a3e\u0a17\u0a40 \u0965", "\u0a39\u0a30\u0a3f \u0a15\u0a3e \u0a2a\u0a70\u0a25\u0a41 \u0a15\u0a4b\u0a0a \u0a2c\u0a24\u0a3e\u0a35\u0a48 \u0a39\u0a09 \u0a24\u0a3e \u0a15\u0a48 \u0a2a\u0a3e\u0a07 \u0a32\u0a3e\u0a17\u0a40 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965", "\u0a39\u0a30\u0a3f \u0a39\u0a2e\u0a3e\u0a30\u0a4b \u0a2e\u0a40\u0a24\u0a41 \u0a38\u0a16\u0a3e\u0a08 \u0a39\u0a2e \u0a39\u0a30\u0a3f \u0a38\u0a3f\u0a09 \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a3f \u0a32\u0a3e\u0a17\u0a40 \u0965", "\u0a2e\u0a28\u0a2e\u0a4b\u0a39\u0a28 \u0a2e\u0a4b\u0a30\u0a4b \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a2e \u0a30\u0a3e\u0a2e\u0a41 \u0a39\u0a30\u0a3f \u0a2a\u0a30\u0a2e\u0a3e\u0a28\u0a70\u0a26\u0a41 \u0a2c\u0a48\u0a30\u0a3e\u0a17\u0a40 \u0965", "\u0a39\u0a30\u0a3f \u0a39\u0a2e \u0a17\u0a3e\u0a35\u0a39\u0a3f \u0a39\u0a30\u0a3f \u0a39\u0a2e \u0a2c\u0a4b\u0a32\u0a39\u0a3f